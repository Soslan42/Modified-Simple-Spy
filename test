        local scroll = Scroller(page)

        local card, body = Section(scroll, "Palette Exporter")
        Label(body, "Export the current Solanix theme as a Lua table.", { size = 11 })

        Button(body, "Export Theme as Lua", function()
            local out = {"local THEME = {"}
            for k, v in pairs(THEME) do
                if typeof(v) == "Color3" then
                    table_insert(out, string_format("    %s = Color3.fromRGB(%d, %d, %d),",
                        k, math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255)))
                elseif typeof(v) == "EnumItem" then
                    table_insert(out, string_format("    %s = %s,", k, tostring(v)))
                elseif typeof(v) == "UDim" then
                    table_insert(out, string_format("    %s = UDim.new(%g, %d),", k, v.Scale, v.Offset))
                elseif type(v) == "number" then
                    table_insert(out, string_format("    %s = %d,", k, v))
                end
            end
            table_insert(out, "}")
            table_insert(out, "return THEME")
            safeClipboard(table.concat(out, "\n"))
            Notify("Solanix", "Theme exported as Lua (clipboard).", 3)
        end)

        Button(body, "Export Theme as JSON", function()
            local out = {}
            for k, v in pairs(THEME) do
                if typeof(v) == "Color3" then
                    out[k] = string_format("#%02X%02X%02X",
                        math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255))
                elseif typeof(v) == "EnumItem" then
                    out[k] = tostring(v)
                elseif typeof(v) == "UDim" then
                    out[k] = string.format("{scale=%g, offset=%d}", v.Scale, v.Offset)
                elseif type(v) == "number" then
                    out[k] = v
                end
            end
            safeClipboard(HttpService:JSONEncode(out))
            Notify("Solanix", "Theme exported as JSON (clipboard).", 3)
        end)

        Button(body, "Export Theme as CSS", function()
            local out = {":root {"}
            for k, v in pairs(THEME) do
                if typeof(v) == "Color3" then
                    local cssName = "--" .. k:gsub("([A-Z])", "-%1"):lower()
                    table_insert(out, string.format("    %s: #%02X%02X%02X;",
                        cssName, math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255)))
                end
            end
            table_insert(out, "}")
            safeClipboard(table.concat(out, "\n"))
            Notify("Solanix", "Theme exported as CSS (clipboard).", 3)
        end)

        Button(body, "Print Theme to Console", function()
            print("=== Solanix Hub Theme ===")
            for k, v in pairs(THEME) do
                if typeof(v) == "Color3" then
                    print(string_format("%s = Color3.fromRGB(%d, %d, %d)",
                        k, math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255)))
                end
            end
            Notify("Solanix", "Theme printed to console.", 3)
        end)
    end
end

