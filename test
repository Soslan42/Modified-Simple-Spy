--=====================================================================
-- EXTENDED: FILE SYSTEM HELPERS
--=====================================================================

SolanixHub._fs = {}

function SolanixHub._fs.ensureFolder(path)
    if not isfolder or isfolder(path) then return true end
    if not makefolder then return false end
    return pcall(makefolder, path)
end

function SolanixHub._fs.readFile(path)
    if not isfile or not isfile(path) then return nil end
    return readfile(path)
end

function SolanixHub._fs.writeFile(path, content)
    if not writefile then return false end
    local parts = path:split("/")
    if #parts > 1 then
        local folderPath = table.concat(parts, "/", 1, #parts - 1)
        SolanixHub._fs.ensureFolder(folderPath)
    end
    return pcall(writefile, path, content)
end

function SolanixHub._fs.appendFile(path, content)
    if not appendfile then
        local existing = SolanixHub._fs.readFile(path) or ""
        return SolanixHub._fs.writeFile(path, existing .. content)
    end
    return pcall(appendfile, path, content)
end

function SolanixHub._fs.deleteFile(path)
    if not isfile or not isfile(path) then return false end
    if not delfile then return false end
    return pcall(delfile, path)
end

function SolanixHub._fs.deleteFolder(path)
    if not isfolder or not isfolder(path) then return false end
    if not delfolder then return false end
    return pcall(delfolder, path)
end

function SolanixHub._fs.listFiles(path)
    if not isfolder or not isfolder(path) then return {} end
    if not listfiles then return {} end
    local ok, result = pcall(listfiles, path)
    return ok and result or {}
end

function SolanixHub._fs.exists(path)
    if not isfile or not isfolder then return false end
    return isfile(path) or isfolder(path)
end

function SolanixHub._fs.readJson(path)
    local raw = SolanixHub._fs.readFile(path)
    if not raw then return nil end
    local ok, data = pcall(jsonDecode, raw)
    return ok and data or nil
end

function SolanixHub._fs.writeJson(path, data)
    local json = jsonEncode(data)
    return SolanixHub._fs.writeFile(path, json)
end

