            M.Stop()
        end)

        local ctrlCard, ctrlBody = Section(scroll, "Playback Controls")
        Slider(ctrlBody, "Speed", 0.1, 5, 1, 2, function(v)
            if currentTrack then pcall(function() currentTrack:AdjustSpeed(v) end) end
        end)
        Slider(ctrlBody, "Time Position", 0, 30, 0, 2, function(v)
            if currentTrack then pcall(function() currentTrack.TimePosition = v end) end
        end)
        Toggle(ctrlBody, "Loop", false, function(v)
            if currentTrack then pcall(function() currentTrack.Looped = v end) end
        end)

        local presetCard, presetBody = Section(scroll, "Animation Presets")
        local presets = {
            { name = "Wave",      id = "rbxassetid://128777974" },
            { name = "Dance",     id = "rbxassetid://507771019" },
            { name = "Cheer",     id = "rbxassetid://507770677" },
            { name = "Laugh",     id = "rbxassetid://507770818" },
            { name = "Point",     id = "rbxassetid://507768375" },
            { name = "Sit",       id = "rbxassetid://507768133" },
            { name = "Climb",     id = "rbxassetid://507765658" },
            { name = "Fall",      id = "rbxassetid://507767968" },
            { name = "Jump",      id = "rbxassetid://507765000" },
            { name = "Run",       id = "rbxassetid://913376220" },
            { name = "Walk",      id = "rbxassetid://913402848" },
            { name = "Idle",      id = "rbxassetid://913386225" },
        }
        for _, p in ipairs(presets) do
            Button(presetBody, "Play: " .. p.name, function()
                M.Play(p.id)
            end)
        end
    end

    function M.Play(animId)
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Create("Animator", { Parent = hum })
        end
        local anim = Create("Animation", { AnimationId = animId })
        local ok, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if not ok or not track then
            Notify("Solanix", "Failed to load animation.", 3)
            return
        end
        if currentTrack then pcall(function() currentTrack:Stop() end) end
        currentTrack = track
        track.Looped = false
        track:Play()
        Notify("Solanix", "Playing animation.", 3)
    end

    function M.Stop()
        if currentTrack then
            pcall(function() currentTrack:Stop() end)
            currentTrack = nil
            Notify("Solanix", "Animation stopped.", 3)
        end
    end
end

