-- SERVER MODULE — Rejoin, ServerHop, CopyJobID, Server stats
--=====================================================================

SolanixHub.modules.Server = {}
do
    local M = SolanixHub.modules.Server
    local function getPlaceId() return game.PlaceId end
    local function getJobId() return game.JobId end

    function M.Rejoin()
        Notify("Solanix", "Rejoining server...", 3)
        if #Players:GetPlayers() <= 1 then
            task_wait(0.5)
            pcall(function() TeleportService:Teleport(getPlaceId(), LocalPlayer) end)
        else
            pcall(function() TeleportService:TeleportToPlaceInstance(getPlaceId(), getJobId(), LocalPlayer) end)
        end
    end

    function M.ServerHop()
        Notify("Solanix", "Searching for another server...", 3)
        Spawn(function()
            local ok, response = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(
                    "https://games.roblox.com/v1/games/" .. getPlaceId() .. "/servers/Public?sortOrder=Asc&limit=100"))
            end)
            if not ok or not response or not response.data then
                Notify("Solanix", "Failed to fetch servers.", 3)
                return
            end
            local best = nil
            local bestScore = -1
            for _, s in ipairs(response.data) do
                if type(s) == "table" and s.maxPlayers and s.playing and s.id ~= getJobId() then
                    if s.playing < s.maxPlayers then
                        -- Prefer fuller servers
                        if s.playing > bestScore then
                            bestScore = s.playing
                            best = s.id
                        end
                    end
                end
            end
            if best then
                Notify("Solanix", "Teleporting to a new server...", 3)
                task_wait(0.3)
                pcall(function() TeleportService:TeleportToPlaceInstance(getPlaceId(), best, LocalPlayer) end)
            else
                Notify("Solanix", "No other servers found.", 3)
            end
        end)
    end

    function M.Build()
        local page = SolanixHub.NewPage("Server")
        local scroll = Scroller(page)

        local srvCard, srvBody = Section(scroll, "Server Actions")
        Button(srvBody, "Rejoin Current Server", function() M.Rejoin() end)
        Button(srvBody, "Server Hop (find fuller server)", function() M.ServerHop() end)
        Button(srvBody, "Copy Job ID", function()
            safeClipboard(getJobId())
            Notify("Solanix", "Job ID copied: " .. getJobId(), 3)
        end)
        Button(srvBody, "Copy Place ID", function()
            safeClipboard(tostring(getPlaceId()))
            Notify("Solanix", "Place ID copied: " .. tostring(getPlaceId()), 3)
        end)
        Button(srvBody, "Copy Job ID URL", function()
            local url = "roblox.com/start?placeId=" .. getPlaceId() .. "&gameInstanceId=" .. getJobId()
            safeClipboard(url)
            Notify("Solanix", "URL copied.", 3)
        end)

        -- Server stats
        local statCard, statBody = Section(scroll, "Server Stats")
        local function statLabel(k, v)
            Label(statBody, k .. ": " .. tostring(v), { size = 12 })
        end
        statLabel("Place ID", getPlaceId())
        statLabel("Job ID", getJobId())
        statLabel("Players", #Players:GetPlayers())
        statLabel("Max Players", Players.MaxPlayers)
        pcall(function()
            local creator = "Unknown"
            if game.CreatorType == Enum.CreatorType.User then
                creator = "User #" .. tostring(game.CreatorId)
            elseif game.CreatorType == Enum.CreatorType.Group then
                creator = "Group #" .. tostring(game.CreatorId)
            end
            statLabel("Creator", creator)
        end)

        -- Players live update
        local plrStat = Label(statBody, "", { size = 12 })
        Spawn(function()
            while SolanixGui.Parent do
                if plrStat and plrStat.Parent then
                    plrStat.Text = "Live player count: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers
                end
                task_wait(2)
            end
        end)
    end
end

