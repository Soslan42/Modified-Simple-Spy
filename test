    local mt = getrawmetatable(obj)
    if not mt then return nil end
    local old = mt[mm]
    if hookfunction then
        return hookfunction(old, fn)
    end
    if setreadonly then setreadonly(mt, false) end
    mt[mm] = fn
    if setreadonly then setreadonly(mt, true) end
    return old
end
