        -- Toggle spy button
        local spyToggle = Create("TextButton", {
            Parent = filterBar,
            BackgroundColor3 = THEME.bgActive,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -90, 0.5, -10),
            Size = UDim2.new(0, 80, 0, 20),
            Font = THEME.fontBold,
            Text = "Spy: OFF",
            TextColor3 = THEME.red,
            TextSize = 11,
            AutoButtonColor = false,
        })
        Create("UICorner", { Parent = spyToggle, CornerRadius = THEME.radiusSm })
        ApplyHover(spyToggle, THEME.bgHover, THEME.bgActive)
        Track(spyToggle.MouseButton1Click:Connect(function()
            M.ToggleSpy()
            if spyActive then
                spyToggle.Text = "Spy: ON"
                spyToggle.TextColor3 = THEME.green
            else
                spyToggle.Text = "Spy: OFF"
                spyToggle.TextColor3 = THEME.red
            end
        end))

        -- Search filter
        local _, searchInput = TextBox(leftPane, "Search by name", "filter...", "", function() end)
        searchInput.Parent.Position = UDim2.new(0, 0, 0, 32)
        searchInput.Parent.Size = UDim2.new(1, 0, 0, 28)
        -- Re-position the inner textbox if needed
        Track(searchInput.FocusLost:Connect(function()
            local q = string_lower(searchInput.Text)
            for fullName, g in next, groups do
                if q == "" then
                    g.frame.Visible = (currentFilter == "ALL")
                        or (currentFilter == "RE" and (g.remote:IsA("RemoteEvent") or g.remote:IsA("UnreliableRemoteEvent")))
                        or (currentFilter == "RF" and g.remote:IsA("RemoteFunction"))
                else
                    g.frame.Visible = string_lower(fullName):find(q, 1, true) ~= nil
                end
            end
        end))

        -- Log list (scrolling)
        logList = Create("ScrollingFrame", {
            Parent = leftPane,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 92),
            Size = UDim2.new(1, 0, 1, -92),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = THEME.scrollBarSize,
            ScrollBarImageColor3 = THEME.border,
        })
        Create("UIListLayout", {
            Parent = logList,
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })
        Create("UIPadding", {
            Parent = logList,
            PaddingLeft = UDim.new(0, 6),
            PaddingRight = UDim.new(0, 6),
            PaddingTop = UDim.new(0, 6),
