SolanixHub.modules.NotificationHistory = {}
do
    local M = SolanixHub.modules.NotificationHistory
    local history = {}
    local MAX = 100

    -- Wrap Notify to also store history
    local originalNotify = SolanixHub.Notify
    SolanixHub.Notify = function(title, msg, duration)
        table_insert(history, {
            title = title or "",
            message = msg or "",
            time = os.date("%H:%M:%S"),
        })
        if #history > MAX then table_remove(history, 1) end
        return originalNotify(title, msg, duration)
    end

    function M.Build()
        local page = SolanixHub.NewPage("NotificationHistory")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Notification History")
        Label(body, "Last " .. MAX .. " notifications shown.", { size = 11 })
        Button(body, "Clear History", function()
            history = {}
            M.Refresh()
        end)

        local listCard, listBody = Section(scroll, "Past Notifications")
        M._listBody = listBody
        Button(listBody, "Refresh", function() M.Refresh() end)
        M.Refresh()
    end

    function M.Refresh()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "NotifRow" then
                pcall(function() c:Destroy() end)
