SolanixHub.modules.Scripts = {}
do
    local M = SolanixHub.modules.Scripts
    local savedScripts = {}    -- [{name=, code=}]
    local SCRIPTS_FILE = "SolanixHub/scripts.json"

    local function ensureFolder()
        if not isfolder("SolanixHub") then makefolder("SolanixHub") end
    end

    local function loadSaved()
        ensureFolder()
        if isfile(SCRIPTS_FILE) then
            local ok, data = pcall(function()
                return HttpService:JSONDecode(readfile(SCRIPTS_FILE))
            end)
            if ok and type(data) == "table" then
                savedScripts = data
            end
        end
    end

    local function persist()
        ensureFolder()
        pcall(function()
            writefile(SCRIPTS_FILE, HttpService:JSONEncode(savedScripts))
        end)
    end

    function M.Execute(code)
        if not code or code == "" then return end
        local fn, err = loadstring(code)
        if not fn then
            Notify("Solanix", "Compile error: " .. tostring(err), 5)
            return
        end
        setfenv(fn, getfenv())
        local ok, runErr = pcall(fn)
        if not ok then
            Notify("Solanix", "Runtime error: " .. tostring(runErr), 5)
        else
            Notify("Solanix", "Script executed.", 3)
        end
    end

    function M.Build()
        loadSaved()
        local page = SolanixHub.NewPage("Scripts")
        local scroll = Scroller(page)

