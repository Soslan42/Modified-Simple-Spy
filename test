            output.Text = string_lower(input.Text)
        end)
        Button(body, "Reverse", function()
            output.Text = input.Text:reverse()
        end)
        Button(body, "Length", function()
            output.Text = tostring(#input.Text)
        end)
        Button(body, "Word count", function()
            local count = 0
            for _ in input.Text:gmatch("%S+") do count = count + 1 end
            output.Text = tostring(count)
        end)
        Button(body, "Trim", function()
            output.Text = input.Text:match("^%s*(.-)%s*$")
        end)
        Button(body, "URL encode", function()
            local s = input.Text
            s = s:gsub("[^%w]", function(c)
                return string_format("%%%02X", string.byte(c))
            end)
            output.Text = s
        end)
        Button(body, "Base64 encode (if available)", function()
            output.Text = crypt_base64(input.Text)
        end)
    end
end

-- Example 10: Number base converter
SolanixHub.modules.BaseConverter = {}
do
    local M = SolanixHub.modules.BaseConverter
    function M.Build()
        local page = SolanixHub.NewPage("BaseConverter")
        local scroll = Scroller(page)
        local card, body = Section(scroll, "Number Base Converter")
        local _, input = TextBox(body, "Decimal", "0", "42", function() end)
        local dec, bin, oct, hex
        local function update(s)
            local n = tonumber(s)
            if not n then return end
            if dec and dec.Parent then dec.Text = tostring(n) end
            if bin and bin.Parent then bin.Text = string.format("%b", n) end
            if oct and oct.Parent then oct.Text = string.format("%o", n) end
            if hex and hex.Parent then hex.Text = string.format("%x", n) end
        end
        local _, binRow = TextBox(body, "Binary", "0", "", function() end)
        bin = binRow
        local _, octRow = TextBox(body, "Octal", "0", "", function() end)
        oct = octRow
        local _, hexRow = TextBox(body, "Hex", "0", "", function() end)
        hex = hexRow
        Button(body, "Convert", function()
            update(input.Text)
        end)
    end
end


