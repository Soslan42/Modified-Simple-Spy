--=====================================================================

SolanixHub.modules.SnippetBrowser = {}
do
    local M = SolanixHub.modules.SnippetBrowser
    function M.Build()
        local page = SolanixHub.NewPage("SnippetBrowser")
        local scroll = Scroller(page)

        -- Group by category
        local categories = {}
        for _, s in ipairs(SolanixHub._comprehensiveSnippets) do
            if not categories[s.category] then
                categories[s.category] = {}
            end
            table_insert(categories[s.category], s)
        end

        -- Render each category as a collapsible section
        local catNames = {}
        for name, _ in pairs(categories) do
            table_insert(catNames, name)
        end
        table.sort(catNames)

        for _, catName in ipairs(catNames) do
            local snippets = categories[catName]
            local card, body = Section(scroll, catName .. " (" .. #snippets .. ")")
            for _, s in ipairs(snippets) do
                Button(body, "Insert: " .. s.name, function()
                    if SolanixHub._state.activeCodeInput then
                        SolanixHub._state.activeCodeInput.Text = s.code
                        Notify("Solanix", "Inserted: " .. s.name, 3)
                    else
                        safeClipboard(s.code)
                        Notify("Solanix", "Copied to clipboard (no active code box): " .. s.name, 4)
                    end
                end)
            end
        end
    end
end

