-- MUSIC MODULE — audio player, queue, volume
--=====================================================================

SolanixHub.modules.Music = {}
do
    local M = SolanixHub.modules.Music
    local sound
    local queue = {}
    local currentIdx = 0
    local playing = false
    local volume = 0.5

    local function ensureSound()
        if not sound then
            sound = Create("Sound", {
                Parent = Workspace,
                Volume = volume,
            })
            TrackInstance(sound)
            Track(sound.Ended:Connect(function()
                M.Next()
            end))
        end
        return sound
    end

    function M.Play(assetId)
        if not assetId or assetId == "" then return end
        local s = ensureSound()
        s:Stop()
        s.SoundId = "rbxassetid://" .. tostring(assetId)
        s.Volume = volume
        s:Play()
        playing = true
        Notify("Solanix", "Playing: " .. tostring(assetId), 3)
    end

    function M.Stop()
        local s = ensureSound()
        s:Stop()
        playing = false
        Notify("Solanix", "Stopped.", 3)
    end

    function M.Next()
        if #queue == 0 then return end
        currentIdx = currentIdx + 1
        if currentIdx > #queue then currentIdx = 1 end
        M.Play(queue[currentIdx])
    end

    function M.Prev()
        if #queue == 0 then return end
        currentIdx = currentIdx - 1
        if currentIdx < 1 then currentIdx = #queue end
        M.Play(queue[currentIdx])
    end

    function M.SetVolume(v)
        volume = v
        if sound then sound.Volume = v end
    end

    function M.Build()
        local page = SolanixHub.NewPage("Music")
        local scroll = Scroller(page)

        local playCard, playBody = Section(scroll, "Now Playing")
        local _, idInput = TextBox(playBody, "Sound ID", "123456789", "", function() end)
        Button(playBody, "Play", function()
            local id = idInput.Text:gsub("^rbxassetid://", "")
            id = id:gsub("%D", "")
            M.Play(id)
        end)
        Button(playBody, "Stop", function() M.Stop() end)
        Slider(playBody, "Volume", 0, 1, 0.5, 2, function(v) M.SetVolume(v) end)

        local qCard, qBody = Section(scroll, "Queue")
        local _, qInput = TextBox(qBody, "Add to queue (asset ID)", "", "", function() end)
        Button(qBody, "Add", function()
            local id = qInput.Text:gsub("%D", "")
            if id ~= "" then
                table_insert(queue, id)
                Notify("Solanix", "Added to queue: " .. id, 3)
            end
        end)
        Button(qBody, "Play Next", function() M.Next() end)
        Button(qBody, "Play Previous", function() M.Prev() end)
        Button(qBody, "Clear Queue", function()
            queue = {}
            currentIdx = 0
            Notify("Solanix", "Queue cleared.", 3)
        end)
        local queueLbl = Label(qBody, "Queue: 0 tracks", { size = 11 })
        Spawn(function()
            while SolanixGui.Parent do
                if queueLbl and queueLbl.Parent then
                    queueLbl.Text = "Queue: " .. #queue .. " tracks (now at #" .. currentIdx .. ")"
                end
                task_wait(1)
            end
        end)

        local presetCard, presetBody = Section(scroll, "Presets")
        local presets = {
            { name = "Lo-Fi Beat",     id = "1837879082" },
            { name = "Ambient Pad",    id = "1836039403" },
            { name = "Rain Loop",      id = "155 abbreviate" },
            { name = "Synthwave",      id = "1845078093" },
        }
        for _, p in ipairs(presets) do
            Button(presetBody, "Play: " .. p.name, function()
                if p.id and tonumber(p.id) then M.Play(p.id) end
            end)
