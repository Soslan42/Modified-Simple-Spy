local function saveSettings()
    if isfile and writefile then
        local settingsStr = jsone(realconfigs)
        if not isfolder("SimpleSpy") then
            makefolder("SimpleSpy")
        end
        writefile("SimpleSpy/settings.json", settingsStr)
        TextLabel.Text = t("settings_saved")
    else
        TextLabel.Text = "Cannot save settings (filesystem not available)"
    end
end

local function loadSettings()
    if isfile and readfile then
        if isfile("SimpleSpy/settings.json") then
            local settingsStr = readfile("SimpleSpy/settings.json")
            local loaded = jsond(settingsStr)
            if loaded then
                for k, v in pairs(loaded) do
                    if realconfigs[k] ~= nil then
                        realconfigs[k] = v
                        tempSettings[k] = v
                    end
                end
                populateSettings()
                updateInterfaceTexts()
                applyVisualSettings()
                TextLabel.Text = t("settings_loaded")
            end
        else
            TextLabel.Text = "Settings file not found"
        end
    else
        TextLabel.Text = "Cannot load settings (filesystem not available)"
    end
end

local function applyPreset(presetName)
    for _, preset in ipairs(presets) do
        if preset.name == presetName then
            for k, v in pairs(preset.settings) do
                if tempSettings[k] ~= nil then
                    tempSettings[k] = v
                end
            end
            populateSettings()
            updateInterfaceTexts()
            TextLabel.Text = t("preset_applied"):format(presetName)
            break
        end
    end
end

