            menuItem("Copy ClassName", function()
                safeClipboard(obj.ClassName)
                Notify("Solanix", "Class copied.", 3)
            end)
            menuItem("Spy this Remote", function()
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent") then
                    -- Switch to Remote Spy tab and pre-add to selected
                    SolanixHub.Navigate("RemoteSpy")
