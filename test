-- Keybind picker (click then press a key).
local bindListening = false
local function Keybind(parent, label, defaultKey, callback)
    local current = defaultKey
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 32),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    local lbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(0.6, 0, 1, 0),
        Font = THEME.font,
        Text = label or "",
        TextColor3 = THEME.textPrimary,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local short = function(kc)
        local s = tostring(kc)
        return string_match(s, "KeyCode%.(.+)") or s
    end
    local btn = Create("TextButton", {
        Parent = row,
        BackgroundColor3 = THEME.bgActive,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -90, 0.5, -10),
        Size = UDim2.new(0, 80, 0, 20),
        Font = THEME.font,
        Text = short(current),
        TextColor3 = THEME.textAccent,
        TextSize = 11,
        AutoButtonColor = false,
    })
    Create("UICorner", { Parent = btn, CornerRadius = THEME.radiusSm })
    Track(btn.MouseButton1Click:Connect(function()
        if bindListening then return end
        bindListening = true
        btn.Text = "..."
        btn.TextColor3 = THEME.amber
        local conn
        conn = Track(UserInputService.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                current = inp.KeyCode
                btn.Text = short(current)
                btn.TextColor3 = THEME.textAccent
                bindListening = false
                if conn then conn:Disconnect() end
                if callback then pcall(callback, current) end
            end
        end))
    end))
    return row, function() return current end, function(kc)
        current = kc
        btn.Text = short(current)
        if callback then pcall(callback, current) end
    end
end
SolanixHub.Keybind = Keybind

