SolanixHub._validate2 = {}

function SolanixHub._validate2.placeId(v)
    return type(v) == "number" and v > 0 and v < 1e12
end

function SolanixHub._validate2.userId(v)
    return type(v) == "number" and v > 0 and v < 1e12
end

function SolanixHub._validate2.assetId(v)
    return type(v) == "number" and v > 0 and v < 1e12
end

function SolanixHub._validate2.playerName(v)
    return type(v) == "string" and #v >= 3 and #v <= 20 and v:match("^[%w_]+$") ~= nil
end

function SolanixHub._validate2.color3(v)
    return typeof(v) == "Color3"
end

function SolanixHub._validate2.vector3(v)
    return typeof(v) == "Vector3" and v.X == v.X and v.Y == v.Y and v.Z == v.Z  -- no NaN
end

function SolanixHub._validate2.instance(v)
    return typeof(v) == "Instance" and v.Parent ~= nil
end

function SolanixHub._validate2.url(v)
    return type(v) == "string" and v:match("^https?://[%w%.%-]+%.[%a]+") ~= nil
end

function SolanixHub._validate2.email(v)
    return type(v) == "string" and v:match("^[%w.+-]+@[%w.-]+%.%w+$") ~= nil
end

function SolanixHub._validate2.luaIdentifier(v)
    return type(v) == "string" and v:match("^[%a_][%w_]*$") ~= nil
end

function SolanixHub._validate2.numberInRange(v, min, max)
    return type(v) == "number" and v >= min and v <= max
end

function SolanixHub._validate2.stringInRange(v, minLen, maxLen)
    return type(v) == "string" and #v >= minLen and #v <= maxLen
end

--=====================================================================
-- COMPREHENSIVE SERIALIZATION
--=====================================================================

SolanixHub._serialize = {}

function SolanixHub._serialize.toString(v, depth)
    depth = depth or 0
    if depth > 5 then return "..." end
    local t = typeof(v)
    if t == "nil" then return "nil"
    elseif t == "boolean" then return tostring(v)
    elseif t == "number" then
        if v ~= v then return "0/0" end
        if v == math_huge then return "math.huge" end
        if v == -math_huge then return "-math.huge" end
        return tostring(v)
    elseif t == "string" then
        return '"' .. v:gsub("\\", "\\\\"):gsub('"', '\\"') .. '"'
    elseif t == "Instance" then
        local ok, name = pcall(function() return v:GetFullName() end)
        return '<instance:' .. (ok and name or tostring(v)) .. '>'
    elseif t == "Vector3" then
        return string_format("Vector3.new(%g, %g, %g)", v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return string_format("Vector2.new(%g, %g)", v.X, v.Y)
    elseif t == "CFrame" then
        local p = v.Position
        return string_format("CFrame.new(%g, %g, %g)", p.X, p.Y, p.Z)
    elseif t == "Color3" then
        return string_format("Color3.fromRGB(%d, %d, %d)",
            math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255))
    elseif t == "UDim" then
        return string_format("UDim.new(%g, %d)", v.Scale, v.Offset)
    elseif t == "UDim2" then
        return string_format("UDim2.new(%g, %d, %g, %d)",
            v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "BrickColor" then
        return "BrickColor.new(" .. tostring(v.Number) .. ")"
    elseif t == "table" then
        local parts = {}
        for k, val in pairs(v) do
            if #parts < 10 then
                local keyStr = (type(k) == "string" and SolanixHub._validate2.luaIdentifier(k)) and k or ("[" .. SolanixHub._serialize.toString(k, depth + 1) .. "]")
                table_insert(parts, keyStr .. " = " .. SolanixHub._serialize.toString(val, depth + 1))
            else
                table_insert(parts, "...")
                break
            end
        end
        return "{ " .. table.concat(parts, ", ") .. " }"
    elseif t == "function" then
        return "<function>"
    elseif t == "userdata" then
        return "<userdata:" .. tostring(v) .. ">"
    end
    return tostring(v)
end

function SolanixHub._serialize.toJSON(v)
    return HttpService:JSONEncode(v)
end

function SolanixHub._serialize.fromJSON(s)
    return jsonDecode(s)
end

function SolanixHub._serialize.toLuaCode(v, indent)
    indent = indent or 0
    local prefix = string.rep("  ", indent)
    local t = type(v)
    if t == "table" then
        local parts = {"{"}
        for k, val in pairs(v) do
            local keyStr = (type(k) == "string" and SolanixHub._validate2.luaIdentifier(k))
                and k
                or  ("[" .. SolanixHub._serialize.toLuaCode(k, indent + 1) .. "]")
            table_insert(parts, prefix .. "  " .. keyStr .. " = " .. SolanixHub._serialize.toLuaCode(val, indent + 1) .. ",")
        end
        table_insert(parts, prefix .. "}")
        return table.concat(parts, "\n")
    elseif t == "string" then
        return '"' .. v:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n") .. '"'
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "number" then
        return tostring(v)
    elseif t == "nil" then
        return "nil"
    else
        return "--[[unsupported:" .. t .. "]]"
    end
end

