            })
            Create("UICorner", { Parent = b, CornerRadius = THEME.radiusSm })
            ApplyHover(b, THEME.bgHover, THEME.bgElevated)
            Track(b.MouseButton1Click:Connect(function()
                Tween(b, 0.1, { BackgroundColor3 = THEME.accentDim, TextColor3 = THEME.textAccent })
                for _, other in ipairs(filterBar:GetChildren()) do
                    if other:IsA("TextButton") and other ~= b then
                        Tween(other, 0.1, { BackgroundColor3 = THEME.bgElevated, TextColor3 = THEME.textMuted })
                    end
                end
                M.ApplyFilter(filter)
            end))
            return b
        end
        makeFilterBtn("ALL", 8, "ALL")
        makeFilterBtn("RE",  64, "RE")
