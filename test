function remoteHandler(data)
    if not configs.log_local_remotes and not data.fromServer then
        return
    end
    
    if not configs.log_server_events and data.fromServer then
        return
    end
    
    if data.remote:IsA("RemoteFunction") and not configs.log_remote_functions then
        return
    end
    
    if data.remote:IsA("RemoteEvent") and not configs.log_remote_events then
        return
    end
    
    if data.remote:IsA("UnreliableRemoteEvent") and not configs.log_unreliable_events then
        return
    end

    local callHash = getCallHash(data.remote, data.args)
    if ignoredCalls[callHash] then
        return
    end

    if configs.autoblock then
        local id = data.id
        if excluding[id] then
            return
        end
        if not history[id] then
            history[id] = {badOccurances = 0, lastCall = tick()}
        end
        if tick() - history[id].lastCall < 1 then
            history[id].badOccurances += 1
            return
        else
            history[id].badOccurances = 0
        end
        if history[id].badOccurances > 3 then
            excluding[id] = true
            return
        end
        history[id].lastCall = tick()
    end

    local id = data.id
    local remote = data.remote
    
    if blacklist[id] or blacklist[remote.Name] then
        return
    end
    
    if blocklist[id] or blocklist[remote.Name] then
        data.blocked = true
        data.blockcheck = true
    end

    if (data.remote:IsA("RemoteEvent") or data.remote:IsA("UnreliableRemoteEvent")) and lower(data.method) == "fireserver" then
        newRemote("event", data)
    elseif data.remote:IsA("RemoteFunction") and lower(data.method) == "invokeserver" then
        newRemote("function", data)
    elseif data.method == "OnClientEvent" then
        newRemote("server_event", data)
    elseif data.method == "OnClientInvoke" then
        newRemote("server_function", data)
    end
end

local newindex = function(method,originalfunction,...)
    if typeof(...) == 'Instance' then
        local remote = cloneref(...)

        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") or remote:IsA("UnreliableRemoteEvent") then
            if not configs.logcheckcaller and checkcaller() then 
                return originalfunction(...) 
            end
            
            local id = ThreadGetDebugId(remote)
            
            if blacklist[id] or blacklist[remote.Name] then
                if remote:IsA("RemoteFunction") then
                    return nil
                end
                return
            end
            
            local blockcheck = blocklist[id] or blocklist[remote.Name]
            
            local args = {select(2,...)}

            if not IsCyclicTable(args) then
                local data = {
                    method = method,
                    remote = remote,
                    args = deepclone(args),
                    infofunc = infofunc,
                    callingscript = callingscript,
                    metamethod = "__index",
                    blockcheck = blockcheck,
                    id = id,
                    returnvalue = {}
                }
                args = nil

                if configs.funcEnabled then
                    data.infofunc = info(2,"f")
                    local calling = getcallingscript()
                    data.callingscript = calling and cloneref(calling) or nil
                end

                schedule(remoteHandler,data)
                
                if not blockcheck then
                    return originalfunction(...)
                else
                    if remote:IsA("RemoteFunction") then
                        return nil
                    end
                    return
                end
            end
        end
    end
    return originalfunction(...)
end

local newnamecall = newcclosure(function(...)
    if not configs.logcheckcaller and checkcaller() then 
        return originalnamecall(...) 
    end
    
    local args = {...}
    local method = getnamecallmethod()

    if method and (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer") then
        if typeof(args[1]) == 'Instance' then
            local remote = cloneref(args[1])

            if IsA(remote,"RemoteEvent") or IsA(remote,"RemoteFunction") or IsA(remote,"UnreliableRemoteEvent") then    
                local id = ThreadGetDebugId(remote)
                
                if blacklist[id] or blacklist[remote.Name] then
                    if remote:IsA("RemoteFunction") then
                        return nil
                    end
                    return
                end
                
                local blockcheck = blocklist[id] or blocklist[remote.Name]
                
                local largs = clone(args)
                table.remove(largs,1)

                if not IsCyclicTable(largs) then
                    local data = {
                        method = method,
                        remote = remote,
                        args = deepclone(largs),
                        infofunc = infofunc,
                        callingscript = callingscript,
                        metamethod = "__namecall",
                        blockcheck = blockcheck,
                        id = id,
                        returnvalue = {}
                    }
                    largs = nil

                    if configs.funcEnabled then
                        data.infofunc = info(2,"f")
                        local calling = getcallingscript()
                        data.callingscript = calling and cloneref(calling) or nil
                    end

                    schedule(remoteHandler,data)
                    
                    if not blockcheck then
                        return originalnamecall(...)
                    else
                        if remote:IsA("RemoteFunction") then
                            return nil
                        end
                        return
                    end
                end
            end
        end
    end
    return originalnamecall(...)
end)

