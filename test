SolanixHub.modules.ChatHistory = {}
do
    local M = SolanixHub.modules.ChatHistory
    local messages = {}
    local capturing = false
    local conn

    function M.Build()
        local page = SolanixHub.NewPage("ChatHistory")
        local scroll = Scroller(page)

        local ctrlCard, ctrlBody = Section(scroll, "Capture Controls")
        Button(ctrlBody, capturing and "Stop Capture" or "Start Capture", function(btn)
            capturing = not capturing
            btn.Text = capturing and "Stop Capture" or "Start Capture"
            if capturing then
                M.StartCapture()
            else
                M.StopCapture()
            end
        end)
        Button(ctrlBody, "Clear History", function()
            messages = {}
            M.RefreshList()
            Notify("Solanix", "Chat history cleared.", 3)
        end)
        Button(ctrlBody, "Export to Clipboard", function()
            local out = {}
            for _, m in ipairs(messages) do
                table_insert(out, string_format("[%s] %s: %s", m.time, m.speaker, m.text))
            end
            safeClipboard(table.concat(out, "\n"))
            Notify("Solanix", "Chat history exported.", 3)
        end)

        local listCard, listBody = Section(scroll, "Messages")
        M._listBody = listBody
        M.RefreshList()
    end

    function M.StartCapture()
        Spawn(function()
            local ok, chatEvents = pcall(function()
                return ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5)
            end)
            if not ok or not chatEvents then
                Notify("Solanix", "Chat events not found.", 3)
                capturing = false
                return
            end
            local msgEvent = chatEvents:FindFirstChild("OnMessageDoneFiltering")
            if not msgEvent then
                Notify("Solanix", "OnMessageDoneFiltering not found.", 3)
                capturing = false
                return
            end
            conn = Track(msgEvent.OnClientEvent:Connect(function(data)
                if not capturing then return end
                if data and data.Message then
                    table_insert(messages, {
                        speaker = data.FromSpeaker or "?",
                        text = data.Message,
                        time = os.date("%H:%M:%S"),
                    })
                    if #messages > 500 then table_remove(messages, 1) end
                    M.RefreshList()
                end
            end))
            Notify("Solanix", "Chat capture started.", 3)
        end)
    end

    function M.StopCapture()
        if conn then conn:Disconnect() conn = nil end
        Notify("Solanix", "Chat capture stopped.", 3)
    end

    function M.RefreshList()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "MsgRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for i = #messages, math.max(1, #messages - 49), -1 do
            local m = messages[i]
            if m then
                local row = Create("Frame", {
                    Parent = M._listBody,
                    Name = "MsgRow",
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 30),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("UIPadding", {
                    Parent = row,
                    PaddingLeft = UDim.new(0, 10),
                    PaddingRight = UDim.new(0, 10),
                    PaddingTop = UDim.new(0, 4),
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(1, 0, 0, 12),
                    Font = THEME.fontBold,
                    Text = "[" .. m.time .. "] " .. m.speaker,
                    TextColor3 = THEME.textAccent,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 13),
                    Size = UDim2.new(1, 0, 0, 14),
                    Font = THEME.font,
                    Text = m.text,
                    TextColor3 = THEME.textPrimary,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
        end
    end
end

