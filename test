SolanixHub.modules.RemoteCallGenerator = {}
do
    local M = SolanixHub.modules.RemoteCallGenerator
    function M.Build()
        local page = SolanixHub.NewPage("RemoteCallGenerator")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Remote Call Generator")
        Label(body, "Manually construct and fire a remote call with custom arguments.", { size = 11 })

        local _, pathInput = TextBox(body, "Remote path", "game.ReplicatedStorage.RemoteEvent", "", function() end)
        local _, methodInput = TextBox(body, "Method (FireServer/InvokeServer)", "FireServer", "", function() end)

        -- Up to 5 arguments
        local args = {}
        for i = 1, 5 do
            local _, argInput = TextBox(body, "Arg " .. i .. " (Lua syntax: 'string', 123, true, nil)", "", "", function() end)
            args[i] = argInput
        end

        Button(body, "Generate Code", function()
            local path = pathInput.Text
            local method = methodInput.Text
            local parts = {}
            for i = 1, 5 do
                local a = args[i].Text
                if a ~= "" then
                    table_insert(parts, a)
                end
            end
            local code = path .. ":" .. method .. "(" .. table.concat(parts, ", ") .. ")"
            safeClipboard(code)
            Notify("Solanix", "Code copied: " .. code, 4)
        end)

        Button(body, "Execute Once", function()
            local path = pathInput.Text
            local method = methodInput.Text
            local fn = loadstring("return " .. path)
            if not fn then Notify("Solanix", "Invalid path.", 3) return end
            setfenv(fn, getfenv())
            local ok, remote = pcall(fn)
            if not ok or typeof(remote) ~= "Instance" then
                Notify("Solanix", "Remote not found.", 3)
                return
            end
            -- Parse args
            local argValues = {}
            for i = 1, 5 do
                local a = args[i].Text
                if a ~= "" then
                    local argFn = loadstring("return " .. a)
                    if argFn then
                        setfenv(argFn, getfenv())
                        local ok2, val = pcall(argFn)
                        if ok2 then table_insert(argValues, val) end
                    end
                end
            end
            pcall(function()
                if method == "FireServer" then
                    remote:FireServer(table.unpack(argValues))
                elseif method == "InvokeServer" then
                    remote:InvokeServer(table.unpack(argValues))
                end
            end)
            Notify("Solanix", "Call fired with " .. #argValues .. " args.", 3)
        end)

        Button(body, "Execute 10 Times", function()
            local path = pathInput.Text
            local method = methodInput.Text
            local fn = loadstring("return " .. path)
            if not fn then return end
            setfenv(fn, getfenv())
            local ok, remote = pcall(fn)
            if not ok then return end
            local argValues = {}
            for i = 1, 5 do
                local a = args[i].Text
                if a ~= "" then
                    local argFn = loadstring("return " .. a)
                    if argFn then
                        setfenv(argFn, getfenv())
                        local ok2, val = pcall(argFn)
                        if ok2 then table_insert(argValues, val) end
                    end
                end
            end
            Spawn(function()
                for _ = 1, 10 do
                    pcall(function()
                        if method == "FireServer" then
                            remote:FireServer(table.unpack(argValues))
                        elseif method == "InvokeServer" then
                            remote:InvokeServer(table.unpack(argValues))
                        end
                    end)
                    task_wait(0.05)
                end
                Notify("Solanix", "Fired 10 times.", 3)
            end)
        end)
    end
end

