SolanixHub._builders = {}

function SolanixHub._builders.row(parent, label, height)
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 32),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    if label then
        Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 0),
            Size = UDim2.new(0.4, 0, 1, 0),
            Font = THEME.font,
            Text = label,
            TextColor3 = THEME.textPrimary,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
    end
    return row
end

