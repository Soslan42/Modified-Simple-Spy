-- SwitchRow: a labelled toggle with description text below
function SolanixHub.Widgets.SwitchRow(parent, title, description, default, callback)
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 50),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    Create("UIPadding", {
        Parent = row,
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 8),
    })
    local titleLbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -50, 0, 16),
        Font = THEME.fontBold,
        Text = title or "",
        TextColor3 = THEME.textPrimary,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local descLbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 18),
        Size = UDim2.new(1, -50, 0, 24),
        Font = THEME.font,
        Text = description or "",
        TextColor3 = THEME.textSecondary,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
    })
    local _, getter, setter = Toggle(row, "", default, callback)
    -- Reposition the toggle to the right
    -- (Toggle creates its own row, so we need a different approach)
    -- Actually, let's create a custom toggle here:
    local state = default and true or false
    local switch = Create("TextButton", {
        Parent = row,
        BackgroundColor3 = state and THEME.accent or THEME.bgActive,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -44, 0, 8),
        Size = UDim2.new(0, 34, 0, 20),
        Text = "",
        AutoButtonColor = false,
    })
    Create("UICorner", { Parent = switch, CornerRadius = UDim.new(1, 0) })
    local knob = Create("Frame", {
        Parent = switch,
        BackgroundColor3 = THEME.textPrimary,
        BorderSizePixel = 0,
        Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
        Size = UDim2.new(0, 14, 0, 14),
    })
    Create("UICorner", { Parent = knob, CornerRadius = UDim.new(1, 0) })
    Track(switch.MouseButton1Click:Connect(function()
        state = not state
        Tween(switch, 0.15, { BackgroundColor3 = state and THEME.accent or THEME.bgActive })
        Tween(knob, 0.15, { Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) })
        if callback then pcall(callback, state) end
    end))
    return row, function() return state end, function(v)
        state = v and true or false
        switch.BackgroundColor3 = state and THEME.accent or THEME.bgActive
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        if callback then pcall(callback, state) end
    end
end

