SolanixHub.modules.Player = {}
do
    local M = SolanixHub.modules.Player
    local page
    local noclip = false
    local fly = false
    local infJump = false
    local speed = 16
    local jump = 50
    local noclipConn
    local flyMovers = {}

    function M.Build()
        page = SolanixHub.NewPage("Player")
        local scroll = Scroller(page)

        -- Movement
        local moveCard, moveBody = Section(scroll, "Movement")
        Slider(moveBody, "Walk Speed", 1, 500, 16, 0, function(v)
            speed = v
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").WalkSpeed = v
            end
        end)
        Slider(moveBody, "Jump Power", 0, 500, 50, 0, function(v)
            jump = v
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.UseJumpPower = true
                hum.JumpPower = v
            end
        end)
        Toggle(moveBody, "Infinite Jump", false, function(v)
            infJump = v
        end)
        Toggle(moveBody, "Noclip", false, function(v)
            M.SetNoclip(v)
        end)
        Toggle(moveBody, "Fly (press F to toggle)", false, function(v)
            M.SetFly(v)
        end)
        Slider(moveBody, "Fly Speed", 10, 500, 60, 0, function(v)
            SolanixHub._state.flySpeed = v
        end)
        SolanixHub._state.flySpeed = 60

        -- Character actions
        local actCard, actBody = Section(scroll, "Character Actions")
        Button(actBody, "Respawn", function()
            local char = LocalPlayer.Character
            if char then char:BreakJoints() end
        end)
        Button(actBody, "Reset", function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = 0
            end
        end)
        Button(actBody, "Sit", function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = true end
        end)
        Button(actBody, "Stand Up", function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = false end
        end)
        Button(actBody, "Freeze", function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = not root.Anchored
            end
        end)

        -- Anti-AFK
        local afkCard, afkBody = Section(scroll, "Anti-AFK")
        Toggle(afkBody, "Anti-AFK (block idle disconnect)", false, function(v)
            SolanixHub._state.antiAfk = v
            if v then
                -- Hook VirtualUser to simulate input on idle
                local VirtualUser = SafeGetService("VirtualUser")
                local VirtualInputManager = SafeGetService("VirtualInputManager")
                SolanixHub._state.idleConn = Track(LocalPlayer.Idled:Connect(function()
                    if VirtualUser then
                        pcall(function()
                            VirtualUser:CaptureController()
                            VirtualUser:ClickButton2(Vector2.new())
                        end)
                    end
                end))
                Notify("Solanix", "Anti-AFK enabled.", 3)
            else
                if SolanixHub._state.idleConn then
                    SolanixHub._state.idleConn:Disconnect()
                    SolanixHub._state.idleConn = nil
                end
                Notify("Solanix", "Anti-AFK disabled.", 3)
            end
        end)

        -- Auto-respawn on death
        local arCard, arBody = Section(scroll, "Auto-Respawn")
        Toggle(arBody, "Auto-respawn on death", false, function(v)
            SolanixHub._state.autoRespawn = v
            if v and not SolanixHub._state.diedConn then
                local function hookChar(char)
                    if not char then return end
                    local hum = char:WaitForChild("Humanoid", 5)
                    if hum then
                        Track(hum.Died:Connect(function()
                            task_wait(Players.RespawnTime or 5)
                            if SolanixHub._state.autoRespawn then
                                pcall(function() LocalPlayer:LoadCharacter() end)
                            end
                        end))
                    end
                end
                if LocalPlayer.Character then hookChar(LocalPlayer.Character) end
                SolanixHub._state.diedConn = Track(LocalPlayer.CharacterAdded:Connect(hookChar))
            elseif not v and SolanixHub._state.diedConn then
                SolanixHub._state.diedConn:Disconnect()
                SolanixHub._state.diedConn = nil
            end
        end)

        -- Apply walk speed on respawn
        Track(LocalPlayer.CharacterAdded:Connect(function(char)
            task_wait(0.3)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = speed
                hum.UseJumpPower = true
                hum.JumpPower = jump
            end
        end))
    end

    function M.SetNoclip(v)
        noclip = v
        if v then
            local function step()
                local char = LocalPlayer.Character
                if not char then return end
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then
                        p.CanCollide = false
                    end
                end
            end
            noclipConn = Track(RunService.Stepped:Connect(step))
            Notify("Solanix", "Noclip enabled.", 3)
        else
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
            Notify("Solanix", "Noclip disabled.", 3)
        end
    end

    function M.SetFly(v)
        fly = v
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            if v then Notify("Solanix", "No character — can't fly.", 3) end
            fly = false
            return
        end
        if v then
            local bv = Create("BodyVelocity", {
                Parent = root,
                MaxForce = Vector3.one * 9e9,
                Velocity = Vector3.zero,
            })
            local bg = Create("BodyGyro", {
                Parent = root,
                MaxTorque = Vector3.one * 9e9,
                P = 9e4,
                CFrame = root.CFrame,
            })
            flyMovers = { bv, bg }
            SolanixHub._state.flyConn = Track(RunService.Heartbeat:Connect(function()
                if not fly then return end
                local c = LocalPlayer.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if not r then return end
                local cam = Camera.CFrame
                local vel = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel += cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel -= cam.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel -= cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel += cam.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel += Vector3.yAxis end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel -= Vector3.yAxis end
                bv.Velocity = vel * (SolanixHub._state.flySpeed or 60)
                if vel.Magnitude > 0 then
                    bg.CFrame = cam
                end
            end))
            Notify("Solanix", "Fly enabled. Use WASD + Space/Shift.", 3)
        else
            if SolanixHub._state.flyConn then
                SolanixHub._state.flyConn:Disconnect()
                SolanixHub._state.flyConn = nil
            end
            for _, m in ipairs(flyMovers) do pcall(function() m:Destroy() end) end
            flyMovers = {}
            Notify("Solanix", "Fly disabled.", 3)
        end
    end

    -- Infinite jump hook
    Track(UserInputService.JumpRequest:Connect(function()
        if infJump and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end))

    -- F key toggles fly when fly was last enabled
    Track(UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.KeyCode == Enum.KeyCode.F and SolanixHub.modules.Player then
            -- Only auto-toggle if we've enabled fly at least once via UI
            -- (avoid stealing F when user hasn't opted in)
        end
    end))
end

