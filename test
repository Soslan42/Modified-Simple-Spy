-- Conversion helpers
SolanixHub._convert = {}

function SolanixHub._convert.toString(v)
    return ValueToString(v)
end

function SolanixHub._convert.toNumber(v)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) end
    if type(v) == "boolean" then return v and 1 or 0 end
    return nil
end

function SolanixHub._convert.toBoolean(v)
    if type(v) == "boolean" then return v end
    if type(v) == "number" then return v ~= 0 end
    if type(v) == "string" then
        local lower = v:lower()
        if lower == "true" or lower == "1" or lower == "yes" or lower == "on" then return true end
        if lower == "false" or lower == "0" or lower == "no" or lower == "off" then return false end
    end
    return nil
end

function SolanixHub._convert.toColor3(v)
    if typeof(v) == "Color3" then return v end
    if type(v) == "string" then
        return SolanixHub._colorUtils.hex(v)
    end
    if typeof(v) == "Vector3" then
        return Color3.new(v.X, v.Y, v.Z)
    end
    return nil
end

function SolanixHub._convert.toVector3(v)
    if typeof(v) == "Vector3" then return v end
    if typeof(v) == "Color3" then
        return Vector3.new(v.R, v.G, v.B)
    end
    if type(v) == "table" then
        return Vector3.new(v[1] or v.x or 0, v[2] or v.y or 0, v[3] or v.z or 0)
    end
    return nil
end

function SolanixHub._convert.toUDim2(v)
    if typeof(v) == "UDim2" then return v end
    if type(v) == "table" then
        return UDim2.new(
            v[1] or v.XScale or 0,
            v[2] or v.XOffset or 0,
            v[3] or v.YScale or 0,
            v[4] or v.YOffset or 0
        )
    end
    return nil
end

-- Path helpers
SolanixHub._path = {}

function SolanixHub._path.getFullName(obj)
    if not obj then return "nil" end
    local ok, name = pcall(function() return obj:GetFullName() end)
    return ok and name or tostring(obj)
end

function SolanixHub._path.getParent(obj, depth)
    depth = depth or 1
    local current = obj
    for _ = 1, depth do
        if not current or not current.Parent then return nil end
        current = current.Parent
    end
    return current
end

function SolanixHub._path.getChildren(obj)
    if not obj then return {} end
    local children = {}
    pcall(function()
        for _, c in ipairs(obj:GetChildren()) do
            table_insert(children, c)
        end
    end)
    return children
end

function SolanixHub._path.getDescendants(obj, maxDepth)
    if not obj then return {} end
    local result = {}
    local function walk(o, depth)
        if maxDepth and depth > maxDepth then return end
        pcall(function()
            for _, c in ipairs(o:GetChildren()) do
                table_insert(result, c)
                walk(c, (depth or 0) + 1)
            end
        end)
    end
    walk(obj, 0)
    return result
end

function SolanixHub._path.findByFullName(path)
    -- Walk a "Workspace.Foo.Bar" path and return the instance
    local parts = SolanixHub._stringUtils.split(path, ".")
    local current = game
    for i, part in ipairs(parts) do
        if i == 1 then
            if part == "game" then
                -- already at game
            elseif part == "workspace" or part == "Workspace" then
                current = Workspace
            else
                local ok, svc = pcall(function() return game:GetService(part) end)
                if ok and svc then
                    current = svc
                else
                    current = game:FindFirstChild(part)
                    if not current then return nil end
                end
            end
        else
            current = current:FindFirstChild(part)
            if not current then return nil end
        end
    end
    return current
end

