--=====================================================================
-- SHUTDOWN
--=====================================================================

function getgenv().SolanixHub_Shutdown()
    -- Disconnect every tracked connection
    for i, c in ipairs(SolanixHub._connections) do
        pcall(function() c:Disconnect() end)
        SolanixHub._connections[i] = nil
    end
    -- Close every tracked coroutine
    for i, co in ipairs(SolanixHub._threads) do
        pcall(function() coroutine.close(co) end)
        SolanixHub._threads[i] = nil
    end
    -- Destroy every tracked instance
    for i, inst in ipairs(SolanixHub._instances) do
        pcall(function() inst:Destroy() end)
        SolanixHub._instances[i] = nil
    end
    -- Restore hooks (Remote Spy)
    if SolanixHub.modules.RemoteSpy and SolanixHub.modules.RemoteSpy._restoreHooks then
        pcall(SolanixHub.modules.RemoteSpy._restoreHooks)
    end
    -- Restore lighting (if Fullbright was on)
    pcall(function()
        if SolanixHub._state.originalLighting then
            local L = Lighting
            local o = SolanixHub._state.originalLighting
            if o.Brightness then L.Brightness = o.Brightness end
            if o.ClockTime then L.ClockTime = o.ClockTime end
            if o.FogEnd then L.FogEnd = o.FogEnd end
            if o.GlobalShadows ~= nil then L.GlobalShadows = o.GlobalShadows end
            if o.Ambient then L.Ambient = o.Ambient end
        end
    end)
    -- Restore camera
    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") or nil
    end)
    -- Destroy the main ScreenGui (this also kills every child UI)
    pcall(function() if SolanixGui then SolanixGui:Destroy() end end)
    -- Mark as not-executed so a re-run works
    getgenv().SolanixHub_Executed = false
    getgenv().SolanixHub_Shutdown = nil
end

