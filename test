SolanixHub.modules.CloneTool = {}
do
    local M = SolanixHub.modules.CloneTool
    function M.Build()
        local page = SolanixHub.NewPage("CloneTool")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Clone Tool")
        Label(body, "Clone any instance by path. The clone is placed under Workspace.", { size = 11 })

        local _, pathInput = TextBox(body, "Instance path", "game.ReplicatedStorage.SomeItem", "", function() end)
        local _, countInput = TextBox(body, "Number of clones", "1", "", function() end)
        Button(body, "Clone", function()
            local path = pathInput.Text
            local count = tonumber(countInput.Text) or 1
            if path == "" then Notify("Solanix", "Path required.", 3) return end
            local fn = loadstring("return " .. path)
            if not fn then Notify("Solanix", "Invalid path.", 3) return end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or typeof(obj) ~= "Instance" then
                Notify("Solanix", "Instance not found.", 3)
                return
            end
            for i = 1, count do
                pcall(function()
                    local clone = obj:Clone()
                    clone.Name = obj.Name .. "_clone" .. i
                    clone.Parent = Workspace
                end)
            end
            Notify("Solanix", "Cloned " .. count .. " time(s).", 3)
        end)

        Button(body, "Clone to my Character", function()
            local path = pathInput.Text
            if path == "" then return end
            local fn = loadstring("return " .. path)
            if not fn then return end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or typeof(obj) ~= "Instance" then return end
            local char = LocalPlayer.Character
            if char then
                local clone = obj:Clone()
                clone.Parent = char
                Notify("Solanix", "Cloned into character.", 3)
            end
        end)
    end
end

