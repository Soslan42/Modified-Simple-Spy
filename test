        if #props == 0 then
            -- Fallback: walk a known list of common properties
            local fallback = {
                "Name", "ClassName", "Parent", "Archivable",
                "Anchored", "CanCollide", "CanTouch", "CanQuery",
                "Transparency", "Color", "Material", "Size", "Position", "CFrame",
                "Orientation", "Rotation", "Velocity", "RotVelocity",
