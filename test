SolanixHub.modules.AdvancedPlayerTools = {}
do
    local M = SolanixHub.modules.AdvancedPlayerTools
    function M.Build()
        local page = SolanixHub.NewPage("AdvancedPlayerTools")
        local scroll = Scroller(page)

        local invisCard, invisBody = Section(scroll, "Invisibility")
        Toggle(invisBody, "Invisible (transparent character)", false, function(v)
