-- Random helpers
SolanixHub._rand = {}

function SolanixHub._rand.int(min, max)
    return math.random(min, max)
end

function SolanixHub._rand.float(min, max)
    return min + math.random() * (max - min)
end

function SolanixHub._rand.bool()
    return math.random() < 0.5
end

function SolanixHub._rand.choice(arr)
    if not arr or #arr == 0 then return nil end
    return arr[math.random(1, #arr)]
end

function SolanixHub._rand.shuffle(arr)
    local copy = SolanixHub._tableUtils.shallowCopy(arr)
    for i = #copy, 2, -1 do
        local j = math.random(1, i)
        copy[i], copy[j] = copy[j], copy[i]
    end
    return copy
end

function SolanixHub._rand.string(length, charset)
    length = length or 10
    charset = charset or "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local result = {}
    for _ = 1, length do
        local idx = math.random(1, #charset)
        table_insert(result, charset:sub(idx, idx))
    end
    return table.concat(result)
end

function SolanixHub._rand.uuid()
    return SolanixHub._mathUtils.uuid()
end

function SolanixHub._rand.color3()
    return Color3.new(math.random(), math.random(), math.random())
end

function SolanixHub._rand.vector3(min, max)
    min = min or -100
    max = max or 100
    return Vector3.new(
        SolanixHub._rand.float(min, max),
        SolanixHub._rand.float(min, max),
        SolanixHub._rand.float(min, max)
    )
end

-- Validation helpers
SolanixHub._validate = {}

function SolanixHub._validate.string(v, minLen, maxLen)
    if type(v) ~= "string" then return false end
    if minLen and #v < minLen then return false end
    if maxLen and #v > maxLen then return false end
    return true
end

function SolanixHub._validate.number(v, min, max)
    if type(v) ~= "number" then return false end
    if v ~= v then return false end  -- NaN
    if min and v < min then return false end
    if max and v > max then return false end
    return true
end

function SolanixHub._validate.email(v)
    if type(v) ~= "string" then return false end
    return v:match("^[%w.+-]+@[%w.-]+%.%w+$") ~= nil
end

function SolanixHub._validate.url(v)
    if type(v) ~= "string" then return false end
    return v:match("^https?://[%w.-]+") ~= nil
end

function SolanixHub._validate.userId(v)
    if type(v) ~= "number" then return false end
    if v <= 0 then return false end
    return true
end

function SolanixHub._validate.assetId(v)
    if type(v) ~= "number" then return false end
    if v <= 0 then return false end
    return true
end

-- Debugging helpers
SolanixHub._debug = {}

function SolanixHub._debug.dump(obj, depth, indent)
    depth = depth or 3
    indent = indent or 0
    if depth < 0 then return "..." end
    local prefix = string.rep("  ", indent)
    local t = type(obj)
    if t == "table" then
        local parts = {"{"}
        for k, v in pairs(obj) do
            table_insert(parts, prefix .. "  " .. tostring(k) .. " = " .. SolanixHub._debug.dump(v, depth - 1, indent + 1) .. ",")
        end
        table_insert(parts, prefix .. "}")
        return table.concat(parts, "\n")
    elseif t == "string" then
        return '"' .. obj .. '"'
    elseif t == "function" then
        return "<function>"
    elseif typeof(obj) == "Instance" then
        local ok, name = pcall(function() return obj:GetFullName() end)
        return "<instance: " .. (ok and name or tostring(obj)) .. ">"
    else
        return tostring(obj)
    end
end

function SolanixHub._debug.trace(msg)
    print("[Solanix Trace] " .. tostring(msg))
end

function SolanixHub._debug.warn(msg)
    warn("[Solanix Warn] " .. tostring(msg))
end

function SolanixHub._debug.error(msg)
    warn("[Solanix Error] " .. tostring(msg))
end

function SolanixHub._debug.timer(name, fn, ...)
    local start = os.clock()
    local results = {pcall(fn, ...)}
    local elapsed = os.clock() - start
    if results[1] then
        print(string_format("[Solanix Timer] %s: %.4fs", name, elapsed))
    else
        warn(string_format("[Solanix Timer] %s: FAILED in %.4fs — %s", name, elapsed, tostring(results[2])))
    end
    return table.unpack(results, 2)
end

