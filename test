        for _, child in ipairs(tab:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end
    end
    
    -- General settings (language removed)
    local generalContainer = Create("Frame", {
        Parent = TabContents.general,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0)
    })
    
    local generalLayout = Create("UIListLayout", {
        Parent = generalContainer,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5)
    })
    
    -- No language option
    createSettingElement(generalContainer, "theme", "dropdown", {"dark", "light"})
    createSettingElement(generalContainer, "gui_scale", "slider", {min = 0.5, max = 2, step = 0.1})
    
