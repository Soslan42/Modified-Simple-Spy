    -- Set selection (with history tracking)
    function setSelection(obj)
        selectedInstance = obj
        -- Reset history forward of current index
        if selectionIndex < #selectionHistory then
            for i = selectionIndex + 1, #selectionHistory do
                selectionHistory[i] = nil
            end
        end
        table_insert(selectionHistory, obj)
        selectionIndex = #selectionHistory
        populateProperties(obj)
        -- Highlight row in tree
        for inst, node in next, nodes do
            if node.row then
                Tween(node.row, 0.1, {
                    BackgroundColor3 = (inst == obj) and THEME.accentDim or THEME.bgElevated,
                })
            end
        end
    end

