        Track(btn.MouseButton1Click:Connect(function()
            if b.callback then pcall(b.callback) end
            pcall(function() overlay:Destroy() end)
        end))
    end
    Track(overlay.MouseButton1Click:Connect(function()
        pcall(function() overlay:Destroy() end)
    end))
    return modal, overlay
end

