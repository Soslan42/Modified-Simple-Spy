    function M.Refresh()
        if not M._body then return end
        for _, c in ipairs(M._body:GetChildren()) do
            if c:IsA("Frame") and c.Name == "HistRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for i = #history, math.max(1, #history - 49), -1 do
