-- String formatting helpers
SolanixHub._fmt = {}

function SolanixHub._fmt.number(n)
    if type(n) ~= "number" then return tostring(n) end
    if n ~= n then return "NaN" end  -- NaN check
    if n == math_huge then return "inf" end
    if n == -math_huge then return "-inf" end
    if n == math.floor(n) and math.abs(n) < 1e15 then
        return string_format("%d", n)
    end
    return string_format("%.4f", n)
end

function SolanixHub._fmt.bytes(b)
    if b < 1024 then return string_format("%d B", b) end
    if b < 1024 * 1024 then return string_format("%.1f KB", b / 1024) end
    if b < 1024 * 1024 * 1024 then return string_format("%.1f MB", b / (1024 * 1024)) end
    return string_format("%.1f GB", b / (1024 * 1024 * 1024))
end

function SolanixHub._fmt.duration(seconds)
    if seconds < 60 then return string_format("%.1fs", seconds) end
    if seconds < 3600 then return string_format("%dm %ds", math_floor(seconds / 60), seconds % 60) end
    if seconds < 86400 then return string_format("%dh %dm", math_floor(seconds / 3600), (seconds % 3600) / 60) end
    return string_format("%dd %dh", math_floor(seconds / 86400), (seconds % 86400) / 3600)
end

function SolanixHub._fmt.percentage(value, total)
    if total == 0 then return "0%" end
    return string_format("%.1f%%", (value / total) * 100)
end

function SolanixHub._fmt.memory(kb)
    if kb < 1024 then return string_format("%.1f KB", kb) end
    return string_format("%.1f MB", kb / 1024)
end

