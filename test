--=====================================================================
-- REMOTE SPY MODULE (full SimpleSpy functionality, Solanix-styled)
--=====================================================================
-- Hooks __namecall + FireServer/InvokeServer to log every remote call.
-- Supports: blacklist (exclude), blocklist (block), filter, click-to-copy,
-- grouping by remote, multiselect, spam, hotkeys, max-logs slider.

SolanixHub.modules.RemoteSpy = {}
do
    local M = SolanixHub.modules.RemoteSpy
    local page

    -- State
    local spyActive       = false
    local logs            = {}        -- all log entries
    local groups          = {}        -- [fullName] = { count=, frame=, calls={...} }
    local selectedLogs    = {}        -- multiselect
    local lastSelected    = nil
    local blacklist       = {}        -- exclude (don't log at all)
    local blocklist       = {}        -- block (server call blocked, still log)
    local maxLogs         = 300
    local currentFilter   = "ALL"     -- ALL / RE / RF
    local spamActive      = false
    local spamThread
    local layoutOrder     = 999999999
    local originalNamecall
    local originalFire
    local originalInvoke
    local originalUnreliableFire
    local hookedFunctions = {}
    local codebox         = nil       -- code preview frame
    local logList         = nil       -- scrolling list of groups
    local statusLbl       = nil

    -- Storage for hook probes
    local Storage = Create("Folder", { Name = "SolanixSpyStorage" })
    TrackInstance(Storage)
    local remoteEvent    = Create("RemoteEvent",          { Parent = Storage, Name = "SolanixProbeRE" })
    local remoteFunc     = Create("RemoteFunction",       { Parent = Storage, Name = "SolanixProbeRF" })
    local unreliableEvent= Create("UnreliableRemoteEvent",{ Parent = Storage, Name = "SolanixProbeURE" })

    -- Safe-DebugId helper (so we can index remotes by a stable id)
    local OldDebugId = game.GetDebugId
    local function getDebugId(obj)
        local ok, id = pcall(OldDebugId, obj)
        return ok and id or tostring(obj)
    end

    -- Deep clone args so we don't keep live references
    local function deepClone(v, copies)
        copies = copies or {}
        if type(v) == "table" then
            if copies[v] then return copies[v] end
            local copy = {}
            copies[v] = copy
            for k, val in next, v do
                copy[deepClone(k, copies)] = deepClone(val, copies)
            end
            return copy
        elseif typeof(v) == "Instance" then
            return cloneref(v)
        end
        return v
    end

    -- Cyclic-table check (avoids infinite recursion)
    local function isCyclic(t, seen)
        seen = seen or {}
        if seen[t] then return true end
        seen[t] = true
        for _, v in next, t do
            if type(v) == "table" and isCyclic(v, seen) then return true end
        end
        seen[t] = nil
        return false
    end

    -- Check if a remote is in a list (by DebugId or Name)
    local function isInList(list, remote, id)
        return list[id] or list[remote.Name]
    end

    -- Generate the call code for click-to-copy
    local function genCallCode(remote, args)
        local path = ""
        local ok, fullPath = pcall(function() return remote:GetFullName() end)
        if ok then
            -- Convert "Workspace.Foo.Bar" to "workspace.Foo.Bar" or "game:GetService('Foo').Bar"
            path = fullPath:gsub("^Workspace$", "workspace")
                           :gsub("^Workspace%.", "workspace.")
            if path == fullPath then
                -- wasn't workspace, try game:GetService split
                local firstDot = fullPath:find("%.")
                local first = firstDot and fullPath:sub(1, firstDot - 1) or fullPath
                local rest  = firstDot and fullPath:sub(firstDot) or ""
                path = 'game:GetService("' .. first .. '")' .. rest
            end
        else
            path = "<remote>"
        end
        local argStr = ""
        for i, a in ipairs(args) do
            if i > 1 then argStr = argStr .. ", " end
            argStr = argStr .. ValueToString(a)
        end
        local method
        if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
            method = ":FireServer"
        elseif remote:IsA("RemoteFunction") then
            method = ":InvokeServer"
        else
            method = ":FireServer"
        end
        return ("local remote = %s\nremote%s(%s)"):format(path, method, argStr)
    end

    -- Refresh multiselect visuals
    local function refreshSelectionColors()
        for _, log in ipairs(logs) do
            if log.row then
                local isSel = table_find(selectedLogs, log) ~= nil
                Tween(log.row, 0.1, {
                    BackgroundColor3 = isSel and THEME.accentDim or THEME.bgElevated,
                })
                if log.statusBar then
                    log.statusBar.BackgroundColor3 = log.blocked and THEME.red or (isSel and THEME.accent or THEME.borderMid)
                end
            end
        end
    end

    local function selectLog(log, ctrl, shift)
        if shift and lastSelected then
            local s = table_find(logs, lastSelected)
            local e = table_find(logs, log)
            if s and e then
                selectedLogs = {}
                for i = math.min(s, e), math.max(s, e) do
                    table_insert(selectedLogs, logs[i])
                end
            end
        elseif ctrl then
            local idx = table_find(selectedLogs, log)
            if idx then table_remove(selectedLogs, idx)
            else table_insert(selectedLogs, log) end
        else
            selectedLogs = { log }
        end
        lastSelected = log
        refreshSelectionColors()

        -- Update codebox
        if codebox then
            if #selectedLogs == 1 then
                codebox.Text = selectedLogs[1].genCode or "-- generating..."
            elseif #selectedLogs > 1 then
                local out = ""
                for i, l in ipairs(selectedLogs) do
                    out = out .. ("-- [%d] %s%s\n%s\n\n"):format(
                        i, l.remote and l.remote.Name or "?",
                        l.blocked and " [BLOCKED]" or "",
                        l.genCode or "")
                end
                codebox.Text = out
            else
                codebox.Text = ""
            end
        end
        if statusLbl then
            statusLbl.Text = #selectedLogs > 1
                and ("Selected: " .. #selectedLogs .. " calls — Ctrl/Shift for multi")
                or  (log.remote and log.remote.Name or "?")
        end
    end

    -- Add a new log entry; creates or updates its group
    local function addLog(remote, method, args, blocked)
        local fullName
        do
            local ok, fn = pcall(function() return remote:GetFullName() end)
            fullName = ok and fn or (remote.Name .. "[?]")
        end

        -- Create group if missing
        if not groups[fullName] then
            layoutOrder = layoutOrder - 1
            local gFrame = Create("Frame", {
                Parent = logList,
                BackgroundColor3 = THEME.bgPanel,
                BorderSizePixel = 0,
                LayoutOrder = layoutOrder,
                Size = UDim2.new(1, 0, 0, 28),
                ClipsDescendants = true,
            })
            ApplySolanixSurface(gFrame)
            local typeColor = (remote:IsA("RemoteFunction")) and THEME.cyan or THEME.amber
            local bar = Create("Frame", {
                Parent = gFrame,
                BackgroundColor3 = typeColor,
                BorderSizePixel = 0,
                Size = UDim2.new(0, 3, 1, 0),
            })
            local arrow = Create("TextLabel", {
                Parent = gFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -20, 0, 0),
                Size = UDim2.new(0, 18, 0, 28),
                Font = THEME.fontBold,
                Text = "›",
                TextColor3 = THEME.textMuted,
                TextSize = 16,
                TextXAlignment = Enum.TextXAlignment.Center,
            })
            local gLabel = Create("TextLabel", {
                Parent = gFrame,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -30, 0, 28),
                Font = THEME.fontBold,
                Text = remote.Name .. " (0)",
                TextColor3 = THEME.textPrimary,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local callsFrame = Create("Frame", {
                Parent = gFrame,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0, 28),
                Size = UDim2.new(1, 0, 0, 0),
                ClipsDescendants = true,
            })
            local callsLayout = Create("UIListLayout", {
                Parent = callsFrame,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 1),
            })
            local gBtn = Create("TextButton", {
                Parent = gFrame,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 28),
                Text = "",
                AutoButtonColor = false,
            })
            groups[fullName] = {
                frame = gFrame,
                label = gLabel,
                arrow = arrow,
                callsFrame = callsFrame,
                callsLayout = callsLayout,
                expanded = false,
                count = 0,
                typeColor = typeColor,
                remote = remote,
            }
            local function toggleExpand()
                local g = groups[fullName]
                g.expanded = not g.expanded
                arrow.Text = g.expanded and "⌄" or "›"
                if g.expanded then
                    local h = math.min(g.callsLayout.AbsoluteContentSize.Y, 200)
                    g.frame.Size = UDim2.new(1, 0, 0, 28 + h)
                else
                    g.frame.Size = UDim2.new(1, 0, 0, 28)
                end
            end
            Track(gBtn.MouseButton1Click:Connect(toggleExpand))
            ApplyHover(gFrame, THEME.bgHover, THEME.bgPanel)
        end

        local g = groups[fullName]
        g.count = g.count + 1
        g.label.Text = remote.Name .. " (" .. g.count .. ")"

        -- Filter check
        local show = true
        if currentFilter == "RE" and not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent")) then
            show = false
        elseif currentFilter == "RF" and not remote:IsA("RemoteFunction") then
            show = false
        end
        g.frame.Visible = show

        -- Per-call row
        local callRow = Create("Frame", {
            Parent = g.callsFrame,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            LayoutOrder = g.count,
            Size = UDim2.new(1, 0, 0, 22),
        })
        local statusDot = Create("Frame", {
            Parent = callRow,
            BackgroundColor3 = blocked and THEME.red or THEME.borderMid,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0.5, -6),
            Size = UDim2.new(0, 3, 0, 12),
        })
        local callLbl = Create("TextLabel", {
            Parent = callRow,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 0),
            Size = UDim2.new(1, -8, 1, 0),
            Font = THEME.font,
            Text = ("#%d  %s"):format(g.count, remote.Name),
            TextColor3 = blocked and THEME.red or THEME.textSecondary,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local callBtn = Create("TextButton", {
            Parent = callRow,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Text = "",
            AutoButtonColor = false,
        })

        local logObj = {
            name     = remote.Name,
            remote   = remote,
            method   = method,
            args     = args,
            blocked  = blocked and true or false,
            genCode  = "-- generating...",
            row      = callRow,
            statusBar= statusDot,
            group    = fullName,
        }
        table_insert(logs, logObj)

        -- Generate code async
        Spawn(function()
            logObj.genCode = genCallCode(remote, args)
            if blocked then
                logObj.genCode = "-- THIS REMOTE WAS BLOCKED BY SOLANIX SPY\n\n" .. logObj.genCode
            end
            if #selectedLogs == 1 and selectedLogs[1] == logObj and codebox then
                codebox.Text = logObj.genCode
            end
        end)

        Track(callBtn.MouseButton1Click:Connect(function()
            local ctrl  = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
            selectLog(logObj, ctrl, shift)
        end))
        ApplyHover(callRow, THEME.bgHover, THEME.bgElevated)

        -- Flash the group header
        Tween(g.frame, 0.1, { BackgroundColor3 = THEME.bgActive })
        task_delay(0.15, function()
            Tween(g.frame, 0.2, { BackgroundColor3 = THEME.bgPanel })
        end)

        -- Auto-expand group briefly if it's the first call
        if g.expanded then
            local h = math.min(g.callsLayout.AbsoluteContentSize.Y, 200)
            g.frame.Size = UDim2.new(1, 0, 0, 28 + h)
        end

        -- Enforce max-logs
        if #logs > maxLogs then
            local overflow = #logs - maxLogs
            for i = 1, overflow do
                local old = logs[1]
                if old and old.row then pcall(function() old.row:Destroy() end) end
                table_remove(logs, 1)
            end
        end
    end

    -- The actual hook function for __namecall and __index paths
    local function hookFn(method, original, ...)
        local remote = ...
        if typeof(remote) == "Instance" then
            local isRemote = false
            pcall(function()
                isRemote = remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") or remote:IsA("UnreliableRemoteEvent")
            end)
            if isRemote then
                if not checkcaller() then  -- only log if called by game scripts, not our own
                    local id = getDebugId(remote)
                    local blocked = isInList(blocklist, remote, id)
                    local args = { select(2, ...) }
                    if not isInList(blacklist, remote, id) and not isCyclic(args) then
                        local cloned = deepClone(args)
                        pcall(addLog, remote, method, cloned, blocked)
                    end
                    if blocked then
                        if remote:IsA("RemoteFunction") then return nil end
                        return
                    end
                end
            end
        end
        return original(...)
    end

    local newNamecall = newcclosure(function(...)
        return hookFn("__namecall", originalNamecall, ...)
    end)
    local newFire = newcclosure(function(...)
        return hookFn("FireServer", originalFire, ...)
    end)
    local newInvoke = newcclosure(function(...)
        return hookFn("InvokeServer", originalInvoke, ...)
    end)
    local newUnreliableFire = newcclosure(function(...)
        return hookFn("FireServer", originalUnreliableFire, ...)
    end)

    -- Apply the hooks
    local function applyHooks()
        if not hookmetamethod and not hookfunction then
            Notify("Solanix Spy", "Hooking unavailable — spy cannot intercept calls.", 4)
            return false
        end
        pcall(function()
            if hookmetamethod then
                originalNamecall = hookmetamethod(game, "__namecall", newNamecall)
            elseif hookfunction then
                originalNamecall = hookfunction(getrawmetatable(game).__namecall, newNamecall)
            end
        end)
        pcall(function()
            originalFire = hookfunction(remoteEvent.FireServer, newFire)
        end)
        pcall(function()
            originalInvoke = hookfunction(remoteFunc.InvokeServer, newInvoke)
        end)
        pcall(function()
            originalUnreliableFire = hookfunction(unreliableEvent.FireServer, newUnreliableFire)
        end)
        return true
    end

    -- Restore the original functions
    local function restoreHooks()
        pcall(function()
            if hookfunction and originalFire then
                hookfunction(remoteEvent.FireServer, originalFire)
            end
        end)
        pcall(function()
            if hookfunction and originalInvoke then
                hookfunction(remoteFunc.InvokeServer, originalInvoke)
            end
        end)
        pcall(function()
            if hookfunction and originalUnreliableFire then
                hookfunction(unreliableEvent.FireServer, originalUnreliableFire)
            end
        end)
        pcall(function()
            if hookmetamethod and originalNamecall then
                hookmetamethod(game, "__namecall", originalNamecall)
            elseif hookfunction and originalNamecall then
                hookfunction(getrawmetatable(game).__namecall, originalNamecall)
            end
        end)
    end

    function M.ToggleSpy()
        spyActive = not spyActive
        if spyActive then
            if applyHooks() then
                if statusLbl then
                    statusLbl.Text = "Spy: ACTIVE"
                    statusLbl.TextColor3 = THEME.green
                end
                Notify("Solanix", "Spy capture enabled.", 3)
            else
                spyActive = false
            end
        else
            restoreHooks()
            if statusLbl then
                statusLbl.Text = "Spy: PAUSED"
                statusLbl.TextColor3 = THEME.red
            end
            Notify("Solanix", "Spy capture paused.", 3)
        end
    end

    function M.ClearLogs()
        for _, c in ipairs(logList:GetChildren()) do
            if not c:IsA("UIListLayout") then pcall(function() c:Destroy() end) end
        end
        logs = {}
        groups = {}
        selectedLogs = {}
        lastSelected = nil
        if codebox then codebox.Text = "" end
        if statusLbl then
            statusLbl.Text = "Logs cleared."
            statusLbl.TextColor3 = THEME.textMuted
        end
    end

    function M.StartSpam()
        if spamActive then return end
        if #selectedLogs == 0 then
            Notify("Solanix Spy", "Select remotes first.", 3)
            return
        end
        spamActive = true
        local captured = { table.unpack(selectedLogs) }
        Notify("Solanix", "Spamming " .. #captured .. " remote(s)...", 3)
        spamThread = Spawn(function()
            while spamActive do
                for _, log in ipairs(captured) do
                    pcall(function()
                        if log.remote and log.remote.Parent then
                            if log.remote:IsA("RemoteEvent") or log.remote:IsA("UnreliableRemoteEvent") then
                                log.remote:FireServer(table.unpack(log.args))
                            elseif log.remote:IsA("RemoteFunction") then
                                log.remote:InvokeServer(table.unpack(log.args))
                            end
                        end
                    end)
                end
                task_wait(0.1)
            end
        end)
    end

    function M.StopSpam()
        if not spamActive then return end
        spamActive = false
        Notify("Solanix", "Spam stopped.", 3)
    end

    function M.ApplyFilter(f)
        currentFilter = f
        for fullName, g in next, groups do
            local remote = g.remote
            local show = true
            if f == "RE" and remote and not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent")) then
                show = false
            elseif f == "RF" and remote and not remote:IsA("RemoteFunction") then
                show = false
            end
            g.frame.Visible = show
        end
    end

    function M.Build()
        page = SolanixHub.NewPage("RemoteSpy")

        -- Three-pane layout: left=list, right-top=code preview, right-bottom=actions
        local leftPane = Create("Frame", {
            Parent = page,
            BackgroundColor3 = THEME.bgPanel,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0.4, 0, 1, 0),
        })
        ApplySolanixSurface(leftPane)

        local rightPane = Create("Frame", {
            Parent = page,
            BackgroundColor3 = THEME.bgBase,
            BorderSizePixel = 0,
            Position = UDim2.new(0.4, 1, 0, 0),
            Size = UDim2.new(0.6, -1, 1, 0),
        })

        -- Filter bar (top of left pane)
        local filterBar = Create("Frame", {
            Parent = leftPane,
            BackgroundColor3 = THEME.bgSidebar,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 32),
        })
        Create("Frame", {
            Parent = filterBar,
            BackgroundColor3 = THEME.border,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 1, -1),
            Size = UDim2.new(1, 0, 0, 1),
        })
        local function makeFilterBtn(label, xOff, filter)
            local b = Create("TextButton", {
