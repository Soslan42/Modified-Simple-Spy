--=====================================================================

SolanixHub.modules.Explorer._instanceOps = {}

function SolanixHub.modules.Explorer._instanceOps.copyAttributes(src, dst)
    if not src or not dst then return end
    pcall(function()
        for k, v in pairs(src:GetAttributes()) do
            dst:SetAttribute(k, v)
        end
    end)
end

function SolanixHub.modules.Explorer._instanceOps.copyChildren(src, dst)
    if not src or not dst then return end
    pcall(function()
        for _, c in ipairs(src:GetChildren()) do
            local clone = c:Clone()
            clone.Parent = dst
        end
    end)
end

function SolanixHub.modules.Explorer._instanceOps.setPrimaryPart(model, part)
    if not model or not part then return end
    pcall(function()
        if model:IsA("Model") then
            model.PrimaryPart = part
        end
    end)
end

function SolanixHub.modules.Explorer._instanceOps.teleportModelTo(model, cframe)
    if not model or not cframe then return end
    pcall(function()
        if model:IsA("Model") and model.PrimaryPart then
            model:PivotTo(cframe)
        elseif model:IsA("BasePart") then
            model.CFrame = cframe
        end
    end)
end

