        if not M._resBody then return end
        for _, c in ipairs(M._resBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "ResRow" then
                pcall(function() c:Destroy() end)
            end
        end
        Label(M._resBody, "Found " .. #results .. " matching instances", { size = 11, color = THEME.textAccent })
        for i, v in ipairs(results) do
            if i > 100 then break end
            local row = Create("Frame", {
