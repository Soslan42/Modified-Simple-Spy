                "HipHeight", "MoveDirection", "WalkToPoint",
                "Text", "TextScaled", "TextWrapped", "TextSize", "TextColor3", "Font", "TextXAlignment", "TextYAlignment",
                "Image", "ImageColor3", "ImageRectOffset", "ImageRectSize", "ScaleType",
                "Visible", "Enabled", "Active",
                "BackgroundColor3", "BackgroundTransparency", "BorderSizePixel",
                "Position", "Size", "AnchorPoint", "Rotation", "ZIndex", "LayoutOrder",
                "Volume", "SoundId", "Playing", "Looped", "Pitch", "TimePosition",
                "Brightness", "ClockTime", "FogEnd", "FogStart", "GlobalShadows", "Ambient", "OutdoorAmbient",
                "FieldOfView", "CameraType", "CameraSubject", "HeadLocked", "HeadScale",
            }
            local seen = {}
            for _, p in ipairs(fallback) do
                local has = false
                pcall(function()
                    has = obj[p] ~= nil
                end)
                if has and not seen[p] then
                    table_insert(props, p)
                    seen[p] = true
                end
            end
        end
        table.sort(props)
        return props
    end

    local function makePropRow(parent, propName, propValue, obj)
        local row = Create("Frame", {
            Parent = parent,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 26),
        })
        Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
        local nameLbl = Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 0),
            Size = UDim2.new(0.4, 0, 1, 0),
            Font = THEME.font,
            Text = propName,
            TextColor3 = THEME.textSecondary,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        local valType = typeof(propValue)
        local valStr = ValueToString(propValue)
        -- Editable input
        local input
        if valType == "boolean" then
            input = Create("TextButton", {
                Parent = row,
                BackgroundColor3 = propValue and THEME.accent or THEME.bgActive,
                BorderSizePixel = 0,
                Position = UDim2.new(0.4, 0, 0.5, -10),
                Size = UDim2.new(0.6, -8, 0, 20),
                Font = THEME.fontBold,
                Text = propValue and "true" or "false",
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 11,
                AutoButtonColor = false,
            })
            Create("UICorner", { Parent = input, CornerRadius = THEME.radiusSm })
            Track(input.MouseButton1Click:Connect(function()
                pcall(function()
                    obj[propName] = not propValue
                    local newVal = obj[propName]
                    input.Text = newVal and "true" or "false"
                    input.BackgroundColor3 = newVal and THEME.accent or THEME.bgActive
                end)
            end))
        else
            input = Create("TextBox", {
                Parent = row,
                BackgroundColor3 = THEME.bgEditor,
                BorderSizePixel = 0,
                Position = UDim2.new(0.4, 0, 0.5, -10),
                Size = UDim2.new(0.6, -8, 0, 20),
                Font = THEME.fontMono,
                Text = valStr,
                TextColor3 = THEME.textPrimary,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
            })
            Create("UICorner", { Parent = input, CornerRadius = THEME.radiusSm })
            Track(input.FocusLost:Connect(function()
                local txt = input.Text
                pcall(function()
                    if valType == "number" then
                        obj[propName] = tonumber(txt) or propValue
                    elseif valType == "string" then
                        obj[propName] = txt
                    elseif valType == "boolean" then
                        obj[propName] = txt:lower() == "true"
                    elseif valType == "Vector3" then
                        local parts = txt:gsub("[() ]", ""):split(",")
                        if #parts >= 3 then
                            obj[propName] = Vector3.new(tonumber(parts[1]) or 0, tonumber(parts[2]) or 0, tonumber(parts[3]) or 0)
                        end
                    elseif valType == "Color3" then
                        local parts = txt:gsub("[() ]", ""):split(",")
                        if #parts >= 3 then
                            obj[propName] = Color3.fromRGB(tonumber(parts[1]) or 0, tonumber(parts[2]) or 0, tonumber(parts[3]) or 0)
                        end
                    elseif valType == "UDim2" then
                        local parts = txt:gsub("[{}() ]", ""):split(",")
                        if #parts >= 4 then
                            obj[propName] = UDim2.new(tonumber(parts[1]) or 0, tonumber(parts[2]) or 0, tonumber(parts[3]) or 0, tonumber(parts[4]) or 0)
                        end
                    elseif valType == "EnumItem" then
                        -- Try to parse Enum.X.Y
                        local enum, val = txt:match("Enum%.(.-)%.(.+)")
                        if enum and val then
                            obj[propName] = Enum[enum][val]
                        end
                    end
                end)
                -- Refresh the displayed value
                local ok, nv = pcall(function() return obj[propName] end)
                if ok then input.Text = ValueToString(nv) end
            end))
        end
        return row
    end

    function populateProperties(obj)
        for _, c in ipairs(propsList:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
                pcall(function() c:Destroy() end)
            end
        end
        if not obj then return end
        local props = getProperties(obj)
        -- Header row with class + name
        local hdr = Create("Frame", {
            Parent = propsList,
            BackgroundColor3 = THEME.bgSidebar,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 32),
        })
        Create("UICorner", { Parent = hdr, CornerRadius = THEME.radiusSm })
        Create("TextLabel", {
            Parent = hdr,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 0),
            Size = UDim2.new(1, -16, 1, 0),
            Font = THEME.fontBold,
            Text = obj.Name .. "  [" .. obj.ClassName .. "]",
            TextColor3 = THEME.textAccent,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        for _, propName in ipairs(props) do
            local ok, val = pcall(function() return obj[propName] end)
            if ok and val ~= nil then
                makePropRow(propsList, propName, val, obj)
            end
        end
    end

