SolanixHub.modules.AttributeManager = {}
do
    local M = SolanixHub.modules.AttributeManager
    function M.Build()
        local page = SolanixHub.NewPage("AttributeManager")
        local scroll = Scroller(page)

        local addCard, addBody = Section(scroll, "Add Attribute")
        local _, objPath = TextBox(addBody, "Instance path", "game.Workspace.Part", "", function() end)
        local _, attrName = TextBox(addBody, "Attribute name", "MyAttr", "", function() end)
        local _, attrVal = TextBox(addBody, "Attribute value (string/number/bool)", "hello", "", function() end)
        Button(addBody, "Add/Set Attribute", function()
            local path = objPath.Text
            local name = attrName.Text
            local val = attrVal.Text
            if path == "" or name == "" then
                Notify("Solanix", "Path and name required.", 3)
                return
            end
            local fn, err = loadstring("return " .. path)
            if not fn then Notify("Solanix", "Invalid path.", 3) return end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or typeof(obj) ~= "Instance" then
                Notify("Solanix", "Instance not found.", 3)
                return
            end
            -- Try to parse value
            local parsed
            if val:lower() == "true" then parsed = true
            elseif val:lower() == "false" then parsed = false
            elseif tonumber(val) then parsed = tonumber(val)
            else parsed = val end
            obj:SetAttribute(name, parsed)
            Notify("Solanix", "Attribute set: " .. name .. " = " .. tostring(parsed), 3)
        end)

        local viewCard, viewBody = Section(scroll, "View Attributes")
        local _, viewPath = TextBox(viewCard, "Instance path to inspect", "game.Workspace", "", function() end)
        Button(viewBody, "Show Attributes", function()
            for _, c in ipairs(viewBody:GetChildren()) do
                if c:IsA("Frame") and c.Name == "AttrRow" then
                    pcall(function() c:Destroy() end)
                end
            end
            local fn = loadstring("return " .. viewPath.Text)
            if not fn then return end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or typeof(obj) ~= "Instance" then
                Notify("Solanix", "Instance not found.", 3)
                return
            end
            local attrs = obj:GetAttributes()
            if next(attrs) == nil then
                Label(viewBody, "No attributes set.", { size = 11, color = THEME.textMuted })
                return
            end
            for name, value in pairs(attrs) do
                local row = Create("Frame", {
                    Parent = viewBody,
                    Name = "AttrRow",
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 10, 0, 0),
                    Size = UDim2.new(0.4, 0, 1, 0),
                    Font = THEME.font,
