local function createSettingElement(parent, settingName, settingType, options)
    local element = Create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -10, 0, 30),
        LayoutOrder = #parent:GetChildren(),
        ZIndex = 101
    })
    
    local label = Create("TextLabel", {
        Parent = element,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0.4, 0, 1, 0),
        Font = Enum.Font.SourceSans,
        Text = t(settingName),
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102
    })
    
    local control
    local currentValue = tempSettings[settingName]
    
    if settingType == "toggle" then
        control = Create("TextButton", {
            Parent = element,
            BackgroundColor3 = currentValue and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(180, 60, 60),
            BorderSizePixel = 0,
            Position = UDim2.new(0.4, 5, 0, 5),
            Size = UDim2.new(0.2, 0, 0, 20),
            Font = Enum.Font.SourceSans,
            Text = currentValue and "ON" or "OFF",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12,
            ZIndex = 102
        })
        
        control.MouseButton1Click:Connect(function()
            tempSettings[settingName] = not tempSettings[settingName]
            control.BackgroundColor3 = tempSettings[settingName] and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(180, 60, 60)
            control.Text = tempSettings[settingName] and "ON" or "OFF"
        end)
        
    elseif settingType == "dropdown" then
        control = Create("TextButton", {
            Parent = element,
            BackgroundColor3 = Color3.fromRGB(70, 70, 70),
            BorderSizePixel = 0,
            Position = UDim2.new(0.4, 5, 0, 5),
            Size = UDim2.new(0.3, 0, 0, 20),
            Font = Enum.Font.SourceSans,
            Text = tostring(currentValue),
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12,
            ZIndex = 102
        })
        
        control.MouseButton1Click:Connect(function()
            local optionsFrame = Create("Frame", {
                Parent = SettingsWindow,
                BackgroundColor3 = Color3.fromRGB(50, 50, 50),
                BorderSizePixel = 1,
                BorderColor3 = Color3.fromRGB(80, 80, 80),
                Position = UDim2.new(0, control.AbsolutePosition.X - SettingsWindow.AbsolutePosition.X, 
                                     0, control.AbsolutePosition.Y - SettingsWindow.AbsolutePosition.Y + control.AbsoluteSize.Y),
                Size = UDim2.new(0, control.AbsoluteSize.X, 0, #options * 25),
                ZIndex = 110,
                Visible = true
            })
            
            for i, option in ipairs(options) do
                local optionButton = Create("TextButton", {
                    Parent = optionsFrame,
                    BackgroundColor3 = currentValue == option and Color3.fromRGB(80, 120, 200) or Color3.fromRGB(70, 70, 70),
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 0, (i-1)*25),
                    Size = UDim2.new(1, 0, 0, 25),
                    Font = Enum.Font.SourceSans,
                    Text = option,
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 12,
                    ZIndex = 111
                })
                
                optionButton.MouseButton1Click:Connect(function()
                    tempSettings[settingName] = option
                    control.Text = option
                    optionsFrame:Destroy()
                    updateInterfaceTexts()
                end)
            end
            
            local connection
            connection = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mousePos = UserInputService:GetMouseLocation()
                    local framePos = optionsFrame.AbsolutePosition
                    local frameSize = optionsFrame.AbsoluteSize
                    
                    if mousePos.X < framePos.X or mousePos.X > framePos.X + frameSize.X or
                       mousePos.Y < framePos.Y or mousePos.Y > framePos.Y + frameSize.Y then
                        optionsFrame:Destroy()
                        if connection then
                            connection:Disconnect()
                        end
                    end
                end
            end)
        end)
        
    elseif settingType == "slider" then
        control = Create("Frame", {
            Parent = element,
            BackgroundColor3 = Color3.fromRGB(70, 70, 70),
            BorderSizePixel = 0,
            Position = UDim2.new(0.4, 5, 0, 5),
            Size = UDim2.new(0.3, 0, 0, 20),
            ZIndex = 102
        })
        
        local sliderFill = Create("Frame", {
            Parent = control,
            BackgroundColor3 = Color3.fromRGB(92, 126, 229),
            BorderSizePixel = 0,
            Size = UDim2.new(currentValue / (options.max or 100), 0, 1, 0),
            ZIndex = 103
        })
        
        local valueLabel = Create("TextLabel", {
            Parent = control,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.SourceSans,
            Text = tostring(currentValue),
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12,
            ZIndex = 104
        })
        
        control.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                local connection
                connection = RunService.RenderStepped:Connect(function()
                    local mousePos = UserInputService:GetMouseLocation()
                    local relativeX = (mousePos.X - control.AbsolutePosition.X) / control.AbsoluteSize.X
                    relativeX = math.clamp(relativeX, 0, 1)
                    
                    local min = options.min or 0
                    local max = options.max or 100
                    local step = options.step or 1
                    
                    local value = min + math.floor((relativeX * (max - min)) / step) * step
                    value = math.clamp(value, min, max)
                    
                    tempSettings[settingName] = value
                    sliderFill.Size = UDim2.new(value / max, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                end)
                
                local endConnection
                endConnection = UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        connection:Disconnect()
                        if endConnection then
                            endConnection:Disconnect()
                        end
                    end
                end)
            end
        end)
        
    elseif settingType == "text" then
        control = Create("TextBox", {
            Parent = element,
            BackgroundColor3 = Color3.fromRGB(70, 70, 70),
            BorderSizePixel = 0,
            Position = UDim2.new(0.4, 5, 0, 5),
            Size = UDim2.new(0.3, 0, 0, 20),
            Font = Enum.Font.SourceSans,
            Text = tostring(currentValue),
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12,
            ZIndex = 102
        })
        
        control.FocusLost:Connect(function()
            tempSettings[settingName] = control.Text
        end)
        
    elseif settingType == "color" then
        control = Create("TextButton", {
            Parent = element,
            BackgroundColor3 = currentValue,
            BorderSizePixel = 0,
            Position = UDim2.new(0.4, 5, 0, 5),
            Size = UDim2.new(0.1, 0, 0, 20),
            Text = "",
            ZIndex = 102
        })
        
        local colorLabel = Create("TextLabel", {
            Parent = element,
            BackgroundTransparency = 1,
            Position = UDim2.new(0.52, 5, 0, 5),
            Size = UDim2.new(0.2, 0, 0, 20),
            Font = Enum.Font.SourceSans,
            Text = string.format("R:%d G:%d B:%d", 
                math.floor(currentValue.R * 255),
                math.floor(currentValue.G * 255),
                math.floor(currentValue.B * 255)),
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12,
            ZIndex = 102
        })
        
        control.MouseButton1Click:Connect(function()
            local colorFrame = Create("Frame", {
                Parent = SettingsWindow,
                BackgroundColor3 = Color3.fromRGB(50, 50, 50),
                BorderSizePixel = 1,
                BorderColor3 = Color3.fromRGB(80, 80, 80),
                Position = UDim2.new(0, control.AbsolutePosition.X - SettingsWindow.AbsolutePosition.X, 
                                     0, control.AbsolutePosition.Y - SettingsWindow.AbsolutePosition.Y + control.AbsoluteSize.Y),
                Size = UDim2.new(0, 200, 0, 100),
                ZIndex = 110,
                Visible = true
            })
            
            local rBox = Create("TextBox", {
                Parent = colorFrame,
                BackgroundColor3 = Color3.fromRGB(70, 70, 70),
                BorderSizePixel = 0,
                Position = UDim2.new(0, 5, 0, 5),
                Size = UDim2.new(0.3, -5, 0, 25),
                Font = Enum.Font.SourceSans,
                Text = "R: " .. math.floor(currentValue.R * 255),
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 12,
                ZIndex = 111
            })
            
            local gBox = Create("TextBox", {
                Parent = colorFrame,
                BackgroundColor3 = Color3.fromRGB(70, 70, 70),
                BorderSizePixel = 0,
                Position = UDim2.new(0.33, 5, 0, 5),
                Size = UDim2.new(0.3, -5, 0, 25),
                Font = Enum.Font.SourceSans,
                Text = "G: " .. math.floor(currentValue.G * 255),
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 12,
                ZIndex = 111
            })
            
            local bBox = Create("TextBox", {
                Parent = colorFrame,
                BackgroundColor3 = Color3.fromRGB(70, 70, 70),
                BorderSizePixel = 0,
                Position = UDim2.new(0.66, 5, 0, 5),
                Size = UDim2.new(0.3, -5, 0, 25),
                Font = Enum.Font.SourceSans,
                Text = "B: " .. math.floor(currentValue.B * 255),
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 12,
                ZIndex = 111
            })
            
            local applyColor = Create("TextButton", {
                Parent = colorFrame,
                BackgroundColor3 = Color3.fromRGB(60, 180, 80),
                BorderSizePixel = 0,
                Position = UDim2.new(0, 5, 0, 35),
                Size = UDim2.new(1, -10, 0, 25),
                Font = Enum.Font.SourceSans,
                Text = "Apply",
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 12,
                ZIndex = 111
            })
            
            local function updateColor()
                local r = tonumber(rBox.Text:match("%d+")) or 0
                local g = tonumber(gBox.Text:match("%d+")) or 0
                local b = tonumber(bBox.Text:match("%d+")) or 0
                
                r = math.clamp(r, 0, 255)
                g = math.clamp(g, 0, 255)
                b = math.clamp(b, 0, 255)
                
                local newColor = Color3.fromRGB(r, g, b)
                control.BackgroundColor3 = newColor
                colorLabel.Text = string.format("R:%d G:%d B:%d", r, g, b)
            end
            
            rBox.FocusLost:Connect(updateColor)
            gBox.FocusLost:Connect(updateColor)
            bBox.FocusLost:Connect(updateColor)
            
            applyColor.MouseButton1Click:Connect(function()
                local r = tonumber(rBox.Text:match("%d+")) or 0
                local g = tonumber(gBox.Text:match("%d+")) or 0
                local b = tonumber(bBox.Text:match("%d+")) or 0
                
                r = math.clamp(r, 0, 255)
                g = math.clamp(g, 0, 255)
                b = math.clamp(b, 0, 255)
                
                tempSettings[settingName] = Color3.fromRGB(r, g, b)
                control.BackgroundColor3 = tempSettings[settingName]
                colorLabel.Text = string.format("R:%d G:%d B:%d", r, g, b)
                colorFrame:Destroy()
            end)
            
            local connection
            connection = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mousePos = UserInputService:GetMouseLocation()
                    local framePos = colorFrame.AbsolutePosition
                    local frameSize = colorFrame.AbsoluteSize
                    
                    if mousePos.X < framePos.X or mousePos.X > framePos.X + frameSize.X or
                       mousePos.Y < framePos.Y or mousePos.Y > framePos.Y + frameSize.Y then
                        colorFrame:Destroy()
                        if connection then
                            connection:Disconnect()
                        end
                    end
                end
            end)
        end)
    end
    
    local hint = Create("TextLabel", {
        Parent = element,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.7, 10, 0, 0),
        Size = UDim2.new(0.3, -10, 1, 0),
        Font = Enum.Font.SourceSans,
        Text = t(settingName .. "_desc") or "",
        TextColor3 = Color3.new(0.8, 0.8, 0.8),
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102
    })
    
    settingElements[settingName] = {element = element, control = control, label = label}
    return element
end

local function populateSettings()
