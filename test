--=====================================================================
-- EXTENDED EXPLORER: GET FULL PROPERTY LIST
--=====================================================================

function SolanixHub.modules.Explorer.GetFullPropertyList(obj)
    if not obj then return {} end
    local className = obj.ClassName
    -- Try the new API first
    local props = {}
    pcall(function()
        if obj.GetProperties then
            for _, p in ipairs(obj:GetProperties()) do
                table_insert(props, p.Name)
            end
        end
    end)
    -- Fall back to catalog
    if #props == 0 then
        local cat = SolanixHub._fullClassCatalog[className]
        if cat then
            for _, p in ipairs(cat) do
                table_insert(props, p)
            end
        end
    end
    -- Always include base Instance properties
    if not table_find(props, "Name") then table_insert(props, "Name") end
    if not table_find(props, "Parent") then table_insert(props, "Parent") end
    if not table_find(props, "ClassName") then table_insert(props, "ClassName") end
    if not table_find(props, "Archivable") then table_insert(props, "Archivable") end
    table.sort(props)
    return props
end

