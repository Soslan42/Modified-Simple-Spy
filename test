-- Lua keyword set
THEME.luaKeywords = {
    ["and"] = true, ["break"] = true, ["do"] = true, ["else"] = true,
    ["elseif"] = true, ["end"] = true, ["false"] = true, ["for"] = true,
    ["function"] = true, ["if"] = true, ["in"] = true, ["local"] = true,
    ["nil"] = true, ["not"] = true, ["or"] = true, ["repeat"] = true,
    ["return"] = true, ["then"] = true, ["true"] = true, ["until"] = true,
    ["while"] = true, ["continue"] = true,
}

-- Simple syntax highlighter: takes plain Lua source, returns a RichText
-- string with color tags.
local function highlightLua(source)
    if not source or source == "" then return "" end
    -- Escape XML special chars
    local function esc(s)
        return s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    end
    local out = {}
    local i = 1
    local len = #source
    while i <= len do
        local c = source:sub(i, i)
        -- Comments
        if c == "-" and source:sub(i + 1, i + 1) == "-" then
            -- Long comment?
            if source:sub(i + 2, i + 2) == "[" and source:sub(i + 3, i + 3) == "[" then
                local endPos = source:find("]]", i + 4, true)
                endPos = endPos and endPos + 1 or len
                local text = source:sub(i, endPos)
                table_insert(out, '<font color="#' .. string.format("%02x%02x%02x",
                    THEME.syntax.Comment.R * 255, THEME.syntax.Comment.G * 255, THEME.syntax.Comment.B * 255) .. '">' .. esc(text) .. '</font>')
                i = endPos + 1
            else
                local nlPos = source:find("\n", i, true)
                local endPos = nlPos and nlPos - 1 or len
                local text = source:sub(i, endPos)
                table_insert(out, '<font color="#555570">' .. esc(text) .. '</font>')
                i = endPos + 1
            end
        -- Strings
        elseif c == '"' or c == "'" then
            local quote = c
            local j = i + 1
            while j <= len do
                local ch = source:sub(j, j)
                if ch == "\\" then j = j + 2
                elseif ch == quote then break
                else j = j + 1 end
            end
            local text = source:sub(i, math.min(j, len))
            table_insert(out, '<font color="#86EFAC">' .. esc(text) .. '</font>')
            i = j + 1
        -- Numbers
        elseif c:match("[0-9]") then
            local j = i
            while j <= len and source:sub(j, j):match("[0-9%.xXa-fA-F]") do
                j = j + 1
            end
            local text = source:sub(i, j - 1)
            table_insert(out, '<font color="#FCA5A5">' .. text .. '</font>')
            i = j
        -- Identifiers / keywords
        elseif c:match("[%a_]") then
            local j = i
            while j <= len and source:sub(j, j):match("[%w_]") do
                j = j + 1
            end
            local word = source:sub(i, j - 1)
            if THEME.luaKeywords[word] then
                table_insert(out, '<font color="#F86D7D"><b>' .. word .. '</b></font>')
            elseif word:sub(1, 1):match("[A-Z]") then
                table_insert(out, '<font color="#84D6F7">' .. word .. '</font>')
            else
                table_insert(out, word)
            end
            i = j
        else
            table_insert(out, esc(c))
            i = i + 1
        end
    end
    return table.concat(out)
end
SolanixHub.HighlightLua = highlightLua

--=====================================================================
-- EXTENDED EXPLORER: SEARCH RESULTS PANEL
--=====================================================================
-- When the user searches, instead of just hiding rows, we also surface
-- a flat "search results" list showing every matching instance path.

SolanixHub.modules.Explorer._searchResults = {}
function SolanixHub.modules.Explorer.BuildSearchResults(query)
    local results = {}
    local function walk(obj)
        if not obj then return end
        local fullName = ""
        pcall(function() fullName = obj:GetFullName() end)
        if string_lower(fullName .. " " .. obj.ClassName):find(query, 1, true) then
            table_insert(results, obj)
        end
        pcall(function()
            for _, c in ipairs(obj:GetChildren()) do
                walk(c)
            end
        end)
    end
    pcall(function()
        for _, s in ipairs(game:GetChildren()) do
            walk(s)
        end
    end)
    SolanixHub.modules.Explorer._searchResults = results
    return results
end

