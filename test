SolanixHub.modules.GameStats = {}
do
    local M = SolanixHub.modules.GameStats
    function M.Build()
        local page = SolanixHub.NewPage("GameStats")
        local scroll = Scroller(page)

        local statsCard, statsBody = Section(scroll, "Game Statistics")
        local statLabels = {}
        local statKeys = {
            "Total Instances",
            "Total Parts",
            "Total Scripts",
            "Total Remotes",
            "Total Sounds",
            "Total Players",
            "Total GUIs",
            "Workspace Children",
            "Lighting Children",
            "ReplicatedStorage Children",
        }
        for _, key in ipairs(statKeys) do
            local row = SolanixHub.Widgets.KeyValueRow(statsBody, key, "...")
            statLabels[key] = row
        end

        -- Update loop
        Spawn(function()
            while SolanixGui.Parent do
                local counts = {
                    ["Total Instances"] = 0,
                    ["Total Parts"] = 0,
                    ["Total Scripts"] = 0,
                    ["Total Remotes"] = 0,
                    ["Total Sounds"] = 0,
                    ["Total Players"] = #Players:GetPlayers(),
                    ["Total GUIs"] = 0,
                    ["Workspace Children"] = #Workspace:GetChildren(),
                    ["Lighting Children"] = #Lighting:GetChildren(),
                    ["ReplicatedStorage Children"] = #ReplicatedStorage:GetChildren(),
                }
                pcall(function()
                    for _, v in ipairs(game:GetDescendants()) do
                        counts["Total Instances"] = counts["Total Instances"] + 1
                        if v:IsA("BasePart") then counts["Total Parts"] = counts["Total Parts"] + 1 end
                        if v:IsA("LocalScript") or v:IsA("ModuleScript") or v:IsA("Script") then
                            counts["Total Scripts"] = counts["Total Scripts"] + 1
                        end
                        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") or v:IsA("UnreliableRemoteEvent") then
                            counts["Total Remotes"] = counts["Total Remotes"] + 1
                        end
                        if v:IsA("Sound") then counts["Total Sounds"] = counts["Total Sounds"] + 1 end
                        if v:IsA("ScreenGui") then counts["Total GUIs"] = counts["Total GUIs"] + 1 end
                    end
                end)
                -- Update labels
                for _, key in ipairs(statKeys) do
                    local row = statLabels[key]
                    if row then
                        local valLbl = row:GetChildren()[#row:GetChildren()]
                        if valLbl and valLbl:IsA("TextLabel") then
                            valLbl.Text = tostring(counts[key])
                        end
                    end
                end
                task_wait(5)
            end
        end)
    end
end

