--=====================================================================
-- EXTENDED: EVENT SYSTEM
--=====================================================================
-- A simple publish/subscribe event bus for cross-module communication.

SolanixHub._events = {}
function SolanixHub.On(eventName, callback)
    if not SolanixHub._events[eventName] then
        SolanixHub._events[eventName] = {}
    end
    table_insert(SolanixHub._events[eventName], callback)
    return function()
        local idx = table_find(SolanixHub._events[eventName], callback)
        if idx then table_remove(SolanixHub._events[eventName], idx) end
    end
end

function SolanixHub.Emit(eventName, ...)
    local callbacks = SolanixHub._events[eventName]
    if not callbacks then return end
    for _, cb in ipairs(callbacks) do
        pcall(cb, ...)
    end
end

--=====================================================================
-- EXTENDED: ASYNC HELPERS
--=====================================================================

function SolanixHub.Async(fn, ...)
    local co = coroutine.create(fn)
    table_insert(SolanixHub._threads, co)
    local ok, err = coroutine.resume(co, ...)
    if not ok then
        warn("[Solanix] Async error: " .. tostring(err))
    end
    return co
end

function SolanixHub.Delay(seconds, fn)
    Spawn(function()
        task_wait(seconds)
        pcall(fn)
    end)
end

function SolanixHub.Repeat(interval, fn, count)
    count = count or math_huge
    Spawn(function()
        local i = 0
        while i < count and SolanixGui.Parent do
            pcall(fn)
            task_wait(interval)
            i = i + 1
        end
    end)
end

--=====================================================================
-- EXTENDED: SAFE HTTP
--=====================================================================

function SolanixHub.SafeHttpGet(url, timeout)
    timeout = timeout or 15
    if not request then
        return false, "request() not available"
    end
    local ok, response = pcall(function()
        return request({
            Url = url,
            Method = "GET",
            Timeout = timeout * 1000,
        })
    end)
    if not ok then
        return false, response
    end
    if response and response.StatusCode == 200 then
        return true, response.Body
    end
    return false, "HTTP " .. (response and response.StatusCode or "?")
end

function SolanixHub.SafeHttpPost(url, body, contentType)
    contentType = contentType or "application/json"
    if not request then
        return false, "request() not available"
    end
    local ok, response = pcall(function()
        return request({
            Url = url,
            Method = "POST",
            Body = body,
            Headers = { ["Content-Type"] = contentType },
        })
    end)
    if not ok then
        return false, response
    end
    if response and response.StatusCode == 200 then
        return true, response.Body
    end
    return false, "HTTP " .. (response and response.StatusCode or "?")
end

--=====================================================================
-- EXTENDED: STRING UTILITIES
--=====================================================================

SolanixHub._stringUtils = {}

function SolanixHub._stringUtils.split(str, sep)
    local parts = {}
    for part in str:gmatch("([^" .. sep .. "]+)") do
        table_insert(parts, part)
    end
    return parts
end

function SolanixHub._stringUtils.trim(str)
    return str:match("^%s*(.-)%s*$")
end

function SolanixHub._stringUtils.startsWith(str, prefix)
    return str:sub(1, #prefix) == prefix
end

function SolanixHub._stringUtils.endsWith(str, suffix)
    return str:sub(-#suffix) == suffix
end

function SolanixHub._stringUtils.contains(str, sub)
    return str:find(sub, 1, true) ~= nil
end

function SolanixHub._stringUtils.formatNumber(n)
    if n >= 1e9 then return string_format("%.2fB", n / 1e9)
    elseif n >= 1e6 then return string_format("%.2fM", n / 1e6)
    elseif n >= 1e3 then return string_format("%.2fK", n / 1e3)
    else return tostring(n) end
end

function SolanixHub._stringUtils.formatTime(seconds)
    if seconds < 60 then return string_format("%ds", seconds)
    elseif seconds < 3600 then return string_format("%dm %ds", math_floor(seconds / 60), seconds % 60)
    elseif seconds < 86400 then return string_format("%dh %dm", math_floor(seconds / 3600), (seconds % 3600) / 60)
    else return string_format("%dd %dh", math_floor(seconds / 86400), (seconds % 86400) / 3600) end
end

--=====================================================================
-- EXTENDED: TABLE UTILITIES
--=====================================================================

SolanixHub._tableUtils = {}

function SolanixHub._tableUtils.deepCopy(t, copies)
    copies = copies or {}
    if type(t) ~= "table" then return t end
    if copies[t] then return copies[t] end
    local copy = {}
    copies[t] = copy
    for k, v in next, t do
        copy[SolanixHub._tableUtils.deepCopy(k, copies)] = SolanixHub._tableUtils.deepCopy(v, copies)
    end
    return copy
end

function SolanixHub._tableUtils.shallowCopy(t)
    local copy = {}
    for k, v in next, t do copy[k] = v end
    return copy
end

function SolanixHub._tableUtils.merge(a, b)
    local result = SolanixHub._tableUtils.shallowCopy(a)
    for k, v in next, b do result[k] = v end
    return result
end

function SolanixHub._tableUtils.keys(t)
    local keys = {}
    for k, _ in next, t do table_insert(keys, k) end
    return keys
end

function SolanixHub._tableUtils.values(t)
    local vals = {}
    for _, v in next, t do table_insert(vals, v) end
    return vals
end

function SolanixHub._tableUtils.size(t)
    local count = 0
    for _ in next, t do count = count + 1 end
    return count
end

function SolanixHub._tableUtils.indexOf(t, value)
    for i, v in ipairs(t) do
        if v == value then return i end
    end
    return nil
end

function SolanixHub._tableUtils.removeValue(t, value)
    local idx = SolanixHub._tableUtils.indexOf(t, value)
    if idx then table_remove(t, idx) end
    return idx ~= nil
end

function SolanixHub._tableUtils.filter(t, predicate)
    local result = {}
    for _, v in ipairs(t) do
        if predicate(v) then
            table_insert(result, v)
        end
    end
    return result
end

function SolanixHub._tableUtils.map(t, fn)
    local result = {}
    for i, v in ipairs(t) do
        result[i] = fn(v, i)
    end
    return result
end

function SolanixHub._tableUtils.reduce(t, fn, initial)
    local acc = initial
    for _, v in ipairs(t) do
        acc = fn(acc, v)
    end
    return acc
end

function SolanixHub._tableUtils.forEach(t, fn)
    for k, v in next, t do fn(v, k) end
end

function SolanixHub._tableUtils.find(t, predicate)
    for _, v in ipairs(t) do
        if predicate(v) then return v end
    end
    return nil
end

function SolanixHub._tableUtils.sort(t, comparator)
    table.sort(t, comparator)
    return t
end

function SolanixHub._tableUtils.reverse(t)
    local result = {}
    for i = #t, 1, -1 do
        table_insert(result, t[i])
    end
    return result
end

function SolanixHub._tableUtils.unique(t)
    local seen = {}
    local result = {}
    for _, v in ipairs(t) do
        if not seen[v] then
            seen[v] = true
            table_insert(result, v)
        end
    end
    return result
end

function SolanixHub._tableUtils.flatten(t)
    local result = {}
    for _, v in ipairs(t) do
        if type(v) == "table" then
            for _, sub in ipairs(v) do
                table_insert(result, sub)
            end
        else
            table_insert(result, v)
        end
    end
    return result
end

function SolanixHub._tableUtils.chunk(t, size)
    local chunks = {}
    for i = 1, #t, size do
        local chunk = {}
        for j = i, math.min(i + size - 1, #t) do
            table_insert(chunk, t[j])
        end
        table_insert(chunks, chunk)
    end
    return chunks
end

