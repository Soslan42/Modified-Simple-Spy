    function M.Build()
        local page = SolanixHub.NewPage("AudioRecorder")
        local scroll = Scroller(page)

        local recCard, recBody = Section(scroll, "Recorder")
        Button(recBody, recording and "Stop Recording" or "Start Recording", function(btn)
            recording = not recording
            btn.Text = recording and "Stop Recording" or "Start Recording"
            if recording then
                recorded = {}
                Notify("Solanix", "Recording started.", 3)
            else
                Notify("Solanix", "Recorded " .. #recorded .. " audio events.", 3)
            end
        end)
        Button(recBody, "Clear Records", function()
            recorded = {}
            Notify("Solanix", "Records cleared.", 3)
        end)

        local listCard, listBody = Section(scroll, "Recorded Events")
        local list = Create("ScrollingFrame", {
            Parent = listBody,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 200),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = THEME.scrollBarSize,
        })
        Create("UIListLayout", {
            Parent = list,
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })
        Button(listBody, "Refresh List", function()
            for _, c in ipairs(list:GetChildren()) do
                if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
                    pcall(function() c:Destroy() end)
                end
            end
            for i, evt in ipairs(recorded) do
                local row = Create("Frame", {
                    Parent = list,
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 0),
                    Size = UDim2.new(1, -16, 1, 0),
                    Font = THEME.fontMono,
                    Text = string_format("#%d %s %s", i, evt.action, evt.soundId),
                    TextColor3 = THEME.textPrimary,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
        end)

        -- Hook all sound events
        Spawn(function()
            while SolanixGui.Parent do
                if recording then
                    pcall(function()
                        for _, v in ipairs(game:GetDescendants()) do
                            if v:IsA("Sound") and not v:GetAttribute("SolanixHooked") then
                                v:SetAttribute("SolanixHooked", true)
                                Track(v.Played:Connect(function()
                                    if recording then
                                        table_insert(recorded, { action = "PLAY", soundId = v.SoundId, name = v.Name })
                                    end
                                end))
                                Track(v.Stopped:Connect(function()
                                    if recording then
                                        table_insert(recorded, { action = "STOP", soundId = v.SoundId, name = v.Name })
                                    end
                                end))
                            end
                        end
                    end)
                end
                task_wait(1)
            end
        end)
    end
end

