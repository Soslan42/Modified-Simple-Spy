    local value = math_clamp(default or min, min, max)
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 38),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    local lbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 4),
        Size = UDim2.new(1, -20, 0, 14),
        Font = THEME.font,
        Text = label or "",
        TextColor3 = THEME.textPrimary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -50, 0, 4),
        Size = UDim2.new(0, 40, 0, 14),
        Font = THEME.fontMono,
        Text = string_format("%." .. decimals .. "f", value),
        TextColor3 = THEME.textAccent,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    local track = Create("Frame", {
        Parent = row,
        BackgroundColor3 = THEME.bgActive,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 10, 0, 24),
        Size = UDim2.new(1, -20, 0, 6),
    })
    Create("UICorner", { Parent = track, CornerRadius = UDim.new(1, 0) })
    local fill = Create("Frame", {
        Parent = track,
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
    })
    Create("UICorner", { Parent = fill, CornerRadius = UDim.new(1, 0) })
    local knob = Create("Frame", {
        Parent = track,
        BackgroundColor3 = THEME.textPrimary,
        BorderSizePixel = 0,
        Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6),
        Size = UDim2.new(0, 12, 0, 12),
    })
    Create("UICorner", { Parent = knob, CornerRadius = UDim.new(1, 0) })
    local dragging = false
    local function updateFromMouse(x)
        local rel = x - track.AbsolutePosition.X
        local pct = math_clamp(rel / track.AbsoluteSize.X, 0, 1)
        local newV = min + (max - min) * pct
        if decimals == 0 then
            newV = math_floor(newV + 0.5)
        else
            local mult = 10 ^ decimals
            newV = math_floor(newV * mult + 0.5) / mult
        end
        value = newV
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -6, 0.5, -6)
        valLbl.Text = string_format("%." .. decimals .. "f", value)
        if callback then pcall(callback, value) end
    end
    Track(track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromMouse(input.Position.X)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end))
    Track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                      or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromMouse(input.Position.X)
        end
    end))
    return row, function() return value end, function(v)
        value = math_clamp(v, min, max)
        local pct = (value - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -6, 0.5, -6)
        valLbl.Text = string_format("%." .. decimals .. "f", value)
        if callback then pcall(callback, value) end
    end
end
