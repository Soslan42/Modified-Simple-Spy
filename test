function SolanixHub._tests.testAll()
    local tests = {}
    for name, fn in pairs(SolanixHub._tests) do
        if name ~= "testAll" then
            local ok, result = pcall(fn)
            table_insert(tests, { name = name, passed = ok and result, error = not ok and result or (not result and "returned false" or nil) })
        end
    end
    print("=== Solanix Hub Test Results ===")
    for _, t in ipairs(tests) do
        local status = t.passed and "✓ PASS" or "✕ FAIL"
        print(string_format("%s  %s%s", status, t.name, t.error and (" (" .. tostring(t.error) .. ")") or ""))
    end
    local passedCount = 0
    for _, t in ipairs(tests) do
        if t.passed then passedCount = passedCount + 1 end
    end
    print(string_format("\n%d/%d tests passed", passedCount, #tests))
    return passedCount == #tests
end

