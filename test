SolanixHub.modules.ThemePresets = {}
do
    local M = SolanixHub.modules.ThemePresets
    function M.Build()
        local page = SolanixHub.NewPage("ThemePresets")
        local scroll = Scroller(page)

        local intro, introBody = Section(scroll, "Theme Presets")
        Label(introBody, "Click any preset to apply it. New UI elements will use the new colors.", { size = 11 })

        local presetCard, presetBody = Section(scroll, "Available Presets")
        local presetOrder = {"default", "midnight", "rose", "forest", "sunset"}
        for _, name in ipairs(presetOrder) do
            local preset = SolanixHub._themePresets[name]
            if preset then
                local row = Create("Frame", {
                    Parent = presetBody,
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 32),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                -- Show 5 color swatches for the preset
                local swatches = {preset.accent, preset.cyan, preset.bgPanel, preset.bgElevated, preset.green}
                for i, color in ipairs(swatches) do
                    Create("Frame", {
                        Parent = row,
                        BackgroundColor3 = color,
                        BorderSizePixel = 0,
                        Position = UDim2.new(0, 10 + (i - 1) * 18, 0.5, -8),
                        Size = UDim2.new(0, 14, 0, 16),
                    })
                    Create("UICorner", { Parent = row:GetChildren()[#row:GetChildren()], CornerRadius = THEME.radiusSm })
                end
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 110, 0, 0),
                    Size = UDim2.new(0.5, 0, 1, 0),
                    Font = THEME.fontBold,
                    Text = name,
                    TextColor3 = THEME.textPrimary,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                local applyBtn = Create("TextButton", {
                    Parent = row,
                    BackgroundColor3 = THEME.accent,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -80, 0.5, -10),
                    Size = UDim2.new(0, 70, 0, 20),
                    Font = THEME.font,
                    Text = "Apply",
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 11,
                    AutoButtonColor = false,
                })
                Create("UICorner", { Parent = applyBtn, CornerRadius = THEME.radiusSm })
                ApplyHover(applyBtn, THEME.accentDim, THEME.accent)
                Track(applyBtn.MouseButton1Click:Connect(function()
                    SolanixHub.ApplyThemePreset(name)
                    Notify("Solanix", "Theme preset applied: " .. name, 3)
                end))
            end
        end
    end
end

