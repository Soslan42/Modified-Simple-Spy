-- VISUALS MODULE — ESP, Tracers, Fullbright, Name tags, Crosshair
--=====================================================================

SolanixHub.modules.Visuals = {}
do
    local M = SolanixHub.modules.Visuals
    local espEnabled = false
    local tracerEnabled = false
    local nameTagsEnabled = false
    local fullbrightEnabled = false
    local crosshairEnabled = false
    local espFolder
    local crosshairGui
    local espConns = {}
    local espObjects = {}
    local originalLighting = {}

    local function getEspFolder()
        if not espFolder or not espFolder.Parent then
            espFolder = Create("Folder", { Name = "SolanixESP" })
            pcall(function() espFolder.Parent = Workspace end)
            TrackInstance(espFolder)
        end
        return espFolder
    end

    local function createEspForPlayer(player)
        if player == LocalPlayer then return end
        local function apply(char)
            if not char then return end
            -- Remove old instance if exists
            if espObjects[player] then
                pcall(function() espObjects[player]:Destroy() end)
            end
            local obj = {}
            -- Highlight outline
            obj.highlight = Create("Highlight", {
                Parent = getEspFolder(),
                Adornee = char,
                FillTransparency = 0.6,
                FillColor = THEME.accent,
                OutlineColor = Color3.new(1, 1, 1),
                OutlineTransparency = 0,
                DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
                Enabled = espEnabled,
            })
            obj.highlight.Name = player.Name .. "_HL"
            -- Billboard with name + distance
            obj.bill = Create("BillboardGui", {
                Parent = getEspFolder(),
                Adornee = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char,
                Size = UDim2.new(0, 200, 0, 50),
                AlwaysOnTop = true,
                MaxDistance = 1500,
                Enabled = espEnabled,
            })
            obj.nameLbl = Create("TextLabel", {
                Parent = obj.bill,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 16),
                Font = THEME.fontBold,
                Text = player.DisplayName .. " (" .. player.Name .. ")",
                TextColor3 = THEME.textPrimary,
                TextStrokeColor3 = Color3.new(0, 0, 0),
                TextStrokeTransparency = 0,
                TextSize = 13,
                TextYAlignment = Enum.TextYAlignment.Top,
            })
            obj.distLbl = Create("TextLabel", {
                Parent = obj.bill,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 16),
                Size = UDim2.new(1, 0, 0, 14),
                Font = THEME.font,
                Text = "",
                TextColor3 = THEME.cyan,
                TextStrokeColor3 = Color3.new(0, 0, 0),
                TextStrokeTransparency = 0,
                TextSize = 11,
            })
            espObjects[player] = obj
        end
        if player.Character then apply(player.Character) end
        espConns[player] = Track(player.CharacterAdded:Connect(apply))
    end

    local function removeEspForPlayer(player)
        if espObjects[player] then
            pcall(function() espObjects[player].highlight:Destroy() end)
            pcall(function() espObjects[player].bill:Destroy() end)
            espObjects[player] = nil
        end
        if espConns[player] then
            espConns[player]:Disconnect()
            espConns[player] = nil
        end
    end

    function M.ToggleESP()
        espEnabled = not espEnabled
        if espEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                createEspForPlayer(p)
            end
            Track(Players.PlayerAdded:Connect(createEspForPlayer))
            Track(Players.PlayerRemoving:Connect(removeEspForPlayer))
            -- Distance updater
            Spawn(function()
                while espEnabled and SolanixGui.Parent do
                    for plr, obj in next, espObjects do
                        if obj.bill and obj.bill.Adornee and LocalPlayer.Character then
                            local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local theirRoot = obj.bill.Adornee
                            if myRoot and theirRoot and theirRoot:IsA("BasePart") then
                                local d = math_floor((myRoot.Position - theirRoot.Position).Magnitude)
                                if obj.distLbl then
                                    obj.distLbl.Text = d .. " studs"
                                end
                            end
                        end
                    end
                    task_wait(0.25)
                end
            end)
            Notify("Solanix", "ESP enabled.", 3)
        else
            for p, _ in next, espObjects do removeEspForPlayer(p) end
            Notify("Solanix", "ESP disabled.", 3)
        end
        SolanixHub._state.espEnabled = espEnabled
    end

    function M.ToggleTracers()
        tracerEnabled = not tracerEnabled
        if tracerEnabled then
            Spawn(function()
                while tracerEnabled and SolanixGui.Parent do
                    -- Wipe old tracers
                    if espFolder then
                        for _, c in ipairs(espFolder:GetChildren()) do
                            if c.Name:sub(-7) == "_TRACER" then pcall(function() c:Destroy() end) end
                        end
                    end
                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myRoot then
                        local viewSize = Camera.ViewportSize
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character then
                                local head = p.Character:FindFirstChild("Head")
                                if head then
                                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                                    if onScreen then
                                        local line = Create("Frame", {
                                            Parent = getEspFolder(),
                                            BackgroundColor3 = THEME.accent,
                                            BorderSizePixel = 0,
                                            Size = UDim2.new(0, 1, 0, 1),
                                            Position = UDim2.new(0, screenPos.X, 0, screenPos.Y),
                                            Visible = true,
                                            Name = p.Name .. "_TRACER",
                                        })
                                        -- Compute length and rotation towards bottom-center of screen
                                        local target = Vector2.new(viewSize.X / 2, viewSize.Y)
                                        local src = Vector2.new(screenPos.X, screenPos.Y)
                                        local delta = target - src
                                        local len = delta.Magnitude
                                        local angle = math.atan2(delta.Y, delta.X)
                                        line.Size = UDim2.new(0, len, 0, 1)
                                        line.Rotation = math.deg(angle)
                                        line.AnchorPoint = Vector2.new(0, 0.5)
                                    end
                                end
                            end
                        end
                    end
                    task_wait(0.1)
                end
                -- Cleanup on stop
                if espFolder then
                    for _, c in ipairs(espFolder:GetChildren()) do
                        if c.Name:sub(-7) == "_TRACER" then pcall(function() c:Destroy() end) end
                    end
                end
            end)
            Notify("Solanix", "Tracers enabled.", 3)
        else
            if espFolder then
                for _, c in ipairs(espFolder:GetChildren()) do
                    if c.Name:sub(-7) == "_TRACER" then pcall(function() c:Destroy() end) end
                end
            end
            Notify("Solanix", "Tracers disabled.", 3)
        end
    end

    function M.ToggleNameTags()
        nameTagsEnabled = not nameTagsEnabled
        -- Name tags piggyback on ESP billboards; just toggle visibility
        for _, obj in next, espObjects do
            if obj.nameLbl then obj.nameLbl.Visible = nameTagsEnabled end
        end
        Notify("Solanix", "Name tags " .. (nameTagsEnabled and "enabled" or "disabled") .. ".", 3)
    end

    function M.ToggleFullbright()
        fullbrightEnabled = not fullbrightEnabled
        if fullbrightEnabled then
            originalLighting.Brightness = Lighting.Brightness
            originalLighting.ClockTime = Lighting.ClockTime
            originalLighting.FogEnd = Lighting.FogEnd
            originalLighting.GlobalShadows = Lighting.GlobalShadows
            originalLighting.Ambient = Lighting.Ambient
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(178, 178, 178)
            Notify("Solanix", "Fullbright enabled.", 3)
        else
            if originalLighting.Brightness then Lighting.Brightness = originalLighting.Brightness end
            if originalLighting.ClockTime then Lighting.ClockTime = originalLighting.ClockTime end
            if originalLighting.FogEnd then Lighting.FogEnd = originalLighting.FogEnd end
            if originalLighting.GlobalShadows ~= nil then Lighting.GlobalShadows = originalLighting.GlobalShadows end
            if originalLighting.Ambient then Lighting.Ambient = originalLighting.Ambient end
