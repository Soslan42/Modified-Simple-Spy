-- MultiSelect: a list of items with checkboxes
function SolanixHub.Widgets.MultiSelect(parent, items, defaults, onChange)
    local container = Create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    Create("UIListLayout", {
        Parent = container,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    local selected = {}
    for _, d in ipairs(defaults or {}) do selected[d] = true end
    local rows = {}
    for i, item in ipairs(items or {}) do
        local row = Create("TextButton", {
            Parent = container,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 24),
            LayoutOrder = i,
            Text = "",
            AutoButtonColor = false,
        })
        Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
        local check = Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 0),
            Size = UDim2.new(0, 18, 1, 0),
            Font = THEME.fontBold,
            Text = selected[item.value] and "☑" or "☐",
            TextColor3 = selected[item.value] and THEME.green or THEME.textMuted,
            TextSize = 14,
        })
        local lbl = Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 30, 0, 0),
            Size = UDim2.new(1, -38, 1, 0),
            Font = THEME.font,
            Text = item.label or item.value,
            TextColor3 = THEME.textPrimary,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        rows[item.value] = { row = row, check = check, item = item }
        Track(row.MouseButton1Click:Connect(function()
            selected[item.value] = not selected[item.value]
            check.Text = selected[item.value] and "☑" or "☐"
            check.TextColor3 = selected[item.value] and THEME.green or THEME.textMuted
            if onChange then pcall(onChange, selected) end
        end))
    end
    return container, function()
        local result = {}
        for v, sel in pairs(selected) do
            if sel then table_insert(result, v) end
        end
        return result
    end
end

-- Toast: a simple auto-dismissing message at the bottom of the screen
function SolanixHub.Widgets.Toast(message, duration, color)
    duration = duration or 3
    color = color or THEME.textPrimary
    local toast = Create("TextLabel", {
        Parent = SolanixGui,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, -150, 1, -60),
        Size = UDim2.new(0, 300, 0, 32),
        Font = THEME.font,
        Text = message or "",
        TextColor3 = color,
        TextSize = 12,
        ZIndex = 200,
    })
    ApplySolanixSurface(toast)
    Create("UICorner", { Parent = toast, CornerRadius = THEME.radiusSm })
    TrackInstance(toast)
    -- Animate in
    toast.Position = UDim2.new(0.5, -150, 1, 20)
    Tween(toast, 0.25, { Position = UDim2.new(0.5, -150, 1, -60) })
    -- Auto-dismiss
    task_delay(duration, function()
        Tween(toast, 0.25, { Position = UDim2.new(0.5, -150, 1, 20) })
        task_wait(0.3)
        pcall(function() toast:Destroy() end)
    end)
end

-- Modal: a centered dialog with title, body, and footer buttons
