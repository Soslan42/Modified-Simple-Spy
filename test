-- Tooltip: a small popup that follows the cursor when hovering over a
-- target element. Simple hover-to-show implementation.
function SolanixHub.Widgets.Tooltip(target, text, delay)
    delay = delay or 0.3
    local tooltip = Create("TextLabel", {
        Parent = SolanixGui,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 200, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = THEME.font,
        Text = text or "",
        TextColor3 = THEME.textPrimary,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Visible = false,
        ZIndex = 100,
    })
    ApplySolanixSurface(tooltip)
    Create("UIPadding", {
        Parent = tooltip,
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
    })
    TrackInstance(tooltip)
    local showConn
    Track(target.MouseEnter:Connect(function()
        Spawn(function()
            task_wait(delay)
            if not target.Parent then return end
            local mouse = UserInputService:GetMouseLocation()
            tooltip.Position = UDim2.new(0, mouse.X + 14, 0, mouse.Y + 14)
            tooltip.Visible = true
        end)
    end))
    Track(target.MouseLeave:Connect(function()
        tooltip.Visible = false
    end))
    return tooltip
end

