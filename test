SolanixHub._mathUtils = {}

function SolanixHub._mathUtils.clamp(v, min, max)
    return math_clamp(v, min, max)
end

function SolanixHub._mathUtils.lerp(a, b, t)
    return a + (b - a) * t
end

function SolanixHub._mathUtils.lerpColor3(c1, c2, t)
    return Color3.new(
        SolanixHub._mathUtils.lerp(c1.R, c2.R, t),
        SolanixHub._mathUtils.lerp(c1.G, c2.G, t),
        SolanixHub._mathUtils.lerp(c1.B, c2.B, t)
    )
end

function SolanixHub._mathUtils.round(v, decimals)
    decimals = decimals or 0
    local mult = 10 ^ decimals
    return math_floor(v * mult + 0.5) / mult
end

function SolanixHub._mathUtils.map(v, inMin, inMax, outMin, outMax)
    return outMin + (outMax - outMin) * ((v - inMin) / (inMax - inMin))
end

function SolanixHub._mathUtils.randomFloat(min, max)
    return min + math.random() * (max - min)
end

function SolanixHub._mathUtils.randomChoice(...)
    local args = {...}
    return args[math.random(1, #args)]
end

function SolanixHub._mathUtils.uuid()
    local template = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"
    return string.gsub(template, "[xy]", function(c)
        local v = (c == "x") and math.random(0, 0xf) or math.random(8, 0xb)
        return string_format("%x", v)
    end)
end

function SolanixHub._mathUtils.percent(part, whole)
    if whole == 0 then return 0 end
    return (part / whole) * 100
end

