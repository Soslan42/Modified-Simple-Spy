--=====================================================================
-- EXTENDED: VECTOR UTILITIES
--=====================================================================

SolanixHub._vectorUtils = {}

function SolanixHub._vectorUtils.length(v)
    return v.Magnitude
end

function SolanixHub._vectorUtils.normalize(v)
    local mag = v.Magnitude
    if mag == 0 then return Vector3.zero end
    return v / mag
end

function SolanixHub._vectorUtils.dot(a, b)
    return a.X * b.X + a.Y * b.Y + a.Z * b.Z
end

function SolanixHub._vectorUtils.cross(a, b)
    return Vector3.new(
        a.Y * b.Z - a.Z * b.Y,
        a.Z * b.X - a.X * b.Z,
        a.X * b.Y - a.Y * b.X
    )
end

function SolanixHub._vectorUtils.distance(a, b)
    return (a - b).Magnitude
end

function SolanixHub._vectorUtils.angle(a, b)
    local dot = SolanixHub._vectorUtils.dot(a, b)
    local mags = a.Magnitude * b.Magnitude
    if mags == 0 then return 0 end
    return math.acos(math_clamp(dot / mags, -1, 1))
end

function SolanixHub._vectorUtils.lerp(a, b, t)
    return a:lerp(b, t)
end

function SolanixHub._vectorUtils.fromColor3(c)
    return Vector3.new(c.R, c.G, c.B)
end

function SolanixHub._vectorUtils.toColor3(v)
    return Color3.new(v.X, v.Y, v.Z)
end

