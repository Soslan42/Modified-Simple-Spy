            if v then
                M.Show()
            else
                M.Hide()
            end
        end)

        Slider(body, "Update Interval (seconds)", 0.1, 5, 1, 1, function(v)
            SolanixHub._state.debugInterval = v
        end)
        SolanixHub._state.debugInterval = 1

        Toggle(body, "Show Position", true, function(v)
            SolanixHub._state.debugShowPos = v
        end)
        SolanixHub._state.debugShowPos = true

        Toggle(body, "Show FPS", true, function(v)
            SolanixHub._state.debugShowFps = v
        end)
        SolanixHub._state.debugShowFps = true

        Toggle(body, "Show Ping", true, function(v)
            SolanixHub._state.debugShowPing = v
        end)
        SolanixHub._state.debugShowPing = true

        Toggle(body, "Show Player Count", true, function(v)
            SolanixHub._state.debugShowPlayers = v
        end)
        SolanixHub._state.debugShowPlayers = true
    end

    function M.Show()
        if overlay then return end
        overlay = Create("Frame", {
            Parent = SolanixGui,
            BackgroundColor3 = THEME.bgPanel,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 14, 1, -100),
            Size = UDim2.new(0, 220, 0, 80),
            ZIndex = 95,
        })
        TrackInstance(overlay)
        Create("UICorner", { Parent = overlay, CornerRadius = THEME.radiusSm })
        Create("UIPadding", {
            Parent = overlay,
            PaddingLeft = UDim.new(0, 8),
            PaddingTop = UDim.new(0, 6),
        })
        local lbl = Create("TextLabel", {
            Parent = overlay,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 1, -12),
            Font = THEME.fontMono,
            Text = "Loading...",
            TextColor3 = THEME.textAccent,
            TextSize = 10,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
        })

        Spawn(function()
            local fps = 0
            while overlay and overlay.Parent do
                local frameCount = 0
                local conn = RunService.RenderStepped:Connect(function()
                    frameCount += 1
                end)
                task_wait(SolanixHub._state.debugInterval or 1)
                if conn then conn:Disconnect() end
                fps = frameCount / (SolanixHub._state.debugInterval or 1)
                local parts = {}
                if SolanixHub._state.debugShowFps then
                    table_insert(parts, string_format("FPS: %d", math_floor(fps)))
                end
                if SolanixHub._state.debugShowPing then
                    local ping = 0
                    pcall(function()
                        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                    end)
                    table_insert(parts, string_format("Ping: %d ms", math_floor(ping)))
                end
                if SolanixHub._state.debugShowPos then
                    local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if r then
                        table_insert(parts, string_format("Pos: %.0f, %.0f, %.0f", r.Position.X, r.Position.Y, r.Position.Z))
                    end
                end
                if SolanixHub._state.debugShowPlayers then
                    table_insert(parts, "Players: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers)
                end
                lbl.Text = table.concat(parts, "\n")
            end
        end)
    end

    function M.Hide()
        if overlay then pcall(function() overlay:Destroy() end) overlay = nil end
    end
end

