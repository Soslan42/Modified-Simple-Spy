local function TabStrip(parent, tabs, onTab)
    local strip = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgPanel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 28),
    })
    Create("Frame", {
        Parent = strip,
        BackgroundColor3 = THEME.border,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -1),
        Size = UDim2.new(1, 0, 0, 1),
    })
    local layout = Create("UIListLayout", {
        Parent = strip,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })
    Create("UIPadding", {
        Parent = strip,
        PaddingLeft = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 3),
    })
    local buttons = {}
    for i, t in ipairs(tabs) do
        local b = Create("TextButton", {
            Parent = strip,
            BackgroundColor3 = (i == 1) and THEME.bgActive or THEME.bgPanel,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 100, 0, 22),
            Font = THEME.font,
            Text = t,
            TextColor3 = (i == 1) and THEME.textAccent or THEME.textSecondary,
            TextSize = 11,
            AutoButtonColor = false,
        })
        Create("UICorner", { Parent = b, CornerRadius = THEME.radiusSm })
        buttons[i] = b
        ApplyHover(b, THEME.bgHover, (i == 1) and THEME.bgActive or THEME.bgPanel)
        Track(b.MouseButton1Click:Connect(function()
            for j, bb in ipairs(buttons) do
                bb.BackgroundColor3 = (j == i) and THEME.bgActive or THEME.bgPanel
                bb.TextColor3 = (j == i) and THEME.textAccent or THEME.textSecondary
            end
            if onTab then onTab(i, t) end
        end))
    end
    return strip
end
SolanixHub.TabStrip = TabStrip

