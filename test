        })

        Button(body, "Test Match", function()
            local pattern = patternInput.Text
            local text = textInput.Text
            if pattern == "" or text == "" then return end
            local matches = {}
            for m in text:gmatch(pattern) do
                table_insert(matches, m)
            end
            if #matches == 0 then
                result.Text = "No matches found."
            else
                result.Text = "Matches (" .. #matches .. "):\n" .. table.concat(matches, "\n")
            end
