local SETTINGS_FILE = "SolanixHub/settings.json"

function SolanixHub.SaveSettings()
    if not writefile then return end
    if not isfolder("SolanixHub") then pcall(makefolder, "SolanixHub") end
    local data = {}
    for k, v in next, SolanixHub.settings do
        if typeof(v) == "EnumItem" then
            data[k] = tostring(v):match("KeyCode%.(.+)") or tostring(v)
        else
            data[k] = v
        end
    end
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode(data))
    end)
end

function SolanixHub.LoadSettings()
    if not isfile or not isfile(SETTINGS_FILE) then return end
    local raw = readfile(SETTINGS_FILE)
    if not raw then return end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok or type(data) ~= "table" then return end
    -- Restore KeyCode enums from string
    for k, v in next, data do
        if k:match("^hotkey_") and type(v) == "string" then
            data[k] = Enum.KeyCode[v] or Enum.KeyCode.RightShift
        end
    end
    SolanixHub.settings = data
end

