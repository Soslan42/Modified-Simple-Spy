end
SolanixHub._addNavItem = addNavItem

-- Switch the visible page.
function SolanixHub.Navigate(pageName)
    if currentPage == pageName then return end
    currentPage = pageName
    for name, frame in next, ContentPages do
        frame.Visible = (name == pageName)
    end
    for name, btn in next, SidebarButtons do
        local active = (name == pageName)
        local indicator = btn:GetChildren()[1]
        local lbl = btn:FindFirstChildOfClass("TextLabel", true)
        -- Toggle accent colors
        Tween(btn, 0.15, {
            BackgroundColor3 = active and THEME.accentSubtle or THEME.bgSidebar,
        })
        if indicator then indicator.Visible = active end
        for _, c in ipairs(btn:GetChildren()) do
            if c:IsA("TextLabel") then
                if c.Text ~= "" and c.Text ~= "●" then
                    Tween(c, 0.15, { TextColor3 = active and THEME.textAccent or THEME.textMuted })
                end
            end
        end
    end
    -- Trigger module on-show hook if defined
    local m = SolanixHub.modules[pageName]
    if m and m.OnShow then pcall(m.OnShow) end
end

-- Create a new page container (added to Content, hidden until navigated to).
function SolanixHub.NewPage(name)
    local page = Create("Frame", {
        Parent = Content,
        BackgroundColor3 = THEME.bgBase,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
    })
    ContentPages[name] = page
    return page
end

