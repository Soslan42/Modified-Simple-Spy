-- SpinnerOverlay: full-page spinner overlay shown during long operations
function SolanixHub.Widgets.SpinnerOverlay(message)
    local overlay = Create("Frame", {
        Parent = SolanixGui,
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 250,
    })
    TrackInstance(overlay)
    local spinner = Create("Frame", {
        Parent = overlay,
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, -16, 0.5, -16),
        Size = UDim2.new(0, 32, 0, 32),
    })
    Create("UICorner", { Parent = spinner, CornerRadius = UDim.new(1, 0) })
    Spawn(function()
        while spinner.Parent do
            Tween(spinner, 0.6, { Rotation = spinner.Rotation + 360 }):Play()
            task_wait(0.6)
        end
    end)
    local lbl = Create("TextLabel", {
        Parent = overlay,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, -100, 0.5, 30),
        Size = UDim2.new(0, 200, 0, 20),
        Font = THEME.font,
        Text = message or "Loading...",
        TextColor3 = THEME.textPrimary,
        TextSize = 12,
    })
    return overlay, function() pcall(function() overlay:Destroy() end) end
end

