do
    local M = SolanixHub.modules.ScriptHooker
    function M.Build()
        local page = SolanixHub.NewPage("ScriptHooker")
        local scroll = Scroller(page)
        local card, body = Section(scroll, "Script Hooker")
        Label(body, "Hook functions to intercept their calls.", { size = 11 })

        local _, pathInput = TextBox(body, "Function path (game.Workspace.foo)", "game.Workspace.foo", "", function() end)
        local _, codeInput = TextBox(body, "Code to run before original (use ... for args)", "print('called with:', ...)", "", function() end)

        Button(body, "Hook Function", function()
            if not hookfunction then
                Notify("Solanix", "hookfunction not available.", 3)
                return
            end
            local path = pathInput.Text
            local code = codeInput.Text
            if path == "" or code == "" then return end
            local fn = loadstring("return " .. path)
            if not fn then Notify("Solanix", "Invalid path.", 3) return end
            setfenv(fn, getfenv())
            local ok, original = pcall(fn)
            if not ok or type(original) ~= "function" then
                Notify("Solanix", "Function not found.", 3)
                return
            end
            local hookFn = loadstring(code)
            if not hookFn then Notify("Solanix", "Invalid code.", 3) return end
            setfenv(hookFn, getfenv())
            local wrapped = function(...)
                pcall(hookFn, ...)
                return original(...)
            end
            local ok2 = pcall(hookfunction, original, wrapped)
            if ok2 then
                Notify("Solanix", "Hook installed.", 3)
            else
                Notify("Solanix", "Hook failed.", 3)
            end
        end)

        Label(body, "Note: hooks are NOT tracked — they persist until the script is unloaded.", { size = 10, color = THEME.amber })
    end
end

