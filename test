do
    local M = SolanixHub.modules.HttpTester
    function M.Build()
        local page = SolanixHub.NewPage("HttpTester")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "HTTP Tester")
        Label(body, "Test HTTP requests from your executor.", { size = 11 })

        local _, urlInput = TextBox(body, "URL", "https://httpbin.org/get", "", function() end)
        local _, methodInput = TextBox(body, "Method (GET/POST)", "GET", "", function() end)
        local _, bodyInput = TextBox(body, "Body (for POST)", "", "", function() end)

        Button(body, "Send Request", function()
            if not request then
                Notify("Solanix", "request() not available.", 3)
                return
            end
            local url = urlInput.Text
            local method = methodInput.Text:upper()
            local body = bodyInput.Text
            if url == "" then return end
            Notify("Solanix", "Sending request...", 3)
            Spawn(function()
                local ok, response = pcall(function()
                    local opts = { Url = url, Method = method }
                    if method == "POST" and body ~= "" then
                        opts.Body = body
                        opts.Headers = { ["Content-Type"] = "application/json" }
                    end
                    return request(opts)
                end)
                if not ok or not response then
                    Notify("Solanix", "Request failed: " .. tostring(response), 5)
                    return
                end
                print("=== HTTP Response ===")
                print("Status:", response.StatusCode)
                print("Headers:")
                if response.Headers then
                    for k, v in pairs(response.Headers) do
                        print("  " .. k .. ":", v)
                    end
                end
                print("Body:")
                print(response.Body)
                Notify("Solanix", "Response: " .. response.StatusCode .. " (see console)", 4)
            end)
        end)

        Button(body, "Quick GET httpbin.org/get", function()
            urlInput.Text = "https://httpbin.org/get"
            methodInput.Text = "GET"
            bodyInput.Text = ""
        end)
