SolanixHub.modules.EventCounter = {}
do
    local M = SolanixHub.modules.EventCounter
    local counters = {}
    function M.Build()
        local page = SolanixHub.NewPage("EventCounter")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Event Counter")
        Label(body, "Track how often specific events fire.", { size = 11 })

        local addCard, addBody = Section(scroll, "Add Counter")
        local _, pathInput = TextBox(addBody, "Instance path", "game.Workspace", "", function() end)
        local _, eventInput = TextBox(addBody, "Event name", "ChildAdded", "", function() end)
        Button(addBody, "Add Counter", function()
            local path = pathInput.Text
            local eventName = eventInput.Text
            if path == "" or eventName == "" then return end
            local fn = loadstring("return " .. path)
            if not fn then return end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or typeof(obj) ~= "Instance" then return end
            local ok2, signal = pcall(function() return obj[eventName] end)
            if not ok2 or not signal or not signal.Connect then return end
            local key = path .. "." .. eventName
            counters[key] = 0
            Track(signal:Connect(function()
                counters[key] = (counters[key] or 0) + 1
            end))
            Notify("Solanix", "Counter added.", 3)
        end)

        local listCard, listBody = Section(scroll, "Active Counters")
        M._listBody = listBody
        Button(listBody, "Refresh", function() M.Refresh() end)
        Button(listBody, "Reset All", function()
            for k, _ in pairs(counters) do counters[k] = 0 end
        end)

        Spawn(function()
            while SolanixGui.Parent do
                if currentPage == "EventCounter" then
                    M.Refresh()
                end
                task_wait(1)
            end
        end)
    end

    function M.Refresh()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "CountRow" then
                pcall(function() c:Destroy() end)
