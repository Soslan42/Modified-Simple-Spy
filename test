SolanixHub.modules.LiveOutput = {}
do
    local M = SolanixHub.modules.LiveOutput
    local logs = {}
    local MAX = 200
    local originalPrint = print
    local originalWarn = warn

    function M.Build()
        local page = SolanixHub.NewPage("LiveOutput")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Live Output (print/warn capture)")
        Label(body, "Captures print() and warn() output. Limited to " .. MAX .. " entries.", { size = 11 })

        Toggle(body, "Capture print", false, function(v)
            if v then
                print = function(...)
                    local args = {...}
                    local parts = {}
                    for _, a in ipairs(args) do
                        table_insert(parts, ValueToString(a))
                    end
                    table_insert(logs, { type = "print", text = table.concat(parts, "\t"), time = os.date("%H:%M:%S") })
                    if #logs > MAX then table_remove(logs, 1) end
                    M.Refresh()
                    return originalPrint(...)
                end
            else
                print = originalPrint
            end
        end)

        Toggle(body, "Capture warn", false, function(v)
            if v then
                warn = function(...)
                    local args = {...}
                    local parts = {}
                    for _, a in ipairs(args) do
                        table_insert(parts, ValueToString(a))
                    end
                    table_insert(logs, { type = "warn", text = table.concat(parts, "\t"), time = os.date("%H:%M:%S") })
                    if #logs > MAX then table_remove(logs, 1) end
                    M.Refresh()
                    return originalWarn(...)
                end
            else
                warn = originalWarn
            end
        end)

        Button(body, "Clear Logs", function()
            logs = {}
            M.Refresh()
        end)

        local listCard, listBody = Section(scroll, "Captured Output")
        M._listBody = listBody
    end

    function M.Refresh()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "LogRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for i = #logs, math.max(1, #logs - 49), -1 do
            local l = logs[i]
            if l then
                local row = Create("Frame", {
                    Parent = M._listBody,
                    Name = "LogRow",
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 22),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 6, 0, 0),
                    Size = UDim2.new(0, 60, 1, 0),
                    Font = THEME.fontMono,
                    Text = l.time,
                    TextColor3 = THEME.textMuted,
                    TextSize = 10,
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 70, 0, 0),
                    Size = UDim2.new(0, 40, 1, 0),
                    Font = THEME.fontBold,
                    Text = l.type:upper(),
                    TextColor3 = l.type == "warn" and THEME.amber or THEME.cyan,
                    TextSize = 10,
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 120, 0, 0),
                    Size = UDim2.new(1, -130, 1, 0),
                    Font = THEME.fontMono,
                    Text = l.text,
                    TextColor3 = THEME.textPrimary,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
        end
    end
