-- UDim2 editor
function SolanixHub.PropertyEditors.UDim2(parent, obj, propName)
    local currentVal = UDim2.new()
    pcall(function() currentVal = obj[propName] end)
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 32),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(0.3, 0, 1, 0),
        Font = THEME.font,
        Text = propName,
        TextColor3 = THEME.textSecondary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local function makeInput(xOff, label, value, callback)
        local i = Create("TextBox", {
            Parent = row,
            BackgroundColor3 = THEME.bgEditor,
            BorderSizePixel = 0,
            Position = UDim2.new(0.3, xOff, 0.5, -10),
            Size = UDim2.new(0.15, -4, 0, 20),
            Font = THEME.fontMono,
            Text = string_format("%.2f", value),
            TextColor3 = THEME.textPrimary,
            TextSize = 10,
            ClearTextOnFocus = false,
        })
        Create("UICorner", { Parent = i, CornerRadius = THEME.radiusSm })
        Track(i.FocusLost:Connect(function()
            local v = tonumber(i.Text) or value
            i.Text = string_format("%.2f", v)
            callback(v)
        end))
        return i
    end
    makeInput(0,   "X.Scale",  currentVal.X.Scale,  function(v) pcall(function() local c = obj[propName] obj[propName] = UDim2.new(v, c.X.Offset, c.Y.Scale, c.Y.Offset) end) end)
    makeInput(60,  "X.Offset", currentVal.X.Offset, function(v) pcall(function() local c = obj[propName] obj[propName] = UDim2.new(c.X.Scale, v, c.Y.Scale, c.Y.Offset) end) end)
    makeInput(120, "Y.Scale",  currentVal.Y.Scale,  function(v) pcall(function() local c = obj[propName] obj[propName] = UDim2.new(c.X.Scale, c.X.Offset, v, c.Y.Offset) end) end)
    makeInput(180, "Y.Offset", currentVal.Y.Offset, function(v) pcall(function() local c = obj[propName] obj[propName] = UDim2.new(c.X.Scale, c.X.Offset, c.Y.Scale, v) end) end)
    return row
end

