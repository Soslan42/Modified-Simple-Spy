SolanixHub.modules.StatusDashboard = {}
do
    local M = SolanixHub.modules.StatusDashboard
    function M.Build()
        local page = SolanixHub.NewPage("StatusDashboard")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Live Status Dashboard")

        -- Grid of stat cards
        local grid = Create("Frame", {
            Parent = body,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 90),
        })
        Create("UIGridLayout", {
            Parent = grid,
            CellSize = UDim2.new(0.5, -2, 0, 90),
            CellPadding = UDim2.new(0, 4, 0, 4),
        })

        local function statCard(label, color)
            local card2 = Create("Frame", {
                Parent = grid,
                BackgroundColor3 = THEME.bgPanel,
                BorderSizePixel = 0,
            })
            ApplySolanixSurface(card2)
            Create("UIPadding", {
                Parent = card2,
                PaddingLeft = UDim.new(0, 12),
                PaddingRight = UDim.new(0, 12),
                PaddingTop = UDim.new(0, 8),
                PaddingBottom = UDim.new(0, 8),
            })
            Create("TextLabel", {
                Parent = card2,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 14),
                Font = THEME.fontBold,
                Text = label,
                TextColor3 = THEME.textSecondary,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            local valLbl = Create("TextLabel", {
                Parent = card2,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 16),
                Size = UDim2.new(1, 0, 0, 36),
                Font = THEME.fontBold,
                Text = "...",
                TextColor3 = color or THEME.textAccent,
                TextSize = 22,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            return valLbl
        end

        local fpsLbl = statCard("FPS", THEME.green)
        local pingLbl = statCard("PING", THEME.cyan)
        local memLbl = statCard("MEMORY", THEME.amber)
        local plrLbl = statCard("PLAYERS", THEME.accent)

        Spawn(function()
            while SolanixGui.Parent do
                local frameCount = 0
                local conn = RunService.RenderStepped:Connect(function()
                    frameCount += 1
                end)
                task_wait(1)
                if conn then conn:Disconnect() end
                if fpsLbl and fpsLbl.Parent then
                    fpsLbl.Text = tostring(frameCount)
                    local ping = 0
                    pcall(function()
                        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                    end)
                    pingLbl.Text = tostring(math_floor(ping)) .. " ms"
                    local mem = 0
                    pcall(function() mem = Stats:GetTotalMemoryUsageMb() end)
                    memLbl.Text = string_format("%.1f MB", mem)
                    plrLbl.Text = #Players:GetPlayers() .. "/" .. Players.MaxPlayers
                end
            end
        end)

        local detCard, detBody = Section(scroll, "Detailed Stats")
        local detailLbls = {}
        local detailKeys = {
            "Health", "MaxHealth", "WalkSpeed", "JumpPower",
            "Position X", "Position Y", "Position Z",
            "Velocity X", "Velocity Y", "Velocity Z",
            "Workspace.Gravity", "Lighting.ClockTime", "Lighting.Brightness",
            "Tracked Connections", "Tracked Instances", "Tracked Threads",
            "Modules Loaded",
        }
        for _, key in ipairs(detailKeys) do
            detailLbls[key] = SolanixHub.Widgets.KeyValueRow(detBody, key, "...")
        end

        Spawn(function()
            while SolanixGui.Parent do
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local function update(key, value)
                    local row = detailLbls[key]
                    if row then
                        for _, c in ipairs(row:GetChildren()) do
                            if c:IsA("TextLabel") and c.Text ~= key then
                                c.Text = tostring(value)
                            end
                        end
                    end
                end
                if hum then
                    update("Health", math_floor(hum.Health))
                    update("MaxHealth", math_floor(hum.MaxHealth))
                    update("WalkSpeed", hum.WalkSpeed)
                    update("JumpPower", hum.JumpPower)
                end
                if root then
                    update("Position X", string_format("%.2f", root.Position.X))
                    update("Position Y", string_format("%.2f", root.Position.Y))
                    update("Position Z", string_format("%.2f", root.Position.Z))
                    update("Velocity X", string_format("%.2f", root.Velocity.X))
                    update("Velocity Y", string_format("%.2f", root.Velocity.Y))
                    update("Velocity Z", string_format("%.2f", root.Velocity.Z))
                end
                update("Workspace.Gravity", Workspace.Gravity)
                update("Lighting.ClockTime", Lighting.ClockTime)
                update("Lighting.Brightness", Lighting.Brightness)
                update("Tracked Connections", #SolanixHub._connections)
                update("Tracked Instances", #SolanixHub._instances)
                update("Tracked Threads", #SolanixHub._threads)
                local modCount = 0
                for _ in pairs(SolanixHub.modules) do modCount = modCount + 1 end
                update("Modules Loaded", modCount)
                task_wait(0.5)
            end
        end)
    end
end

