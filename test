do
    local M = SolanixHub.modules.PlayerProximity
    function M.Build()
        local page = SolanixHub.NewPage("PlayerProximity")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Player Proximity Detector")
        Label(body, "Find the closest players to you.", { size = 11 })

        local list = Create("ScrollingFrame", {
            Parent = body,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 200),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = THEME.scrollBarSize,
        })
        Create("UIListLayout", {
            Parent = list,
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })

        local function refresh()
            for _, c in ipairs(list:GetChildren()) do
                if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
                    pcall(function() c:Destroy() end)
                end
            end
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myRoot then return end
            local players = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local r = p.Character:FindFirstChild("HumanoidRootPart")
                    if r then
                        local d = (r.Position - myRoot.Position).Magnitude
                        table_insert(players, { player = p, distance = d, root = r })
                    end
                end
            end
            table.sort(players, function(a, b) return a.distance < b.distance end)
            for i, p in ipairs(players) do
                if i > 20 then break end
                local row = Create("Frame", {
                    Parent = list,
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 0),
                    Size = UDim2.new(0.5, 0, 1, 0),
                    Font = THEME.font,
                    Text = p.player.DisplayName .. " (" .. p.player.Name .. ")",
                    TextColor3 = THEME.textPrimary,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundColor3 = THEME.bgPanel,
                    BackgroundTransparency = 0,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0.5, 0, 0.5, -10),
                    Size = UDim2.new(0, 60, 0, 20),
                    Font = THEME.fontMono,
                    Text = string_format("%.0f studs", p.distance),
                    TextColor3 = THEME.textAccent,
                    TextSize = 10,
                })
                Create("UICorner", { Parent = row:GetChildren()[#row:GetChildren()], CornerRadius = THEME.radiusSm })
                local tp = Create("TextButton", {
                    Parent = row,
                    BackgroundColor3 = THEME.accent,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -60, 0.5, -10),
                    Size = UDim2.new(0, 50, 0, 20),
                    Font = THEME.font,
                    Text = "TP",
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 10,
                    AutoButtonColor = false,
                })
                Create("UICorner", { Parent = tp, CornerRadius = THEME.radiusSm })
                Track(tp.MouseButton1Click:Connect(function()
                    if myRoot and p.root then
                        myRoot.CFrame = p.root.CFrame + Vector3.new(0, 3, 0)
                    end
                end))
            end
        end
        Button(body, "Refresh", refresh)
        Spawn(function()
            while SolanixGui.Parent do
                if currentPage == "PlayerProximity" then
                    refresh()
                end
                task_wait(2)
            end
        end)
    end
end

