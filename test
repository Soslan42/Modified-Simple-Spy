    local watching = {}
    local logs = {}

    function M.Build()
        local page = SolanixHub.NewPage("PropertyWatcher")
        local scroll = Scroller(page)

        local addCard, addBody = Section(scroll, "Add Watch")
        local _, objPath = TextBox(addBody, "Instance path (game.Workspace.Part)", "game.Workspace.Part", "", function() end)
        local _, propName = TextBox(addBody, "Property name", "Name", "", function() end)
        Button(addBody, "Add Watch", function()
            local path = objPath.Text
            local prop = propName.Text
            if path == "" or prop == "" then
                Notify("Solanix", "Enter both path and property.", 3)
                return
            end
            local fn, err = loadstring("return " .. path)
            if not fn then
                Notify("Solanix", "Invalid path: " .. tostring(err), 4)
                return
            end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or not obj or typeof(obj) ~= "Instance" then
                Notify("Solanix", "Instance not found.", 3)
                return
            end
            local ok2, val = pcall(function() return obj[prop] end)
            if not ok2 then
                Notify("Solanix", "Property not found.", 3)
                return
            end
            local id = path .. "." .. prop
            watching[id] = { obj = obj, prop = prop, lastValue = val }
            Notify("Solanix", "Watching " .. id, 3)
            M.RefreshList()
        end)

        local listCard, listBody = Section(scroll, "Active Watches")
        M._listBody = listBody
        Button(listBody, "Refresh List", function() M.RefreshList() end)
        Button(listBody, "Clear All", function()
            watching = {}
            M.RefreshList()
        end)

        local logCard, logBody = Section(scroll, "Change Log")
        M._logBody = logBody
        Button(logBody, "Clear Log", function()
            logs = {}
            M.RefreshLog()
        end)

        -- Check for changes every second
        Spawn(function()
            while SolanixGui.Parent do
                for id, w in pairs(watching) do
                    local ok, val = pcall(function() return w.obj[w.prop] end)
                    if ok and val ~= w.lastValue then
                        local oldStr = ValueToString(w.lastValue)
                        local newStr = ValueToString(val)
                        table_insert(logs, {
                            id = id,
                            old = oldStr,
                            new = newStr,
                            time = os.time(),
                        })
                        if #logs > 100 then table_remove(logs, 1) end
                        w.lastValue = val
                        Notify("Solanix", "Property changed: " .. id, 3)
                        M.RefreshLog()
                    end
                end
                task_wait(0.5)
            end
        end)
    end

    function M.RefreshList()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name ~= "WatchRow" and c.Name ~= "" and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
                -- keep buttons (which are TextButton)
            end
            if c:IsA("Frame") and c.Name == "WatchRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for id, w in pairs(watching) do
            local row = Create("Frame", {
                Parent = M._listBody,
                Name = "WatchRow",
                BackgroundColor3 = THEME.bgElevated,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28),
            })
            Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
            Create("TextLabel", {
                Parent = row,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 8, 0, 0),
                Size = UDim2.new(0.7, 0, 1, 0),
                Font = THEME.fontMono,
                Text = id,
                TextColor3 = THEME.textPrimary,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local delBtn = Create("TextButton", {
                Parent = row,
                BackgroundColor3 = THEME.bgActive,
                BorderSizePixel = 0,
                Position = UDim2.new(1, -50, 0.5, -10),
                Size = UDim2.new(0, 40, 0, 20),
                Font = THEME.font,
                Text = "Remove",
                TextColor3 = THEME.red,
                TextSize = 10,
                AutoButtonColor = false,
            })
            Create("UICorner", { Parent = delBtn, CornerRadius = THEME.radiusSm })
            Track(delBtn.MouseButton1Click:Connect(function()
                watching[id] = nil
                M.RefreshList()
            end))
        end
    end

    function M.RefreshLog()
        if not M._logBody then return end
        for _, c in ipairs(M._logBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "LogRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for i = #logs, math.max(1, #logs - 19), -1 do
            local log = logs[i]
            if log then
                local row = Create("Frame", {
                    Parent = M._logBody,
                    Name = "LogRow",
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 36),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 2),
                    Size = UDim2.new(1, -16, 0, 12),
                    Font = THEME.fontBold,
                    Text = log.id,
                    TextColor3 = THEME.textAccent,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 16),
                    Size = UDim2.new(1, -16, 0, 16),
                    Font = THEME.fontMono,
                    Text = log.old .. "  →  " .. log.new,
                    TextColor3 = THEME.textSecondary,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
        end
    end
end


