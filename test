SolanixHub.modules.CharacterCustomization = {}
do
    local M = SolanixHub.modules.CharacterCustomization
    function M.Build()
        local page = SolanixHub.NewPage("CharacterCustomization")
        local scroll = Scroller(page)

        local colorCard, colorBody = Section(scroll, "Body Colors")
        local bodyParts = {"Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}
        local currentColors = {}
        for _, part in ipairs(bodyParts) do
            currentColors[part] = Color3.fromRGB(248, 248, 248)
            ColorPicker(colorBody, part .. " Color", currentColors[part], function(c)
                currentColors[part] = c
                M.ApplyBodyColors(currentColors)
            end)
        end

        local sizeCard, sizeBody = Section(scroll, "Body Scaling")
        local scales = {
            { name = "HeadScale", min = 0.5, max = 5, default = 1 },
            { name = "HeightScale", min = 0.5, max = 5, default = 1 },
            { name = "WidthScale", min = 0.5, max = 5, default = 1 },
            { name = "DepthScale", min = 0.5, max = 5, default = 1 },
            { name = "BodyTypeScale", min = 0, max = 1, default = 0.3 },
            { name = "ProportionScale", min = 0, max = 1, default = 0 },
        }
        local scaleValues = {}
        for _, s in ipairs(scales) do
            local _, getter = Slider(sizeBody, s.name, s.min, s.max, s.default, 2, function(v)
                scaleValues[s.name] = v
                M.ApplyScales(scaleValues)
            end)
            scaleValues[s.name] = s.default
        end

        local actCard, actBody = Section(scroll, "Actions")
        Button(actBody, "Apply Changes Now", function()
            M.ApplyBodyColors(currentColors)
            M.ApplyScales(scaleValues)
            Notify("Solanix", "Character customization applied.", 3)
        end)
        Button(actBody, "Reset to Default", function()
            for k, _ in pairs(currentColors) do
                currentColors[k] = Color3.fromRGB(248, 248, 248)
            end
            for k, _ in pairs(scaleValues) do
                scaleValues[k] = 1
            end
            M.ApplyBodyColors(currentColors)
            M.ApplyScales(scaleValues)
            Notify("Solanix", "Character reset to defaults.", 3)
        end)
    end

    function M.ApplyBodyColors(colors)
        local char = LocalPlayer.Character
        if not char then return end
        local bc = char:FindFirstChildOfClass("BodyColors")
        if not bc then
            bc = Create("BodyColors", { Parent = char })
        end
        if colors.Head then bc.HeadColor3 = colors.Head end
        if colors.Torso then bc.TorsoColor3 = colors.Torso end
        if colors.LeftArm then bc.LeftArmColor3 = colors.LeftArm end
        if colors.RightArm then bc.RightArmColor3 = colors.RightArm end
        if colors.LeftLeg then bc.LeftLegColor3 = colors.LeftLeg end
        if colors.RightLeg then bc.RightLegColor3 = colors.RightLeg end
    end

    function M.ApplyScales(scales)
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(function()
            local hd = hum:FindFirstChildOfClass("HumanoidDescription")
            if not hd then
                hd = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
                if hd then hd.Parent = hum end
            end
            if hd then
                if scales.HeadScale then hd.HeadScale = scales.HeadScale end
                if scales.HeightScale then hd.HeightScale = scales.HeightScale end
                if scales.WidthScale then hd.WidthScale = scales.WidthScale end
                if scales.DepthScale then hd.DepthScale = scales.DepthScale end
                if scales.BodyTypeScale then hd.BodyTypeScale = scales.BodyTypeScale end
                if scales.ProportionScale then hd.ProportionScale = scales.ProportionScale end
                hum:ApplyDescription(hd)
            end
        end)
    end
end

