SolanixHub.modules.BatchRemoteExecutor = {}
do
    local M = SolanixHub.modules.BatchRemoteExecutor
    function M.Build()
        local page = SolanixHub.NewPage("BatchRemoteExecutor")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Batch Remote Executor")
        Label(body, "Run a remote call multiple times in a row.", { size = 11 })

        local _, pathInput = TextBox(body, "Remote path (game.ReplicatedStorage.RemoteEvent)", "game.ReplicatedStorage.RemoteEvent", "", function() end)
        local _, methodInput = TextBox(body, "Method (FireServer or InvokeServer)", "FireServer", "", function() end)
        local _, argsInput = TextBox(body, "Arguments (Lua table syntax: {1, 2, 3})", "{}", "", function() end)
        local _, countInput = TextBox(body, "Number of calls", "10", "", function() end)
        local _, delayInput = TextBox(body, "Delay between calls (seconds)", "0.1", "", function() end)

        Button(body, "Execute Batch", function()
            local path = pathInput.Text
            local method = methodInput.Text
            local argsText = argsInput.Text
            local count = tonumber(countInput.Text) or 1
            local delaySec = tonumber(delayInput.Text) or 0
            if path == "" or method == "" then
                Notify("Solanix", "Path and method required.", 3)
                return end
            local fn = loadstring("return " .. path)
            if not fn then Notify("Solanix", "Invalid path.", 3) return end
            setfenv(fn, getfenv())
            local ok, remote = pcall(fn)
            if not ok or typeof(remote) ~= "Instance" then
                Notify("Solanix", "Remote not found.", 3)
                return
            end
            local argsFn = loadstring("return " .. argsText)
            local args = {}
            if argsFn then
                setfenv(argsFn, getfenv())
                local ok2, a = pcall(argsFn)
                if ok2 and type(a) == "table" then args = a end
            end
            Notify("Solanix", "Starting batch: " .. count .. " calls...", 3)
            Spawn(function()
                for i = 1, count do
                    pcall(function()
                        if method == "FireServer" then
                            remote:FireServer(table.unpack(args))
                        elseif method == "InvokeServer" then
                            remote:InvokeServer(table.unpack(args))
                        end
                    end)
                    if delaySec > 0 then task_wait(delaySec) end
                end
                Notify("Solanix", "Batch complete: " .. count .. " calls.", 3)
            end)
        end)
    end
end

