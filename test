    local function getIconFor(obj)
        if not obj then return "?" end
        local cn = obj.ClassName
        if classIcon[cn] then return classIcon[cn] end
        -- Fallback by IsA
        if pcall(function() return obj:IsA("BasePart") end) and obj:IsA("BasePart") then return "◼" end
        if pcall(function() return obj:IsA("GuiObject") end) and obj:IsA("GuiObject") then return "▭" end
        if pcall(function() return obj:IsA("ValueBase") end) and obj:IsA("ValueBase") then return "📦" end
        return "•"
    end

    local function getChildren(obj)
        if not obj then return {} end
        local kids = {}
        pcall(function()
            for _, c in ipairs(obj:GetChildren()) do
                table_insert(kids, c)
            end
        end)
        -- Sort alphabetically, instances first by name
        table.sort(kids, function(a, b)
            local na, nb = a.Name or "", b.Name or ""
            return string_lower(na) < string_lower(nb)
        end)
        return kids
    end

    local function getServices()
        local services = {}
        pcall(function()
            for _, s in ipairs(game:GetChildren()) do
                table_insert(services, s)
            end
        end)
        table.sort(services, function(a, b)
            return string_lower(a.Name) < string_lower(b.Name)
        end)
        return services
    end

    -- Build (or refresh) the tree starting from the given parent instance.
    -- If parent is nil, show the game's services.
    function refreshTree()
        for _, c in ipairs(treeList:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
                pcall(function() c:Destroy() end)
            end
        end
        nodes = {}
        local services = getServices()
        for _, s in ipairs(services) do
            buildTreeRow(s, 0, nil)
        end
    end

    -- Build one row + recursively build children if expanded.
    function buildTreeRow(obj, depth, parentNode)
        if not obj then return end
        local node = {
            obj = obj,
            depth = depth,
            expanded = false,
            row = nil,
            children = {},
            loaded = false,
        }
        nodes[obj] = node
        if parentNode then
            table_insert(parentNode.children, node)
        end

        local row = Create("Frame", {
            Parent = parentNode and parentNode.kidsFrame or treeList,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 20),
            LayoutOrder = (parentNode and #parentNode.children) or 0,
        })
        Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
        node.row = row

        -- Indent
        local indent = depth * 14
        local arrow = Create("TextButton", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, indent, 0, 0),
            Size = UDim2.new(0, 14, 1, 0),
            Font = THEME.fontBold,
            Text = "›",
            TextColor3 = THEME.textMuted,
            TextSize = 12,
            AutoButtonColor = false,
            TextXAlignment = Enum.TextXAlignment.Center,
        })

        local icon = Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, indent + 14, 0, 0),
            Size = UDim2.new(0, 16, 1, 0),
            Font = THEME.font,
            Text = getIconFor(obj),
            TextColor3 = THEME.textAccent,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Center,
        })

        local name = Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, indent + 32, 0, 0),
            Size = UDim2.new(1, -indent - 60, 1, 0),
            Font = THEME.font,
            Text = obj.Name,
            TextColor3 = THEME.textPrimary,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local classLbl = Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -90, 0, 0),
            Size = UDim2.new(0, 86, 1, 0),
            Font = THEME.fontMono,
            Text = obj.ClassName,
