SolanixHub.modules.EventMonitor = {}
do
    local M = SolanixHub.modules.EventMonitor
    local monitoring = false
    local events = {}
    local MAX_EVENTS = 100

    function M.Build()
        local page = SolanixHub.NewPage("EventMonitor")
        local scroll = Scroller(page)

        local ctrlCard, ctrlBody = Section(scroll, "Event Monitor")
        Label(ctrlBody, "Monitor specific events on instances you choose.", { size = 11 })
        Toggle(ctrlBody, "Start Monitoring", false, function(v)
            monitoring = v
            Notify("Solanix", "Monitoring " .. (v and "started" or "stopped"), 3)
        end)
        Button(ctrlBody, "Clear Events", function()
            events = {}
            M.Refresh()
        end)

        local addCard, addBody = Section(scroll, "Add Event to Monitor")
        local _, pathInput = TextBox(addBody, "Instance path", "game.Workspace", "", function() end)
        local _, eventInput = TextBox(addBody, "Event name (e.g. ChildAdded, Touched)", "ChildAdded", "", function() end)
        Button(addBody, "Add Monitor", function()
            local path = pathInput.Text
            local eventName = eventInput.Text
            if path == "" or eventName == "" then return end
            local fn = loadstring("return " .. path)
            if not fn then return end
            setfenv(fn, getfenv())
            local ok, obj = pcall(fn)
            if not ok or typeof(obj) ~= "Instance" then return end
            local ok2, signal = pcall(function() return obj[eventName] end)
            if not ok2 or not signal or not signal.Connect then
                Notify("Solanix", "Event not found.", 3)
                return
            end
            Track(signal:Connect(function(...)
                if not monitoring then return end
                local args = {...}
                local argStrs = {}
                for _, a in ipairs(args) do
                    table_insert(argStrs, ValueToString(a))
                end
                table_insert(events, {
                    path = path,
                    event = eventName,
                    args = table.concat(argStrs, ", "),
                    time = os.date("%H:%M:%S"),
                })
                if #events > MAX_EVENTS then table_remove(events, 1) end
                M.Refresh()
            end))
            Notify("Solanix", "Monitoring: " .. path .. "." .. eventName, 3)
        end)

        local listCard, listBody = Section(scroll, "Event Log")
        M._listBody = listBody
    end

    function M.Refresh()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "EventRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for i = #events, math.max(1, #events - 19), -1 do
            local e = events[i]
            if e then
                local row = Create("Frame", {
                    Parent = M._listBody,
                    Name = "EventRow",
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 40),
                })
                Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
                Create("UIPadding", {
                    Parent = row,
                    PaddingLeft = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8),
                    PaddingTop = UDim.new(0, 4),
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 14),
                    Font = THEME.fontMono,
                    Text = string_format("[%s] %s.%s", e.time, e.path, e.event),
                    TextColor3 = THEME.textAccent,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
                Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 16),
                    Size = UDim2.new(1, 0, 0, 20),
                    Font = THEME.fontMono,
                    Text = "Args: " .. e.args,
                    TextColor3 = THEME.textSecondary,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
            end
        end
    end
