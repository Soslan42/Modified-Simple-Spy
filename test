-- Generic dispatcher: chooses the right editor based on typeof
function SolanixHub.PropertyEditors.Dispatch(parent, obj, propName)
    if not obj then return nil end
    local ok, val = pcall(function() return obj[propName] end)
    if not ok then return nil end
    local t = typeof(val)
    if t == "string" then
        return SolanixHub.PropertyEditors.String(parent, obj, propName)
    elseif t == "number" then
        return SolanixHub.PropertyEditors.Number(parent, obj, propName)
    elseif t == "boolean" then
        return SolanixHub.PropertyEditors.Boolean(parent, obj, propName)
    elseif t == "Color3" then
        return SolanixHub.PropertyEditors.Color3(parent, obj, propName)
    elseif t == "EnumItem" then
        return SolanixHub.PropertyEditors.EnumItem(parent, obj, propName)
    elseif t == "Vector3" then
        return SolanixHub.PropertyEditors.Vector3(parent, obj, propName)
    elseif t == "CFrame" then
        return SolanixHub.PropertyEditors.CFrame(parent, obj, propName)
    elseif t == "UDim2" then
        return SolanixHub.PropertyEditors.UDim2(parent, obj, propName)
    elseif t == "Instance" then
        return SolanixHub.PropertyEditors.Instance(parent, obj, propName)
    elseif t == "BrickColor" then
        return SolanixHub.PropertyEditors.BrickColor(parent, obj, propName)
    else
        -- Fallback: show as read-only string
        local row = Create("Frame", {
            Parent = parent,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 26),
        })
        Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
        Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0, 0),
            Size = UDim2.new(0.35, 0, 1, 0),
            Font = THEME.font,
            Text = propName,
            TextColor3 = THEME.textSecondary,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        Create("TextLabel", {
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0.35, 0, 0, 0),
            Size = UDim2.new(0.65, -8, 1, 0),
            Font = THEME.fontMono,
            Text = ValueToString(val) .. "   -- " .. t,
            TextColor3 = THEME.textMuted,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
        return row
    end
end


