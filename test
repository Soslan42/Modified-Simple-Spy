--=====================================================================

SolanixHub._state.chatSpyLogs = SolanixHub._state.chatSpyLogs or {}
SolanixHub._state.chatSpyActive = false
function SolanixHub.EnableChatSpy()
    if SolanixHub._state.chatSpyActive then return end
    SolanixHub._state.chatSpyActive = true
    Spawn(function()
        local ok, events = pcall(function()
            return ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5)
        end)
        if not ok or not events then
            Notify("Solanix", "Chat events not found — chat spy unavailable.", 3)
            return
        end
        local msgEvent = events:FindFirstChild("OnMessageDoneFiltering")
        if not msgEvent then
            Notify("Solanix", "OnMessageDoneFiltering not found.", 3)
            return
        end
        Track(msgEvent.OnClientEvent:Connect(function(data)
            if data and data.Message then
                table_insert(SolanixHub._state.chatSpyLogs, {
                    speaker = data.SpeakerUserId or "?",
                    name    = data.FromSpeaker or "?",
                    message = data.Message or "",
                    time    = os.time(),
                })
                if #SolanixHub._state.chatSpyLogs > 500 then
                    table_remove(SolanixHub._state.chatSpyLogs, 1)
                end
            end
        end))
    end)
end

