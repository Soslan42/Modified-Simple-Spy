do
    local M = SolanixHub.modules.ScriptAnalyzer
    function M.Build()
        local page = SolanixHub.NewPage("ScriptAnalyzer")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Script Analyzer")
        Label(body, "Analyze a script's contents (line count, complexity).", { size = 11 })

        local _, codeInput = TextBox(body, "Lua code", "print('hello')", "", function() end)
        codeInput.Size = UDim2.new(1, 0, 0, 80)
        codeInput.MultiLine = true
        codeInput.TextWrapped = true
        codeInput.ClearTextOnFocus = false

        local resultsLbl = Create("TextLabel", {
            Parent = body,
            BackgroundColor3 = THEME.bgEditor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 80),
            Font = THEME.fontMono,
            Text = "(results appear here)",
            TextColor3 = THEME.textSecondary,
            TextSize = 10,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
        })
        Create("UICorner", { Parent = resultsLbl, CornerRadius = THEME.radiusSm })
        Create("UIPadding", {
            Parent = resultsLbl,
            PaddingLeft = UDim.new(0, 8),
            PaddingTop = UDim.new(0, 6),
        })

        Button(body, "Analyze", function()
            local code = codeInput.Text
            if code == "" then return end
            local lines = SolanixHub._stringUtils.split(code, "\n")
            local lineCount = #lines
            local charCount = #code
            local wordCount = 0
            for _ in code:gmatch("%S+") do wordCount = wordCount + 1 end
            local funcCount = select(2, code:gsub("function", ""))
            local ifCount = select(2, code:gsub("%sif%s", ""))
            local forCount = select(2, code:gsub("%sfor%s", ""))
            local whileCount = select(2, code:gsub("%swhile%s", ""))
            local commentCount = select(2, code:gsub("%-%-", ""))

            resultsLbl.Text = string_format(
                "Lines: %d\nCharacters: %d\nWords: %d\nFunctions: %d\nIf statements: %d\nFor loops: %d\nWhile loops: %d\nComments: %d",
                lineCount, charCount, wordCount, funcCount, ifCount, forCount, whileCount, commentCount
            )
        end)

        Button(body, "Minify", function()
            local code = codeInput.Text
            if code == "" then return end
            -- Simple minify: strip comments and extra whitespace
            local minified = code
                :gsub("%-%-%[%[.-%]%]", "")  -- long comments
                :gsub("%-%-[^\n]*", "")       -- line comments
                :gsub("%s+", " ")             -- collapse whitespace
                :gsub("^%s+", "")             -- leading
                :gsub("%s+$", "")             -- trailing
            resultsLbl.Text = "Minified size: " .. #minified .. " bytes (was " .. #code .. ")"
            safeClipboard(minified)
            Notify("Solanix", "Minified code copied.", 3)
        end)
    end
end

