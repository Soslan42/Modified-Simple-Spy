            M.ResetTransparency()
        end)

        local speedCard, speedBody = Section(scroll, "Speed Hacks")
        Toggle(speedBody, "Auto-walk speed (CFrame-based)", false, function(v)
            SolanixHub._state.cframeSpeed = v
            if v then
                Spawn(function()
                    while SolanixHub._state.cframeSpeed and SolanixGui.Parent do
                        local char = LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if hum and root and hum.MoveDirection.Magnitude > 0 then
                            local speed = SolanixHub._state.cframeSpeedValue or 100
                            root.CFrame = root.CFrame + hum.MoveDirection * (speed * 0.1)
                        end
                        task_wait(0.03)
                    end
                end)
            end
        end)
        Slider(speedBody, "CFrame Speed", 16, 500, 100, 0, function(v)
            SolanixHub._state.cframeSpeedValue = v
        end)

        local jumpCard, jumpBody = Section(scroll, "Jump Hacks")
        Toggle(jumpBody, "Infinite Jump", false, function(v)
            SolanixHub._state.infiniteJump = v
        end)
        Slider(jumpBody, "Jump Height (when using JumpHeight)", 5, 100, 7.2, 1, function(v)
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.UseJumpPower = false
                hum.JumpHeight = v
            end
        end)
        Toggle(jumpBody, "Fly on Jump (super jump)", false, function(v)
            SolanixHub._state.superJump = v
        end)

        local tpCard, tpBody = Section(scroll, "Teleport Tools")
        Button(tpBody, "Teleport Forward 10 studs", function()
            local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if r then
                r.CFrame = r.CFrame + r.CFrame.LookVector * 10
            end
        end)
        Button(tpBody, "Teleport Forward 50 studs", function()
            local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if r then
                r.CFrame = r.CFrame + r.CFrame.LookVector * 50
            end
        end)
        Button(tpBody, "Teleport Up 50 studs", function()
            local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if r then
                r.CFrame = r.CFrame + Vector3.new(0, 50, 0)
            end
        end)
        Button(tpBody, "Teleport to Mouse", function()
            local mouse = LocalPlayer:GetMouse()
            local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if r and mouse.Hit then
                r.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
            end
        end)

        local noclipCard, noclipBody = Section(scroll, "Noclip / Fly")
        Toggle(noclipBody, "Noclip (collide off)", false, function(v)
            if SolanixHub.modules.Player and SolanixHub.modules.Player.SetNoclip then
                SolanixHub.modules.Player.SetNoclip(v)
            end
        end)
        Toggle(noclipBody, "Fly (BodyVelocity)", false, function(v)
            if SolanixHub.modules.Player and SolanixHub.modules.Player.SetFly then
                SolanixHub.modules.Player.SetFly(v)
            end
        end)
    end

    function M.SetInvisible(v)
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if v then
                    p:SetAttribute("SolanixOrigTrans", p.Transparency)
                    p.Transparency = 1
                else
                    local orig = p:GetAttribute("SolanixOrigTrans")
                    if orig then p.Transparency = orig end
                end
            elseif p:IsA("Decal") then
                if v then
                    p:SetAttribute("SolanixOrigTrans", p.Transparency)
                    p.Transparency = 1
                else
                    local orig = p:GetAttribute("SolanixOrigTrans")
                    if orig then p.Transparency = orig end
                end
            end
        end
        Notify("Solanix", "Invisibility " .. (v and "enabled" or "disabled") .. ".", 3)
    end

    function M.SetLocalInvisible(v)
        -- LocalPlayer only sees themselves as invisible (no server effect)
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = v and 1 or 0
            end
        end
    end

    function M.ResetTransparency()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                local orig = p:GetAttribute("SolanixOrigTrans")
                if orig then p.Transparency = orig end
                p.LocalTransparencyModifier = 0
            elseif p:IsA("Decal") then
                local orig = p:GetAttribute("SolanixOrigTrans")
                if orig then p.Transparency = orig end
            end
        end
    end
end

