-- Used by the Explorer module to render editable rows for each property.

SolanixHub.PropertyEditors = {}

-- String editor
function SolanixHub.PropertyEditors.String(parent, obj, propName)
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 26),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    local lbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(0.35, 0, 1, 0),
        Font = THEME.font,
        Text = propName,
        TextColor3 = THEME.textSecondary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local currentVal = ""
    pcall(function() currentVal = obj[propName] or "" end)
    local input = Create("TextBox", {
        Parent = row,
        BackgroundColor3 = THEME.bgEditor,
        BorderSizePixel = 0,
        Position = UDim2.new(0.35, 0, 0.5, -10),
        Size = UDim2.new(0.65, -8, 0, 20),
        Font = THEME.fontMono,
        Text = currentVal,
        TextColor3 = THEME.textPrimary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    })
    Create("UICorner", { Parent = input, CornerRadius = THEME.radiusSm })
    Track(input.FocusLost:Connect(function()
        pcall(function() obj[propName] = input.Text end)
        local ok, v = pcall(function() return obj[propName] end)
        if ok then input.Text = tostring(v) end
    end))
    return row
end

