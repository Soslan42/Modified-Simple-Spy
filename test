-- Create(class, props, children): the canonical Roblox UI factory.
local function Create(class, props, children)
    local obj = Instance.new(class)
    for k, v in next, props or {} do
        if k ~= "Parent" then
            obj[k] = v
        end
    end
    for _, c in next, children or {} do
        c.Parent = obj
    end
    if props and props.Parent then
        obj.Parent = props.Parent
    end
    return obj
end
SolanixHub.Create = Create

-- Register a connection so it is automatically disconnected on shutdown.
local function Track(conn)
    if conn then
        table_insert(SolanixHub._connections, conn)
    end
    return conn
end

-- Register an instance so it is destroyed on shutdown.
local function TrackInstance(inst)
    if inst then
        table_insert(SolanixHub._instances, inst)
    end
    return inst
end

-- Spawn a coroutine and track it for cleanup.
local function Spawn(fn, ...)
    local co = coroutine.create(fn)
    table_insert(SolanixHub._threads, co)
    local ok, err = coroutine.resume(co, ...)
    if not ok then
        warn("[Solanix] Spawn error: " .. tostring(err))
    end
    return co
end

-- Tween helper that respects the 0.15s ease default used throughout the Solanix CSS.
local function Tween(obj, duration, props)
    local info = TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

-- Apply the standard Solanix corner + stroke to a frame-like element.
local function ApplySolanixSurface(frame, opts)
    opts = opts or {}
    Create("UICorner", {
        Parent = frame,
        CornerRadius = opts.radius or THEME.radius,
    })
    Create("UIStroke", {
        Parent = frame,
        Color = opts.stroke or THEME.borderLight,
        Thickness = opts.thickness or 1,
        Transparency = 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    return frame
end

-- Apply hover background tween to a button.
local function ApplyHover(btn, hoverColor, normalColor)
    if not btn then return end
    hoverColor  = hoverColor or THEME.bgHover
    normalColor = normalColor or THEME.bgPanel
    Track(btn.MouseEnter:Connect(function()
        Tween(btn, 0.15, { BackgroundColor3 = hoverColor })
    end))
    Track(btn.MouseLeave:Connect(function()
        Tween(btn, 0.15, { BackgroundColor3 = normalColor })
    end))
end

-- Make any GuiObject draggable by holding mouse on it (header-style).
local function MakeDraggable(object, dragHandle)
    dragHandle = dragHandle or object
    local dragging = false
    local dragStart, startPos
    Track(dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos  = object.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end))
    Track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                      or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            object.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
end
SolanixHub.MakeDraggable = MakeDraggable

-- ValueToString: human-readable serialisation for spy logs and property viewer.
local function ValueToString(v, depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    local t = typeof(v)
    if t == "Instance" then
        local ok, name = pcall(function() return v:GetFullName() end)
        return ok and name or ("<%s>"):format(t)
    elseif t == "Vector3" then
        return ("Vector3(%.2f, %.2f, %.2f)"):format(v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return ("Vector2(%.2f, %.2f)"):format(v.X, v.Y)
    elseif t == "CFrame" then
        local p = v.Position
        return ("CFrame(%s)"):format(ValueToString(p, depth + 1))
    elseif t == "Color3" then
        return ("Color3(%d, %d, %d)"):format(
            math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255))
    elseif t == "UDim" then
        return ("UDim(%g, %d)"):format(v.Scale, v.Offset)
    elseif t == "UDim2" then
        return ("UDim2(%g,%d, %g,%d)"):format(v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    elseif t == "number" then
        return tostring(v)
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "string" then
        if #v > 80 then
            return '"' .. string_sub(v, 1, 80) .. '..."'
        end
        return '"' .. v .. '"'
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "table" then
        local parts = {}
        for k, val in next, v do
            if #parts < 8 then
                table_insert(parts, ("[%s] = %s"):format(
                    type(k) == "string" and k or tostring(k),
                    ValueToString(val, depth + 1)))
            end
        end
        return "{ " .. table.concat(parts, ", ") .. (#parts >= 8 and ", ... }" or " }")
    elseif t == "function" then
        return "<function>"
    elseif t == "userdata" then
        return ("<userdata:%s>"):format(tostring(v))
    end
    return tostring(v) .. " --" .. t
end
SolanixHub.ValueToString = ValueToString

-- Notification system: top-right toasts.
local toastLayer    -- forward ref

local function Notify(title, message, duration)
    duration = duration or 4
    if not toastLayer then return end
    local toast = Create("Frame", {
        Parent = toastLayer,
        BackgroundColor3 = THEME.bgPanel,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Size = UDim2.new(0, THEME.toastWidth, 0, 0),
        Position = UDim2.new(1, -THEME.toastWidth - 16, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
    })
    ApplySolanixSurface(toast)
    -- Accent bar on the left, like Sirius/Solanix notifications
    Create("Frame", {
        Parent = toast,
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 3, 1, 0),
    })
    local pad = Create("UIPadding", {
        Parent = toast,
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 12),
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
    })
    local titleLbl = Create("TextLabel", {
        Parent = toast,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 10),
        Size = UDim2.new(1, -28, 0, 16),
        Font = THEME.fontBold,
        Text = title or "Solanix",
        TextColor3 = THEME.textPrimary,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local msgLbl = Create("TextLabel", {
        Parent = toast,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 28),
        Size = UDim2.new(1, -26, 0, 14),
        Font = THEME.font,
        Text = message or "",
        TextColor3 = THEME.textSecondary,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    -- Reposition existing toasts: stack them above the new one.
    local idx = #toastLayer:GetChildren() - 1
    toast.Position = UDim2.new(1, -THEME.toastWidth - 16, 0, 16 + idx * 0)
    -- Slide-in animation
    toast.Position = UDim2.new(1, 50, 0, 16 + idx * 0)
    toast.BackgroundTransparency = 1
    titleLbl.TextTransparency = 1
    msgLbl.TextTransparency = 1
    Tween(toast, 0.25, { Position = UDim2.new(1, -THEME.toastWidth - 16, 0, 16), BackgroundTransparency = 0 })
    Tween(titleLbl, 0.25, { TextTransparency = 0 })
    Tween(msgLbl, 0.25, { TextTransparency = 0 })

    -- Auto-dismiss
    task_delay(duration, function()
        if not toast.Parent then return end
        Tween(toast, 0.25, { BackgroundTransparency = 1, Position = UDim2.new(1, 50, 0, 16) })
        Tween(titleLbl, 0.25, { TextTransparency = 1 })
        Tween(msgLbl, 0.25, { TextTransparency = 1 })
        task_wait(0.3)
        pcall(function() toast:Destroy() end)
    end)
end
SolanixHub.Notify = Notify

-- Recompute vertical layout of all toasts after one is removed.
local function relayoutToasts()
    if not toastLayer then return end
    local y = 16
    for _, child in ipairs(toastLayer:GetChildren()) do
        if child:IsA("Frame") then
            child.Position = UDim2.new(1, -THEME.toastWidth - 16, 0, y)
            y = y + child.AbsoluteSize.Y + 8
        end
    end
end

