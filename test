--=====================================================================
-- EXTENDED REMOTE SPY: ADVANCED SERIALIZATION
--=====================================================================
-- A more capable value-to-string for spy logs that handles nested
-- tables, instances with full paths, and common userdata types.

SolanixHub.modules.RemoteSpy._advancedSerialize = nil
function SolanixHub.modules.RemoteSpy.AdvancedSerialize(v, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 4 then return "..." end
    local t = typeof(v)
    if t == "Instance" then
        local ok, fullName = pcall(function() return v:GetFullName() end)
        return ok and fullName or ("<%s>"):format(t)
    elseif t == "Vector3" then
        return ("Vector3.new(%g, %g, %g)"):format(v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return ("Vector2.new(%g, %g)"):format(v.X, v.Y)
    elseif t == "CFrame" then
        local p = v.Position
        return ("CFrame.new(%g, %g, %g)"):format(p.X, p.Y, p.Z)
    elseif t == "Color3" then
        return ("Color3.fromRGB(%d, %d, %d)"):format(
            math_floor(v.R * 255), math_floor(v.G * 255), math_floor(v.B * 255))
    elseif t == "UDim" then
        return ("UDim.new(%g, %d)"):format(v.Scale, v.Offset)
    elseif t == "UDim2" then
        return ("UDim2.new(%g, %d, %g, %d)"):format(
            v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    elseif t == "number" then
        if v == math_huge then return "math.huge" end
        if v == -math_huge then return "-math.huge" end
        if v ~= v then return "0/0" end  -- NaN
        return tostring(v)
    elseif t == "boolean" then
        return tostring(v)
    elseif t == "string" then
        if #v > 100 then
            return '"' .. string_sub(v, 1, 100) .. '..." (len=' .. #v .. ')'
        end
        return '"' .. v .. '"'
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "table" then
        if seen[v] then return "<cyclic>" end
        seen[v] = true
        local parts = {}
        local count = 0
        for k, val in next, v do
            if count < 10 then
                local keyStr = (type(k) == "string") and k or ("[" .. tostring(k) .. "]")
                table_insert(parts, keyStr .. " = " .. SolanixHub.modules.RemoteSpy.AdvancedSerialize(val, depth + 1, seen))
                count = count + 1
            else
                table_insert(parts, "...")
                break
            end
        end
        return "{ " .. table.concat(parts, ", ") .. " }"
    elseif t == "function" then
        return "<function>"
    elseif t == "userdata" then
        return ("<userdata:%s>"):format(tostring(v))
    end
    return tostring(v)
end

