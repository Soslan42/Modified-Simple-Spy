-- Example 2: Stopwatch module — demonstrates RunService.Heartbeat usage
SolanixHub.modules.Stopwatch = {}
do
    local M = SolanixHub.modules.Stopwatch
    local running = false
    local startTime = 0
    local elapsed = 0
    local display

    function M.Build()
        local page = SolanixHub.NewPage("Stopwatch")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Stopwatch")
        display = Create("TextLabel", {
            Parent = body,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 60),
            Font = THEME.fontMono,
            Text = "00:00.00",
            TextColor3 = THEME.textAccent,
            TextSize = 36,
            TextXAlignment = Enum.TextXAlignment.Center,
        })
        Button(body, running and "Pause" or "Start", function(btn)
            running = not running
            if running then
                startTime = os.clock() - elapsed
                btn.Text = "Pause"
            else
                btn.Text = "Resume"
            end
        end)
        Button(body, "Reset", function()
            running = false
            elapsed = 0
            display.Text = "00:00.00"
        end)

        -- Update loop
        Spawn(function()
            while SolanixGui.Parent do
                if running then
                    elapsed = os.clock() - startTime
                    local minutes = math_floor(elapsed / 60)
                    local seconds = math_floor(elapsed % 60)
                    local hundredths = math_floor((elapsed * 100) % 100)
                    if display and display.Parent then
                        display.Text = string_format("%02d:%02d.%02d", minutes, seconds, hundredths)
                    end
                end
                task_wait(0.01)
            end
        end)
    end
end

-- Example 3: Calculator module — demonstrates complex state and input handling
SolanixHub.modules.Calculator = {}
do
    local M = SolanixHub.modules.Calculator
    local display
    local current = "0"
    local previous = nil
    local operator = nil
    local shouldReset = false

    local function updateDisplay()
        if display and display.Parent then
            display.Text = current
        end
    end

    local function calculate()
        if not previous or not operator then return end
        local a = tonumber(previous)
        local b = tonumber(current)
        if not a or not b then return end
        local result
        if operator == "+" then result = a + b
        elseif operator == "-" then result = a - b
        elseif operator == "*" then result = a * b
        elseif operator == "/" then
            if b == 0 then result = "Error"
            else result = a / b end
        end
        current = tostring(result)
        previous = nil
        operator = nil
        shouldReset = true
        updateDisplay()
    end

    function M.Build()
        local page = SolanixHub.NewPage("Calculator")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Calculator")
        display = Create("TextLabel", {
            Parent = body,
            BackgroundColor3 = THEME.bgEditor,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 50),
            Font = THEME.fontMono,
            Text = "0",
            TextColor3 = THEME.textAccent,
            TextSize = 28,
            TextXAlignment = Enum.TextXAlignment.Right,
        })
        Create("UICorner", { Parent = display, CornerRadius = THEME.radiusSm })
        Create("UIPadding", { Parent = display, PaddingRight = UDim.new(0, 12) })

        local grid = Create("Frame", {
            Parent = body,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 200),
        })
        Create("UIGridLayout", {
            Parent = grid,
            CellSize = UDim2.new(0.25, -2, 0, 40),
            CellPadding = UDim2.new(0, 2, 0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        })

        local buttons = {
            "7", "8", "9", "/",
            "4", "5", "6", "*",
            "1", "2", "3", "-",
            "0", ".", "=", "+",
            "C",
        }
        for i, label in ipairs(buttons) do
            local btn = Create("TextButton", {
                Parent = grid,
                BackgroundColor3 = THEME.bgElevated,
                BorderSizePixel = 0,
                Font = THEME.fontBold,
                Text = label,
                TextColor3 = (label == "/" or label == "*" or label == "-" or label == "+" or label == "=") and THEME.textAccent or THEME.textPrimary,
                TextSize = 16,
                AutoButtonColor = false,
                LayoutOrder = i,
            })
            Create("UICorner", { Parent = btn, CornerRadius = THEME.radiusSm })
            ApplyHover(btn, THEME.bgHover, THEME.bgElevated)
            Track(btn.MouseButton1Click:Connect(function()
                if label == "C" then
                    current = "0"
                    previous = nil
                    operator = nil
                    shouldReset = false
                elseif label == "=" then
                    calculate()
                    return
                elseif label == "/" or label == "*" or label == "-" or label == "+" then
                    if previous and operator and not shouldReset then
                        calculate()
                    end
                    previous = current
                    operator = label
                    shouldReset = true
                    return
                else
                    if shouldReset or current == "0" then
                        current = label
                        shouldReset = false
                    else
                        current = current .. label
                    end
                end
                updateDisplay()
            end))
        end
    end
end

