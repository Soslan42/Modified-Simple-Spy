SolanixHub.modules.TimeOfDay = {}
do
    local M = SolanixHub.modules.TimeOfDay
    local autoCycle = false
    local cycleSpeed = 1
    local currentTime = 12

    function M.Build()
        local page = SolanixHub.NewPage("TimeOfDay")
        local scroll = Scroller(page)

        local clockCard, clockBody = Section(scroll, "Game Clock")
        local timeLabel = Create("TextLabel", {
            Parent = clockBody,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 40),
            Font = THEME.fontMono,
            Text = "12:00",
            TextColor3 = THEME.textAccent,
            TextSize = 28,
            TextXAlignment = Enum.TextXAlignment.Center,
        })
        Slider(clockBody, "Time of Day", 0, 24, 12, 2, function(v)
            currentTime = v
            Lighting.ClockTime = v
        end)

        local cycleCard, cycleBody = Section(scroll, "Auto Cycle")
        Toggle(cycleBody, "Enable auto-cycle", false, function(v)
            autoCycle = v
            if v then
                Spawn(function()
                    while autoCycle and SolanixGui.Parent do
                        currentTime = (currentTime + cycleSpeed * 0.01) % 24
                        Lighting.ClockTime = currentTime
                        if timeLabel and timeLabel.Parent then
                            local h = math_floor(currentTime)
                            local m = math_floor((currentTime - h) * 60)
                            timeLabel.Text = string_format("%02d:%02d", h, m)
                        end
                        task_wait(0.05)
                    end
                end)
                Notify("Solanix", "Auto-cycle enabled.", 3)
            else
                Notify("Solanix", "Auto-cycle disabled.", 3)
            end
        end)
        Slider(cycleBody, "Cycle Speed", 0.1, 10, 1, 1, function(v)
            cycleSpeed = v
        end)
        Button(cycleBody, "Set Noon", function()
            currentTime = 12
            Lighting.ClockTime = 12
        end)
        Button(cycleBody, "Set Midnight", function()
            currentTime = 0
            Lighting.ClockTime = 0
        end)
        Button(cycleBody, "Set Sunrise (6)", function()
            currentTime = 6
            Lighting.ClockTime = 6
        end)
        Button(cycleBody, "Set Sunset (18)", function()
            currentTime = 18
            Lighting.ClockTime = 18
        end)

        -- Live update label
        Spawn(function()
            while SolanixGui.Parent do
                if timeLabel and timeLabel.Parent then
                    local t = Lighting.ClockTime
                    local h = math_floor(t)
                    local m = math_floor((t - h) * 60)
                    timeLabel.Text = string_format("%02d:%02d", h, m)
                end
                task_wait(0.5)
            end
        end)
    end
end

