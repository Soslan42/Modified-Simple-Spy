        Label(introBody, "All data is local — nothing is sent anywhere.", { size = 11, color = THEME.green })

        local ctrlCard, ctrlBody = Section(scroll, "Controls")
        Button(ctrlBody, capturing and "Stop Capturing" or "Start Capturing", function(btn)
            capturing = not capturing
            btn.Text = capturing and "Stop Capturing" or "Start Capturing"
            Notify("Solanix", "Key capture " .. (capturing and "started" or "stopped") .. ".", 3)
        end)
        Button(ctrlBody, "Clear Log", function()
            logs = {}
            M.Refresh()
        end)
        Button(ctrlBody, "Copy Log to Clipboard", function()
            local out = {}
            for _, l in ipairs(logs) do
                table_insert(out, string_format("[%s] %s %s", l.time, l.action, l.key))
            end
            safeClipboard(table.concat(out, "\n"))
            Notify("Solanix", "Log copied.", 3)
        end)

        local listCard, listBody = Section(scroll, "Capture Log")
        M._listBody = listBody

        Track(UserInputService.InputBegan:Connect(function(inp, gp)
            if not capturing then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                local keyName = SolanixHub._inputUtils.keyName(inp.KeyCode)
                table_insert(logs, {
                    action = "DOWN",
                    key = keyName,
                    time = os.date("%H:%M:%S"),
                })
                if #logs > 200 then table_remove(logs, 1) end
                M.Refresh()
            end
        end))
        Track(UserInputService.InputEnded:Connect(function(inp, gp)
            if not capturing then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                local keyName = SolanixHub._inputUtils.keyName(inp.KeyCode)
                table_insert(logs, {
                    action = "UP  ",
                    key = keyName,
                    time = os.date("%H:%M:%S"),
                })
                if #logs > 200 then table_remove(logs, 1) end
                M.Refresh()
            end
        end))
    end

    function M.Refresh()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "KeyRow" then
                pcall(function() c:Destroy() end)
            end
        end
        for i = #logs, math.max(1, #logs - 49), -1 do
            local l = logs[i]
            if l then
                local row = Create("Frame", {
                    Parent = M._listBody,
                    Name = "KeyRow",
                    BackgroundColor3 = THEME.bgElevated,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 20),
                })
