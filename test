-- Pagination: shows "Page X of Y" with prev/next buttons
function SolanixHub.Widgets.Pagination(parent, currentPage, totalPages, onPage)
    local bar = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgPanel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 28),
    })
    ApplySolanixSurface(bar)
    local prev = Create("TextButton", {
        Parent = bar,
        BackgroundColor3 = THEME.bgActive,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 8, 0.5, -10),
        Size = UDim2.new(0, 30, 0, 20),
        Font = THEME.fontBold,
        Text = "◀",
        TextColor3 = THEME.textPrimary,
        TextSize = 12,
        AutoButtonColor = false,
    })
    Create("UICorner", { Parent = prev, CornerRadius = THEME.radiusSm })
    local label = Create("TextLabel", {
        Parent = bar,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, -60, 0, 0),
        Size = UDim2.new(0, 120, 1, 0),
        Font = THEME.font,
        Text = "Page " .. currentPage .. " of " .. totalPages,
        TextColor3 = THEME.textPrimary,
        TextSize = 11,
    })
    local next = Create("TextButton", {
        Parent = bar,
        BackgroundColor3 = THEME.bgActive,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -38, 0.5, -10),
        Size = UDim2.new(0, 30, 0, 20),
        Font = THEME.fontBold,
        Text = "▶",
        TextColor3 = THEME.textPrimary,
        TextSize = 12,
        AutoButtonColor = false,
    })
    Create("UICorner", { Parent = next, CornerRadius = THEME.radiusSm })
    ApplyHover(prev, THEME.bgHover, THEME.bgActive)
    ApplyHover(next, THEME.bgHover, THEME.bgActive)
    Track(prev.MouseButton1Click:Connect(function()
        if currentPage > 1 then
            currentPage = currentPage - 1
            label.Text = "Page " .. currentPage .. " of " .. totalPages
            if onPage then pcall(onPage, currentPage) end
        end
    end))
    Track(next.MouseButton1Click:Connect(function()
        if currentPage < totalPages then
            currentPage = currentPage + 1
            label.Text = "Page " .. currentPage .. " of " .. totalPages
            if onPage then pcall(onPage, currentPage) end
        end
    end))
    return bar
end

