SolanixHub.modules.Performance = {}
do
    local M = SolanixHub.modules.Performance

    function M.Build()
        local page = SolanixHub.NewPage("Performance")
        local scroll = Scroller(page)

        local fpsCard, fpsBody = Section(scroll, "FPS")
        local fpsValue = Label(fpsBody, "0", { bold = true, size = 24, color = THEME.green })
        local fpsHistLbl = Label(fpsBody, "Avg: 0 | Min: 0 | Max: 0", { size = 11 })

        local pingCard, pingBody = Section(scroll, "Ping")
        local pingValue = Label(pingBody, "0 ms", { bold = true, size = 24, color = THEME.cyan })
        local pingHistLbl = Label(pingBody, "Avg: 0 | Min: 0 | Max: 0", { size = 11 })

        local memCard, memBody = Section(scroll, "Memory")
        local memValue = Label(memBody, "0 MB", { bold = true, size = 24, color = THEME.amber })
        local memHistLbl = Label(memBody, "Stats memory usage Mb", { size = 11 })

        local gcCard, gcBody = Section(scroll, "Garbage Collection")
        local gcCount = Label(gcBody, "GC count: 0", { size = 11 })
        local gcThreshold = Label(gcBody, "GC threshold: 0", { size = 11 })

        -- Action buttons
        local actCard, actBody = Section(scroll, "Actions")
        Button(actBody, "Force GC collect", function()
            pcall(function() collectgarbage("collect") end)
            Notify("Solanix", "Garbage collection triggered.", 3)
        end)
        Button(actBody, "Print GC info", function()
            local count = collectgarbage("count")
            consoleLog = consoleLog or print
            consoleLog("[gc] count=" .. count .. " KB", THEME.cyan)
            Notify("Solanix", "GC count: " .. count .. " KB", 3)
        end)

        -- Update loop
        local fpsHistory = {}
        local pingHistory = {}
        Spawn(function()
            local frameCount = 0
            while SolanixGui.Parent do
                frameCount = 0
                local conn = RunService.RenderStepped:Connect(function()
                    frameCount += 1
                end)
                task_wait(1)
                if conn then conn:Disconnect() end
                local fps = frameCount
                table_insert(fpsHistory, fps)
                if #fpsHistory > 60 then table_remove(fpsHistory, 1) end
                local sum, mn, mx = 0, math_huge, 0
                for _, v in ipairs(fpsHistory) do
                    sum = sum + v
                    if v < mn then mn = v end
                    if v > mx then mx = v end
                end
                fpsValue.Text = tostring(fps)
                fpsHistLbl.Text = string_format("Avg: %.0f | Min: %d | Max: %d", sum / #fpsHistory, mn, mx)

                -- Ping
                local ping = 0
                pcall(function()
                    ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                table_insert(pingHistory, ping)
                if #pingHistory > 60 then table_remove(pingHistory, 1) end
                local pSum, pMn, pMx = 0, math_huge, 0
                for _, v in ipairs(pingHistory) do
                    pSum = pSum + v
                    if v < pMn then pMn = v end
                    if v > pMx then pMx = v end
                end
                pingValue.Text = string_format("%d ms", math_floor(ping))
                pingHistLbl.Text = string_format("Avg: %.0f | Min: %d | Max: %d", pSum / #pingHistory, pMn, pMx)

                -- Memory
                local mem = 0
                pcall(function() mem = Stats:GetTotalMemoryUsageMb() end)
                memValue.Text = string_format("%.1f MB", mem)

                -- GC
                local gCount = collectgarbage("count")
                gcCount.Text = string_format("GC count: %.1f KB", gCount)
                gcThreshold.Text = "GC step mode: default"
            end
        end)
    end
end

