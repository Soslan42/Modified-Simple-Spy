-- Color3 editor
function SolanixHub.PropertyEditors.Color3(parent, obj, propName)
    local row = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgElevated,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 26),
    })
    Create("UICorner", { Parent = row, CornerRadius = THEME.radiusSm })
    local lbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(0.35, 0, 1, 0),
        Font = THEME.font,
        Text = propName,
        TextColor3 = THEME.textSecondary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local currentVal = Color3.new(1, 1, 1)
    pcall(function() currentVal = obj[propName] end)
    local swatch = Create("TextButton", {
        Parent = row,
        BackgroundColor3 = currentVal,
        BorderSizePixel = 0,
        Position = UDim2.new(0.35, 0, 0.5, -10),
        Size = UDim2.new(0.3, -8, 0, 20),
        Text = "",
        AutoButtonColor = false,
    })
    Create("UICorner", { Parent = swatch, CornerRadius = THEME.radiusSm })
    local hex = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.65, 0, 0, 0),
        Size = UDim2.new(0.35, -8, 1, 0),
        Font = THEME.fontMono,
        Text = string_format("#%02X%02X%02X",
            math_floor(currentVal.R * 255),
            math_floor(currentVal.G * 255),
            math_floor(currentVal.B * 255)),
        TextColor3 = THEME.textPrimary,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    Track(swatch.MouseButton1Click:Connect(function()
        -- Reuse the global ColorPicker popup
        local popup = Create("Frame", {
            Parent = SolanixGui,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            Position = UDim2.new(0, swatch.AbsolutePosition.X, 0, swatch.AbsolutePosition.Y + 26),
            Size = UDim2.new(0, 220, 0, 240),
            ZIndex = 80,
        })
        TrackInstance(popup)
        ApplySolanixSurface(popup)
        local hue = 0
        local sat, val = 1, 1
        local svBox = Create("Frame", {
            Parent = popup,
            BackgroundColor3 = currentVal,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 10, 0, 36),
            Size = UDim2.new(0, 200, 0, 140),
        })
        local hueBar = Create("Frame", {
            Parent = popup,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Position = UDim2.new(0, 10, 0, 184),
            Size = UDim2.new(0, 200, 0, 14),
        })
        Create("UIGradient", {
            Parent = hueBar,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
            }),
        })
        local function update()
            local c = Color3.fromHSV(hue, sat, val)
            pcall(function() obj[propName] = c end)
            swatch.BackgroundColor3 = c
            hex.Text = string_format("#%02X%02X%02X",
                math_floor(c.R * 255), math_floor(c.G * 255), math_floor(c.B * 255))
            svBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        end
        Track(hueBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                local rel = (inp.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X
                hue = math_clamp(rel, 0, 1)
                update()
            end
        end))
        Track(svBox.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                local rx = (inp.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X
                local ry = (inp.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y
                sat = math_clamp(rx, 0, 1)
                val = math_clamp(1 - ry, 0, 1)
                update()
            end
        end))
        Spawn(function()
            local conn
            conn = UserInputService.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    task_wait(0.1)
                    pcall(function() popup:Destroy() end)
                    if conn then conn:Disconnect() end
                end
            end)
        end)
    end))
    return row
end

-- EnumItem editor
function SolanixHub.PropertyEditors.EnumItem(parent, obj, propName)
    local currentVal = nil
    pcall(function() currentVal = obj[propName] end)
    if not currentVal or typeof(currentVal) ~= "EnumItem" then
        return SolanixHub.PropertyEditors.String(parent, obj, propName)
    end
    local options = {}
    pcall(function()
        for _, item in ipairs(currentVal.EnumType:GetEnumItems()) do
            table_insert(options, { label = item.Name, value = item })
        end
    end)
    return Dropdown(parent, propName, options, currentVal, function(v)
        pcall(function() obj[propName] = v end)
    end)
end

-- Vector3 editor
function SolanixHub.PropertyEditors.Vector3(parent, obj, propName)
    local currentVal = Vector3.zero
    pcall(function() currentVal = obj[propName] end)
    return SolanixHub.makeVector3Editor(parent, propName, currentVal, function(axis, value)
        pcall(function()
            local cur = obj[propName]
            if axis == "X" then obj[propName] = Vector3.new(value, cur.Y, cur.Z)
            elseif axis == "Y" then obj[propName] = Vector3.new(cur.X, value, cur.Z)
            elseif axis == "Z" then obj[propName] = Vector3.new(cur.X, cur.Y, value) end
        end)
    end)
end

-- CFrame editor
function SolanixHub.PropertyEditors.CFrame(parent, obj, propName)
    local currentVal = CFrame.identity
    pcall(function() currentVal = obj[propName] end)
    return SolanixHub.makeCFrameEditor(parent, propName, currentVal, function(newCf)
        pcall(function() obj[propName] = newCf end)
    end)
