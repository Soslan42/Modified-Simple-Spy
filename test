        addNavItem(item.order, item.name, item.glyph, item.label)
    end

    -- Build all modules
    for _, item in ipairs(navItems) do
        local mod = SolanixHub.modules[item.name]
        if mod and mod.Build then
            local ok, err = pcall(mod.Build)
            if not ok then
                warn("[Solanix] Failed to build module " .. item.name .. ": " .. tostring(err))
                Notify("Solanix", "Module '" .. item.name .. "' failed: " .. tostring(err), 6)
            end
        end
    end

    -- Show Home first
    SolanixHub.Navigate("Home")
end

