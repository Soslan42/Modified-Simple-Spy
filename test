do
    local M = SolanixHub.modules.TaskScheduler
    local tasks = {}
    function M.Build()
        local page = SolanixHub.NewPage("TaskScheduler")
        local scroll = Scroller(page)

        local card, body = Section(scroll, "Task Scheduler")
        Label(body, "Schedule Lua code to run after a delay.", { size = 11 })

        local _, delayInput = TextBox(body, "Delay (seconds)", "5", "", function() end)
        local _, codeInput = TextBox(body, "Code to run", "print('hello from scheduled task')", "", function() end)
        Button(body, "Schedule", function()
            local delay = tonumber(delayInput.Text) or 5
            local code = codeInput.Text
            if code == "" then return end
            local id = SolanixHub._mathUtils.uuid()
            table_insert(tasks, { id = id, delay = delay, code = code, time = os.time() + delay })
            Notify("Solanix", "Task scheduled (ID: " .. id:sub(1, 8) .. ")", 3)
            Spawn(function()
                task_wait(delay)
                local fn, err = loadstring(code)
                if fn then
                    setfenv(fn, getfenv())
                    pcall(fn)
                else
                    print("[Solanix Task] Error: " .. tostring(err))
                end
                for i, t in ipairs(tasks) do
                    if t.id == id then
                        table_remove(tasks, i)
                        break
                    end
                end
            end)
        end)

        local listCard, listBody = Section(scroll, "Scheduled Tasks")
        M._listBody = listBody
        Button(listBody, "Refresh", function() M.Refresh() end)
    end

    function M.Refresh()
        if not M._listBody then return end
        for _, c in ipairs(M._listBody:GetChildren()) do
            if c:IsA("Frame") and c.Name == "TaskRow" then
