                else
                    Notify("Solanix", "This object is not a Remote.", 3)
                end
            end)
            menuItem("Decompile Script", function()
                if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
                    local ok, src = pcall(decompile, obj)
                    if ok and src then
                        SolanixHub._state.lastDecompiled = src
                        SolanixHub.modules.Explorer.ShowScript(obj, src)
