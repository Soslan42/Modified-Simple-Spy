do
    local M = SolanixHub.modules.InstanceScanner
    function M.Build()
        local page = SolanixHub.NewPage("InstanceScanner")
        local scroll = Scroller(page)

        local searchCard, searchBody = Section(scroll, "Search Instances")
        local _, searchInput = TextBox(searchBody, "Search query", "Part", "", function() end)
        local _, classFilter = TextBox(searchBody, "Class filter (optional)", "BasePart", "", function() end)
        Button(searchBody, "Scan", function()
            local query = string_lower(searchInput.Text)
            local class = classFilter.Text
            local results = {}
            pcall(function()
                for _, v in ipairs(game:GetDescendants()) do
                    if class == "" or v:IsA(class) then
                        local name = string_lower(v.Name)
                        local fullName = ""
                        pcall(function() fullName = string_lower(v:GetFullName()) end)
                        if query == "" or name:find(query, 1, true) or fullName:find(query, 1, true) then
                            table_insert(results, v)
                            if #results >= 500 then break end
                        end
                    end
                end
            end)
            M.ShowResults(results)
        end)

        local resCard, resBody = Section(scroll, "Search Results")
        M._resBody = resBody
