    function M.Add(action, detail)
        table_insert(history, {
            action = action,
            detail = detail or "",
            time = os.date("%H:%M:%S"),
        })
        if #history > MAX_HISTORY then table_remove(history, 1) end
    end

    function M.Build()
        local page = SolanixHub.NewPage("History")
        local scroll = Scroller(page)
        local card, body = Section(scroll, "Action History")
