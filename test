-- Centralised hotkey handler. All global hotkeys live here so we can
-- disable them on shutdown by disconnecting a single connection.
Track(UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local kc = inp.KeyCode
    local s = SolanixHub.settings

    -- RightShift toggles window
    if kc == (s.hotkey_toggleWindow or Enum.KeyCode.RightShift) then
        Window.Visible = not Window.Visible
        return
    end

    -- F2 toggles Remote Spy GUI
    if kc == (s.hotkey_toggleGui or Enum.KeyCode.F2) then
        if currentPage == "RemoteSpy" then
            SolanixHub.Navigate("Home")
        else
            SolanixHub.Navigate("RemoteSpy")
        end
        return
    end

    -- F3 toggles spy capture
    if kc == (s.hotkey_toggleSpy or Enum.KeyCode.F3) then
        if SolanixHub.modules.RemoteSpy and SolanixHub.modules.RemoteSpy.ToggleSpy then
            SolanixHub.modules.RemoteSpy.ToggleSpy()
        end
        return
    end

    -- F4 clears spy logs
    if kc == (s.hotkey_clearLogs or Enum.KeyCode.F4) then
        if SolanixHub.modules.RemoteSpy and SolanixHub.modules.RemoteSpy.ClearLogs then
            SolanixHub.modules.RemoteSpy.ClearLogs()
        end
        return
    end

    -- F5 toggles spam
    if kc == (s.hotkey_spam or Enum.KeyCode.F5) then
        if SolanixHub.modules.RemoteSpy then
            if SolanixHub.modules.RemoteSpy.StartSpam and SolanixHub.modules.RemoteSpy.StopSpam then
                -- We don't have a public IsSpamActive, so toggle via both calls
                -- Actually use a guarded call: try stop first, then start
                local M = SolanixHub.modules.RemoteSpy
                if M._spamActive then
                    M.StopSpam()
                else
                    M.StartSpam()
                end
            end
        end
        return
    end

    -- Explorer hotkeys (only when Explorer is the current page)
    if currentPage == "Explorer" then
        local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
        if kc == Enum.KeyCode.Delete and SolanixHub.modules.Explorer then
            local sel = SolanixHub.modules.Explorer._selectedInstance
            if sel then
                pcall(function() sel:Destroy() end)
                Notify("Solanix", "Destroyed: " .. sel.Name, 3)
            end
        elseif ctrl and kc == Enum.KeyCode.C and SolanixHub.modules.Explorer then
            local sel = SolanixHub.modules.Explorer._selectedInstance
            if sel then
                local ok, p = pcall(function() return sel:GetFullName() end)
                safeClipboard(ok and p or sel.Name)
                Notify("Solanix", "Path copied.", 3)
            end
        elseif ctrl and kc == Enum.KeyCode.D and SolanixHub.modules.Explorer then
            local sel = SolanixHub.modules.Explorer._selectedInstance
            if sel then
                pcall(function()
                    local clone = sel:Clone()
                    clone.Parent = sel.Parent
                end)
                Notify("Solanix", "Cloned: " .. sel.Name, 3)
            end
        end
    end
end))

