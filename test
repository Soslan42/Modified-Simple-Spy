                    titleInput.Text = notes[i].title or ""
                    bodyInput.Text  = notes[i].body or ""
                    refreshList()
                end))
                listButtons[i] = b
            end
        end

        local function loadCurrent()
            if notes[currentNote] then
                titleInput.Text = notes[currentNote].title or ""
                bodyInput.Text  = notes[currentNote].body or ""
            else
                titleInput.Text = ""
                bodyInput.Text  = ""
            end
        end

        Track(titleInput.FocusLost:Connect(function()
            if notes[currentNote] then
                notes[currentNote].title = titleInput.Text
                saveNotes()
                refreshList()
            end
        end))
        Track(bodyInput.FocusLost:Connect(function()
            if notes[currentNote] then
                notes[currentNote].body = bodyInput.Text
                saveNotes()
            end
        end))
        Track(addBtn.MouseButton1Click:Connect(function()
            table_insert(notes, { title = "New Note", body = "" })
            currentNote = #notes
            saveNotes()
            loadCurrent()
            refreshList()
        end))
        Track(delBtn.MouseButton1Click:Connect(function()
            if #notes == 1 then
                Notify("Solanix", "Cannot delete the last note.", 3)
                return
            end
            table_remove(notes, currentNote)
            if currentNote > #notes then currentNote = #notes end
            saveNotes()
            loadCurrent()
            refreshList()
        end))

        loadCurrent()
        refreshList()
    end
end

