SolanixHub.Widgets = {}

-- NotificationCard: a richer version of Notify that includes
-- an icon, an action button, and a close button.
function SolanixHub.Widgets.NotificationCard(parent, opts)
    opts = opts or {}
    local card = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgPanel,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 320, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    ApplySolanixSurface(card)
    Create("UIPadding", {
        Parent = card,
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
        PaddingTop = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
    })
    -- Header row: icon + title + close
    local header = Create("Frame", {
        Parent = card,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 24),
    })
    Create("UIListLayout", {
        Parent = header,
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })
    local icon = Create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 18, 0, 18),
        Font = THEME.fontBold,
        Text = opts.icon or "●",
        TextColor3 = opts.iconColor or THEME.accent,
        TextSize = 14,
    })
    local title = Create("TextLabel", {
        Parent = header,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -50, 0, 18),
        Font = THEME.fontBold,
        Text = opts.title or "",
        TextColor3 = THEME.textPrimary,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local closeBtn = Create("TextButton", {
        Parent = header,
        BackgroundColor3 = THEME.bgActive,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 18, 0, 18),
        Font = THEME.fontBold,
        Text = "✕",
        TextColor3 = THEME.textMuted,
        TextSize = 10,
        AutoButtonColor = false,
    })
    Create("UICorner", { Parent = closeBtn, CornerRadius = THEME.radiusSm })
    -- Body
    local body = Create("TextLabel", {
        Parent = card,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 28),
        Size = UDim2.new(1, 0, 0, 16),
        Font = THEME.font,
        Text = opts.body or "",
        TextColor3 = THEME.textSecondary,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        AutomaticSize = Enum.AutomaticSize.Y,
    })
    -- Action button (optional)
    local actionBtn = nil
    if opts.actionLabel then
        actionBtn = Create("TextButton", {
            Parent = card,
            BackgroundColor3 = THEME.accent,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 60),
            Size = UDim2.new(1, 0, 0, 24),
            Font = THEME.font,
            Text = opts.actionLabel,
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 11,
            AutoButtonColor = false,
        })
        Create("UICorner", { Parent = actionBtn, CornerRadius = THEME.radiusSm })
        if opts.onAction then
            Track(actionBtn.MouseButton1Click:Connect(function()
                pcall(opts.onAction)
            end))
        end
    end
    Track(closeBtn.MouseButton1Click:Connect(function()
        pcall(function() card:Destroy() end)
    end))
    return card
end

-- StatusBar: a horizontal bar with multiple segments, each showing
-- a different metric. Great for performance displays.
function SolanixHub.Widgets.StatusBar(parent, segments)
    local bar = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.bgPanel,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 28),
    })
    ApplySolanixSurface(bar)
    Create("UIListLayout", {
        Parent = bar,
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    local segmentFrames = {}
    for i, seg in ipairs(segments or {}) do
        local s = Create("Frame", {
            Parent = bar,
            BackgroundTransparency = 1,
            Size = UDim2.new(1 / #(segments or {1}), 0, 1, 0),
        })
        Create("UIPadding", {
            Parent = s,
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
            PaddingTop = UDim.new(0, 4),
        })
        local label = Create("TextLabel", {
            Parent = s,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 12),
            Font = THEME.font,
            Text = seg.label or "",
            TextColor3 = THEME.textMuted,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        local value = Create("TextLabel", {
            Parent = s,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 12),
            Size = UDim2.new(1, 0, 0, 14),
            Font = THEME.fontBold,
            Text = seg.value or "",
            TextColor3 = seg.color or THEME.textPrimary,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        segmentFrames[i] = { frame = s, label = label, value = value }
    end
    return bar, segmentFrames
end

