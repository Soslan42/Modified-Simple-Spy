local function Spinner(parent, size)
    size = size or 16
    local spinner = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = THEME.accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, size, 0, size),
        AnchorPoint = Vector2.new(0.5, 0.5),
    })
    Create("UICorner", { Parent = spinner, CornerRadius = UDim.new(1, 0) })
    -- Use rotation tween to animate
    Spawn(function()
        while spinner.Parent do
            Tween(spinner, 0.8, { Rotation = spinner.Rotation + 360 }):Play()
            task_wait(0.8)
        end
    end)
    return spinner
end
