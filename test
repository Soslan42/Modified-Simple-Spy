        Text = label or "",
        TextColor3 = THEME.textPrimary,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -30, 0, 0),
        Size = UDim2.new(0, 24, 1, 0),
        Font = THEME.fontBold,
        Text = "▾",
        TextColor3 = THEME.textAccent,
        TextSize = 12,
    })
    local function currentLabel()
        for _, o in ipairs(opts) do
            if o.value == current then return o.label end
        end
        return ""
    end
    local val = Create("TextLabel", {
        Parent = row,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.4, 0, 0, 0),
        Size = UDim2.new(0.6, -36, 1, 0),
        Font = THEME.font,
        Text = currentLabel(),
        TextColor3 = THEME.textAccent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    -- Dropdown list (rendered on click into the page scroller)
    local list = nil
    local function closeList()
        if list then pcall(function() list:Destroy() end) list = nil end
    end
    Track(row.MouseButton1Click:Connect(function()
        if list then closeList() return end
        local page = row:FindFirstAncestorWhichIsA("ScrollingFrame")
        local host = page and page.Parent or row.Parent
        list = Create("Frame", {
            Parent = host,
            BackgroundColor3 = THEME.bgElevated,
            BorderSizePixel = 0,
            Position = UDim2.new(0, row.AbsolutePosition.X, 0, row.AbsolutePosition.Y + row.AbsoluteSize.Y + 4),
            Size = UDim2.new(0, row.AbsoluteSize.X, 0, #opts * 26 + 8),
            ZIndex = 50,
        })
        ApplySolanixSurface(list)
        Create("UIListLayout", {
            Parent = list,
            Padding = UDim.new(0, 2),
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        })
        Create("UIPadding", { Parent = list, PaddingTop = UDim.new(0, 4) })
        for _, o in ipairs(opts) do
            local item = Create("TextButton", {
                Parent = list,
                BackgroundColor3 = (o.value == current) and THEME.bgActive or THEME.bgElevated,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -8, 0, 22),
                Font = THEME.font,
                Text = o.label,
                TextColor3 = (o.value == current) and THEME.textAccent or THEME.textPrimary,
                TextSize = 12,
                AutoButtonColor = false,
                ZIndex = 51,
            })
            Create("UICorner", { Parent = item, CornerRadius = THEME.radiusSm })
            ApplyHover(item, THEME.bgHover, (o.value == current) and THEME.bgActive or THEME.bgElevated)
            Track(item.MouseButton1Click:Connect(function()
                current = o.value
                val.Text = o.label
                closeList()
                if callback then pcall(callback, current) end
            end))
        end
    end))
    return row, function() return current end, function(v)
        current = v
        val.Text = currentLabel()
        if callback then pcall(callback, current) end
    end
end
